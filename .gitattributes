# ─────────────────────────────────────────────────────────────────────────
# 关键：补丁文件必须是 LF。
# patch 文件里每一行都是精确内容；CRLF 会让 git apply / paperweight 的
# hunk 匹配全部失败，而且报错信息极难懂（"corrupt patch at line N"）。
# ─────────────────────────────────────────────────────────────────────────
*.patch     text eol=lf
*.diff      text eol=lf

# Gradle wrapper 脚本在 Linux/macOS 上必须可执行且是 LF
gradlew     text eol=lf
*.sh        text eol=lf

# Windows 批处理保持 CRLF（cmd.exe 对 LF 的兼容性不完整）
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制文件不做任何转换
*.jar       binary
*.png       binary
*.jpg       binary
*.ico       binary
*.gz        binary
*.zip       binary

# 源码与文档统一 LF
*.java      text eol=lf
*.kts       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.txt       text eol=lf
*.properties text eol=lf
