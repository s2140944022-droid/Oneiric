+import net.minecraft.world.level.storage.loot.LootPool;
+import net.minecraft.world.level.storage.loot.LootTable;
+import net.minecraft.world.level.storage.loot.entries.AlternativesEntry;
+import net.minecraft.world.level.storage.loot.entries.CompositeEntryBase;
+import net.minecraft.world.level.storage.loot.entries.LootPoolEntryContainer;
+import net.minecraft.world.level.storage.loot.entries.NestedLootTable;
+import net.minecraft.world.level.storage.loot.predicates.AnyOfCondition;
+import net.minecraft.world.level.storage.loot.predicates.CompositeLootItemCondition;
+import net.minecraft.world.level.storage.loot.predicates.LootItemCondition;
+import net.minecraft.world.level.storage.loot.predicates.MatchTool;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+import org.leavesmc.leaves.protocol.jade.tool.ShearsToolHandler;
+
+import java.lang.invoke.MethodHandle;
+import java.lang.invoke.MethodHandles;
+import java.lang.reflect.Field;
+import java.util.List;
+import java.util.Optional;
+import java.util.function.Function;
+
+/**
+ * Oneiric - 收集「用当前工具（默认剪刀）开采会掉落物品」的方块列表，用于 Jade 握手包。
+ *
+ * <p>移植自 LeavesMC/Leaves（GPLv3）。</p>
+ *
+ * <p><b>与 Leaves 的差异</b>：Leaves 基于 26.x，可以直接访问
+ * {@code LootTable#pools}、{@code LootPool#entries} 等字段（上游用 access widener 打开）。
+ * 1.21.1 这些字段是 private/protected，而它们位于 applyPatches 生成的源码集之外，
+ * 直接改会破坏补丁流程。这里改用缓存的 {@link MethodHandle} 读取，读不到就降级为空列表，
+ * 不影响 Jade 其余功能。</p>
+ *
+ * <p>结果只在握手/数据包重载时计算一次，反射开销可忽略。</p>
+ */
+public class LootTableMineableCollector {
+
+    private static final MethodHandle LOOT_TABLE_POOLS = getter(LootTable.class, "pools");
+    private static final MethodHandle LOOT_POOL_ENTRIES = getter(LootPool.class, "entries");
+    private static final MethodHandle ENTRY_CONDITIONS = getter(LootPoolEntryContainer.class, "conditions");
+    private static final MethodHandle COMPOSITE_CHILDREN = getter(CompositeEntryBase.class, "children");
+    private static final MethodHandle NESTED_CONTENTS = getter(NestedLootTable.class, "contents");
+    private static final MethodHandle COMPOSITE_TERMS = getter(CompositeLootItemCondition.class, "terms");
+
+    private final HolderGetter<LootTable> lootRegistry;
+    private final ItemStack toolItem;
+
+    public LootTableMineableCollector(HolderGetter<LootTable> lootRegistry, ItemStack toolItem) {
+        this.lootRegistry = lootRegistry;
+        this.toolItem = toolItem;
+    }
+
+    public static @NotNull List<Block> execute(HolderGetter<LootTable> lootRegistry, ItemStack toolItem) {
+        if (LOOT_TABLE_POOLS == null || LOOT_POOL_ENTRIES == null || ENTRY_CONDITIONS == null) {
+            // 反射不可用时不再逐个方块空转，直接返回空列表，Jade 客户端只会少一份提示。
+            return List.of();
+        }
+        LootTableMineableCollector collector = new LootTableMineableCollector(lootRegistry, toolItem);
+        List<Block> list = Lists.newArrayList();
+        for (Block block : BuiltInRegistries.BLOCK) {
+            if (!ShearsToolHandler.getInstance().test(block.defaultBlockState()).isEmpty()) {
+                continue;
+            }
+
+            final ResourceKey<LootTable> lootTableKey = block.getLootTable();
+            if (lootTableKey != null && lootTableKey != net.minecraft.world.level.storage.loot.BuiltInLootTables.EMPTY) {
+                LootTable lootTable = lootRegistry.get(lootTableKey).map(Holder::value).orElse(null);
+                if (collector.doLootTable(lootTable)) {
+                    list.add(block);
+                }
+            }
+        }
+        return list;
+    }
+
+    public static boolean isCorrectConditions(@NotNull List<LootItemCondition> conditions, ItemStack toolItem) {
+        if (conditions.size() != 1) {
+            return false;
+        }
+
+        LootItemCondition condition = conditions.getFirst();
+        if (condition instanceof MatchTool(Optional<ItemPredicate> predicate)) {
+            ItemPredicate itemPredicate = predicate.orElse(null);
+            return itemPredicate != null && itemPredicate.test(toolItem);
+        } else if (condition instanceof AnyOfCondition) {
+            for (LootItemCondition child : readList(COMPOSITE_TERMS, condition, LootItemCondition.class)) {
+                if (isCorrectConditions(List.of(child), toolItem)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private boolean doLootTable(@Nullable LootTable lootTable) {
+        if (lootTable == null || lootTable == LootTable.EMPTY) {
+            return false;
+        }
+
+        for (LootPool pool : readList(LOOT_TABLE_POOLS, lootTable, LootPool.class)) {
+            if (doLootPool(pool)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean doLootPool(@NotNull LootPool lootPool) {
+        for (LootPoolEntryContainer entry : readList(LOOT_POOL_ENTRIES, lootPool, LootPoolEntryContainer.class)) {
+            if (doLootPoolEntry(entry)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean doLootPoolEntry(LootPoolEntryContainer entry) {
+        if (entry instanceof AlternativesEntry) {
+            for (LootPoolEntryContainer child : readList(COMPOSITE_CHILDREN, entry, LootPoolEntryContainer.class)) {
+                if (doLootPoolEntry(child)) {
+                    return true;
+                }
+            }
+        } else if (entry instanceof NestedLootTable nestedLootTable) {
+            LootTable lootTable = readNestedContents(nestedLootTable);
+            return doLootTable(lootTable);
+        } else {
+            return isCorrectConditions(readList(ENTRY_CONDITIONS, entry, LootItemCondition.class), toolItem);
+        }
+        return false;
+    }
+
+    @Nullable
+    private LootTable readNestedContents(NestedLootTable nestedLootTable) {
+        if (NESTED_CONTENTS == null) {
+            return null;
+        }
+        try {
+            final Object contents = NESTED_CONTENTS.invoke(nestedLootTable);
+            if (contents instanceof com.mojang.datafixers.util.Either<?, ?> either) {
+                // Either<ResourceKey<LootTable>, LootTable>：左边是引用，右边是内联表。
+                return either.map(
+                    key -> key instanceof ResourceKey<?> resourceKey
+                        ? lootRegistry.get((ResourceKey<LootTable>) resourceKey).map(Holder::value).orElse(null)
+                        : null,
+                    value -> value instanceof LootTable table ? table : null
+                );
+            }
+        } catch (Throwable ignore) {
+        }
+        return null;
+    }
+
+    @Nullable
+    private static MethodHandle getter(Class<?> owner, String fieldName) {
+        try {
+            final Field field = owner.getDeclaredField(fieldName);
+            field.setAccessible(true);
+            return MethodHandles.lookup().unreflectGetter(field);
+        } catch (Throwable ignore) {
+            return null;
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <T> List<T> readList(@Nullable MethodHandle handle, Object target, Class<T> type) {
+        if (handle == null || target == null) {
+            return List.of();
+        }
+        try {
+            final Object value = handle.invoke(target);
+            if (value instanceof List<?> list) {
+                return (List<T>) list;
+            }
+        } catch (Throwable ignore) {
+        }
+        return List.of();
+    }
+}
