@@ -0,0 +1,62 @@
+package org.leavesmc.leaves.util;
+
+import javax.annotation.Nullable;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.block.entity.BlockEntity;
+
+/**
+ * Oneiric - NBT 存取辅助。
+ *
+ * <p>移植自 LeavesMC/Leaves（GPLv3）的 {@code TagUtil}。</p>
+ *
+ * <p><b>与 Leaves 的差异</b>：Leaves 的 26.x 版本用 {@code TagValueInput/TagValueOutput}
+ * 包装（带 registry 上下文的 NBT 读写）。1.21.1 还没有这套 API，
+ * 实体与方块实体直接收发 {@link CompoundTag}，所以这里改写为直接调用。
+ * 语义完全一致：save 写全量、saveWithoutId 不写 UUID、saveAsPassenger 写载具链。</p>
+ */
+public class TagUtil {
+
+    public static CompoundTag saveEntity(@Nullable final Entity entity) {
+        if (entity == null) {
+            return new CompoundTag();
+        }
+        final CompoundTag tag = new CompoundTag();
+        entity.save(tag);
+        return tag;
+    }
+
+    public static boolean saveEntity(@Nullable final Entity entity, final CompoundTag tag) {
+        return entity != null && entity.save(tag);
+    }
+
+    public static CompoundTag saveEntityWithoutId(@Nullable final Entity entity) {
+        if (entity == null) {
+            return new CompoundTag();
+        }
+        return entity.saveWithoutId(new CompoundTag());
+    }
+
+    public static CompoundTag saveTileWithId(@Nullable final BlockEntity blockEntity) {
+        if (blockEntity == null || blockEntity.getLevel() == null) {
+            return new CompoundTag();
+        }
+        return blockEntity.saveWithId(blockEntity.getLevel().registryAccess());
+    }
+
+    public static boolean saveEntityAsPassenger(@Nullable final Entity entity, final CompoundTag tag) {
+        return entity != null && entity.saveAsPassenger(tag);
+    }
+
+    public static void loadEntity(@Nullable final Entity entity, final CompoundTag tag) {
+        if (entity != null) {
+            entity.load(tag);
+        }
+    }
+
+    public static void loadTileWithComponents(@Nullable final BlockEntity blockEntity, final CompoundTag tag) {
+        if (blockEntity != null && blockEntity.getLevel() != null) {
+            blockEntity.loadWithComponents(tag, blockEntity.getLevel().registryAccess());
+        }
+    }
+}
