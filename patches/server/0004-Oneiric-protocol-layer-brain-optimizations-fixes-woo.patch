+package io.papermc.paper.oneiric;
+
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Oneiric - **线程智能分配**。
+ *
+ * <h2>为什么需要专门的分配逻辑</h2>
+ *
+ * <p>Folia / Paper 各池子的线程数来自不同地方，每处的默认值都只对某一类机器合适：</p>
+ *
+ * <pre>
+ *   tick 线程     上游 cores/2，若 &lt;=4 则 1，否则再 /4   16 核 → 2   （极端保守）
+ *   chunk worker  Moonrise cores/2 再 /2                 16 核 → 4   （跑图瓶颈）
+ *   chunk IO      Moonrise 写死 1                        16 核 → 1   （跑图瓶颈）
+ * </pre>
+ *
+ * <p>结果是：16 核机器上只有 2 个 tick 线程、4 个 worker、1 个 IO，
+ * <b>跑图时 15 个核在围观</b>。</p>
+ *
+ * <h2>本类的分配原则：按池子的瓶颈类型分，不是平均分</h2>
+ *
+ * <table border="1">
+ *   <caption>各池子的资源特征与分配依据</caption>
+ *   <tr><th>池子</th><th>瓶颈</th><th>分配依据</th></tr>
+ *   <tr><td>tick</td><td>CPU，但受<b>活跃 region 数</b>限制</td>
+ *       <td>半个核数、上限 8。再多也没 region 可跑，反而占着调度槽</td></tr>
+ *   <tr><td>chunk worker</td><td>CPU，且是<b>跑图的天花板</b></td>
+ *       <td>核数 - 2。gen/population/load 三个并行度全绑它，必须给足</td></tr>
+ *   <tr><td>chunk IO</td><td>磁盘队列</td>
+ *       <td>核数 / 2，上限 8。机械盘再多是寻道竞争，NVMe 吃得下</td></tr>
+ *   <tr><td>pathfinding</td><td>CPU</td><td>核数 / 2，上限 8</td></tr>
+ *   <tr><td>folia async</td><td>CPU</td><td>核数 / 2，上限 8</td></tr>
+ * </table>
+ *
+ * <h2>与老 Oneiric 一脉相承</h2>
+ *
+ * <p>老树的 {@code OneiricThreadSizing} 只覆盖 chunk IO / worker / pathfinding
+ * （它不是区线程架构，没有 tick 池）。本类把那套思路扩展到 Folia 的 tick 池，
+ * 并修正 worker 算法（老树 {@code cores/2}，本类 {@code cores-2}，因为跑图是主要负载）。</p>
+ *
+ * <h2>一机多服</h2>
+ *
+ * <p>沿用老树的文件锁探测：每个服务端在临时目录持有自己的锁文件，进程死了锁自动释放。
+ * 探测到 N 个服务端就把核数除以 N。</p>
+ *
+ * <h2>开关与覆盖</h2>
+ *
+ * <p>{@code auto-thread-sizing}（默认开）。关闭后所有值回到上游原始算法。
+ * 任何池子都能用 {@code -Doneiric.*-cap=N} 调上限，
+ * 或直接写显式值（显式正值永远优先，见各 {@code resolve*} 方法）。</p>
+ */
+public final class OneiricThreadSizing {
+
+    /** 主开关名，与 oneiric.yml 一致。 */
+    public static final String SWITCH = "auto-thread-sizing";
+
+    private static final boolean ENABLED = OneiricConfig.isEnabled(SWITCH);
+
+    // ================= 上限（全部可用 -Doneiric.*-cap 调整） =================
+
+    // 上限默认按核数比例，而不是写死绝对值 ——
+    // 写死的话 24/32/64 核会分配到完全相同的值，大机器白买（这一点是实测发现的）。
+    // 运维仍可用 -Doneiric.*-cap=N 覆盖（显式值优先）。
+    /**
+     * chunk IO 上限。磁盘队列型负载：核数再多也不该开几十个队列，
+     * 上限按「核数/2，但不超过 16」—— NVMe 8~16 个队列足够，再多只是寻道竞争。
+     */
+    private static final int IO_CAP = ioCapFor(effectiveCoresStatic());
+
+    /** chunk worker 上限。默认 12：跑图并行度的天花板，核多就该给多。 */
+    /**
+     * chunk worker 上限 = 核数的 3/4（至少 12）。
+     * 它是跑图并行度的天花板（gen/population/load 三者都 = worker 数），
+     * 所以必须随核数增长；留 1/4 给 tick 池、GC、主线程与网络。
+     */
+    private static final int WORKER_CAP = workerCapFor(effectiveCoresStatic());
+
+    /** tick 线程上限。默认 8：真实玩家分布下很少有超过 8 个并发 region。 */
+    /**
+     * tick 上限 = min(核数/2, 32)。
+     * tick 的有效上限由活跃 region 数决定；32 已经远超真实玩家分布
+     * （几十人分散也很少超过 20 个并发 region），但大机器仍能给到这。
+     */
+    private static final int TICK_CAP = tickCapFor(effectiveCoresStatic());
+
+    private static final int PATHFINDING_CAP =
+        Math.max(1, OneiricConfig.intValue("async-pathfinding-threads-cap", 8));
+
+    private static final int FOLIA_ASYNC_CAP =
+        Math.max(2, OneiricConfig.intValue("folia-async-threads-cap", 8));
+
+    private static final int PROPAGATOR_CAP =
+        Math.max(8, OneiricConfig.intValue("ticket-propagators-cap", 32));
+
+    /** 手动指定核数（容器环境探测不准时用）。0 = 自动。 */
+    private static final int ASSUME_CORES = Math.max(0, OneiricConfig.intValue("assume-cores", 0));
+
+    // ================= 按核数比例算上限 =================
+    //
+    // 为什么不是写死绝对值：实测发现 24/32/64 核会分配到完全相同的值，
+    // 大机器买了白买。改成比例后，核越多能用的池子越大。
+    //
+    // 不过上限也按比例增长：磁盘队列开几十个只会增加寻道竞争，
+    // 而 tick 线程再多也没有那么多活跃 region 可跑。
+
+    /**
+     * 计算上限时用的核数。
+     *
+     * <p>不能用 {@link #effectiveCores()} —— 它依赖 {@link #SERVERS_ON_BOX}，
+     * 而那个字段的初始化（文件锁探测）会在本方法之后执行，静态初始化顺序会读到 0。
+     * 这里只用两个已经可用的值：真实核数与 {@link #ASSUME_CORES}。</p>
+     */
+    private static int effectiveCoresStatic() {
+        final int real = Runtime.getRuntime().availableProcessors();
+        final int assumed = Math.max(0, OneiricConfig.intValue("assume-cores", 0));
+        if (assumed > 0) {
+            return Math.min(assumed, real);
+        }
+        return Math.max(1, real);
+    }
+
+    /**
+     * chunk worker 上限 = 核数的 3/4，至少 12。
+     *
+     * <p>worker 是跑图并行度的天花板（gen/population/load 三者都等于它），
+     * 所以它必须随核数增长；留 1/4 给 tick 池、GC、主线程与网络。</p>
+     *
+     * <p>16 核 → 12、32 核 → 24、64 核 → 48。运维可用
+     * {@code -Doneiric.chunk-worker-threads-cap=N} 显式覆盖。</p>
+     */
+    private static int workerCapFor(final int cores) {
+        final int override = OneiricConfig.intValue("chunk-worker-threads-cap", 0);
+        if (override > 0) {
+            return override;
+        }
+        return Math.max(12, (cores * 3) / 4);
+    }
+
+    /**
+     * chunk IO 上限 = 核数的 1/2，上限 16。
+     *
+     * <p>磁盘是队列型资源：4~8 个队列已能让 SATA/NVMe 打满，
+     * 再多只是寻道竞争。所以这里也按比例增长但有硬顶 16。</p>
+     */
+    private static int ioCapFor(final int cores) {
+        final int override = OneiricConfig.intValue("chunk-io-threads-cap", 0);
+        if (override > 0) {
+            return override;
+        }
+        return Math.max(2, Math.min(16, cores / 2));
+    }
+
+    /**
+     * tick 上限 = 核数的 1/2，至少 8、上限 32。
+     *
+     * <p>tick 的有效上限由活跃 region 数决定，不是核数。
+     * 32 已远超真实玩家分布（几十人分散也很少超过 20 个并发 region）。</p>
+     */
+    private static int tickCapFor(final int cores) {
+        final int override = OneiricConfig.intValue("folia-tick-threads-cap", 0);
+        if (override > 0) {
+            return override;
+        }
+        return Math.max(8, Math.min(32, cores / 2));
+    }
+
+    /** 一机多服自动分核。默认开。 */
+    private static final boolean AUTO_SHARE = OneiricConfig.isEnabledOr("auto-share-cores", true);
+
+    // ================= 一机多服探测 =================
+
+    private OneiricThreadSizing() {
+    }
+
+    /**
+     * 持有到进程结束，让注册锁不会被释放。必须声明在 {@link #SERVERS_ON_BOX} **之前**：
+     * 静态字段按文本顺序初始化，写在后面会把 {@code countLiveServers()} 存进去的引用重置为 null，
+     * 相当于静默注销自己，于是每个服都以为自己独占整机。
+     */
+    private static volatile java.nio.channels.FileChannel REGISTRATION_CHANNEL;
+    private static volatile java.nio.channels.FileLock REGISTRATION_LOCK;
+
+    /** 本机有几个本核心的服务端在跑（含自己）。 */
+    private static final int SERVERS_ON_BOX = AUTO_SHARE ? countLiveServers() : 1;
+
+    /**
+     * 统计同机存活的服务端数。
+     *
+     * <p>为什么不做进程扫描：实测 {@code ProcessHandle.info().commandLine()} 在 Windows 上
+     * 对所有非本进程 spawn 的进程返回空，扫描会"看到 0 个"却报告成功 —— 比没有探测更糟。</p>
+     *
+     * <p>改用协作式注册：每个服务端在共享临时目录对自己的锁文件持独占锁。统计就是
+     * "哪个文件还锁着"。进程一死 OS 立刻释放锁，不会留幽灵。</p>
+     */
+    private static int countLiveServers() {
+        int live = 0;
+        java.nio.channels.FileChannel selfChannel = null;
+        java.nio.channels.FileLock selfLock = null;
+        try {
+            final java.nio.file.Path dir = java.nio.file.Path.of(
+                System.getProperty("java.io.tmpdir"), "oneiric-share");
+            java.nio.file.Files.createDirectories(dir);
+
+            final java.nio.file.Path selfPath = dir.resolve("server-" + ProcessHandle.current().pid() + ".lock");
+            selfChannel = java.nio.channels.FileChannel.open(
+                selfPath,
+                java.nio.file.StandardOpenOption.CREATE,
+                java.nio.file.StandardOpenOption.WRITE);
+            selfLock = selfChannel.tryLock();
+            REGISTRATION_CHANNEL = selfChannel;
+            REGISTRATION_LOCK = selfLock;
+            live = 1;
+
+            try (java.util.stream.Stream<java.nio.file.Path> entries = java.nio.file.Files.list(dir)) {
+                for (final java.nio.file.Path entry : (Iterable<java.nio.file.Path>) entries::iterator) {
+                    final String name = entry.getFileName().toString();
+                    if (!name.startsWith("server-") || !name.endsWith(".lock") || entry.equals(selfPath)) {
+                        continue;
+                    }
+                    try (java.nio.channels.FileChannel other = java.nio.channels.FileChannel.open(
+                            entry,
+                            java.nio.file.StandardOpenOption.WRITE)) {
+                        final java.nio.channels.FileLock probe = other.tryLock();
+                        if (probe != null) {
+                            // 锁能拿到 = 原主已死，清掉残留
+                            probe.release();
+                            try {
+                                java.nio.file.Files.deleteIfExists(entry);
+                            } catch (final Throwable ignored) {
+                                // 残留文件只是碍眼
+                            }
+                        } else {
+                            live++;
+                        }
+                    } catch (final Throwable lockedOrUnreadable) {
+                        // 被活着的服务端锁着，或无权打开：都算活着
+                        live++;
+                    }
+                }
+            }
+            return live;
+        } catch (final Throwable failure) {
+            // 临时目录不可用绝不能阻止启动，也不能悄悄改变分配
+            if (selfLock != null) {
+                try {
+                    selfLock.release();
+                } catch (final Throwable ignored) {
+                    // 无事可做
+                }
+            }
+            if (selfChannel != null) {
+                try {
+                    selfChannel.close();
+                } catch (final Throwable ignored) {
+                    // 无事可做
+                }
+            }
+            REGISTRATION_CHANNEL = null;
+            REGISTRATION_LOCK = null;
+            return 1;
+        }
+    }
+
+    /**
+     * 启动 20 秒后再数一次，如果兄弟服数量变了就**说出来**。
+     *
+     * <p>先启动的服数到 1 就按整机分核；晚启动的第二个服数到 2，只拿一半。
+     * 先启动的那个无法预知未来。事后调整活线程池不值得冒险
+     * （几个池子是 Moonrise 内部按设计一次性定死的），但**不能沉默**。</p>
+     */
+    private static void scheduleShareRecheck() {
+        if (!AUTO_SHARE) {
+            return;
+        }
+        try {
+            final Thread probe = new Thread(() -> {
+                try {
+                    Thread.sleep(20_000L);
+                    final int now = countLiveServers();
+                    if (now != SERVERS_ON_BOX) {
+                        org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                            "[Oneiric] 现在有 {} 个 Oneiric 服务端共享本机，但这个服启动时按 {} 个计算"
+                                + "（有效核数 {}）。重启本服可重新分配；或用 -Doneiric.assume-cores=N 手动指定。",
+                            now, SERVERS_ON_BOX, effectiveCores());
+                    }
+                } catch (final Throwable ignored) {
+                    // 诊断线程绝不能变成服务器故障
+                }
+            }, "Oneiric share recheck");
+            probe.setDaemon(true);
+            probe.start();
+        } catch (final Throwable ignored) {
+            // 线程创建被拒：启动日志里的那行仍会报告假定的核数
+        }
+    }
+
+    // ================= 公共 API =================
+
+    public static boolean isEnabled() {
+        return ENABLED;
+    }
+
+    public static int ioCap() {
+        return IO_CAP;
+    }
+    public static int workerCap() {
+        return WORKER_CAP;
+    }
+    public static int tickCap() {
+        return TICK_CAP;
+    }
+    public static int assumeCores() {
+        return ASSUME_CORES;
+    }
+
+    /** 本核心认为有几个服务端共享本机（探测关闭/失败时为 1）。 */
+    public static int serversOnBox() {
+        return SERVERS_ON_BOX;
+    }
+
+    /**
+     * 所有自动值应该使用的核数。
+     *
+     * <p>优先级：显式 {@code oneiric.assume-cores} 最高；否则真实核数除以探测到的兄弟服数；
+     * 永不低于 1。{@code assume-cores} 不会超过真实核数（写错也放大不了小机器）。</p>
+     */
+    public static int effectiveCores() {
+        final int real = Runtime.getRuntime().availableProcessors();
+        if (assumeCores() > 0) {
+            return Math.min(ASSUME_CORES, real);
+        }
+        if (SERVERS_ON_BOX <= 1) {
+            return real;
+        }
+        return Math.max(1, real / serversOnBox());
+    }
+
+    /**
+     * **tick 线程数**。
+     *
+     * <p>tick 的有效上限由**活跃 region 数**决定，而不是核数：一个玩家通常只激活 1~3 个 region，
+     * 几十人分散也很难超过 8 个并发 region。所以给「半个核数、上限 8」，把另一半留给 worker ——
+     * 跑图慢的瓶颈是 worker，不是 tick。</p>
+     *
+     * <p>为什么不能像上游那样 {@code cores/2 再 /4}：16 核算成 2，只有 2 个线程能干活。
+     * 为什么也不能简单「核数 - 2」：tick 池声明 14 个线程会挤占 worker 的核，
+     * 而 region 少时那 14 个线程大部分在 parking 等活，纯属占着槽位。</p>
+     */
+    public static int autoTickThreads() {
+        final int cores = effectiveCores();
+        if (cores <= 2) {
+            return cores;
+        }
+        if (cores <= 4) {
+            return cores - 1;
+        }
+        return clamp(cores / 2, 2, tickCap());
+    }
+
+    /**
+     * **chunk worker 线程数** —— 跑图主力。
+     *
+     * <p>{@code gen-parallelism} / {@code population-parallelism} / {@code load-parallelism}
+     * 三个值全部等于 worker 数（见 {@code ChunkTaskScheduler}），所以 worker 就是跑图的天花板。</p>
+     *
+     * <p>算法 {@code 核数 - 2}：留 2 核给 tick、GC、主线程与网络。
+     * 不用上游的 {@code cores/2} —— 那是「tick 是主负载」的旧假设。</p>
+     */
+    public static int autoWorkerThreads(final int logicalCores) {
+        // 按核数的 3/4 给 worker（至少 2）：它是跑图并行度的天花板。
+        // 16 核 → 12、32 核 → 24；上限由 workerCapFor() 决定（也是 3/4）。
+        // 不做「核数 - 2」：那在 64 核上只给 62，会把磁盘和 GC 饿死。
+        final int proportional = Math.max(2, (logicalCores * 3) / 4);
+        return clamp(proportional, 2, workerCap());
+    }
+    /**
+     * **chunk IO 线程数**。
+     *
+     * <p>磁盘 IO 是队列型负载：上游写死 1 意味着跑图时所有区块读写排队，
+     * 这是"加载慢"的第二个直接原因。给 {@code 核数/2}（上限 8）——
+     * SATA 盘 4 个够用，NVMe 吃得下 8 个；机械盘再多只会增加寻道竞争。</p>
+     */
+    public static int autoIoThreads(final int logicalCores) {
+        // 核数 / 2（上限由 ioCapFor 决定）：磁盘队列型负载，核多不代表要多开队列。
+        return clamp(logicalCores / 2, 2, ioCap());
+    }
+    /** 异步寻路池。CPU 密集，跟核数走。 */
+    public static int autoPathfindingThreads() {
+        return clamp(effectiveCores() / 2, 1, PATHFINDING_CAP);
+    }
+
+    /** Folia async 调度器池。 */
+    public static int autoFoliaAsyncThreads() {
+        return clamp(effectiveCores() / 2, 4, FOLIA_ASYNC_CAP);
+    }
+
+    /** Ticket 层级传播器缓存大小（不是线程数，是对象复用池）。 */
+    public static int autoPropagators() {
+        return clamp(effectiveCores(), 8, PROPAGATOR_CAP);
+    }
+
+    // ================= 解析：显式值优先，其次自动，最后兜底 =================
+
+    /**
+     * 线程数的最终解析。
+     *
+     * @param configured 配置里写的值（&gt;0 表示运维显式指定，永远优先）
+     * @param fallback   上游原算法算出的值（开关关闭时原样返回）
+     * @param auto       自动算法算出的值
+     */
+    public static int resolve(final int configured, final int fallback, final int auto) {
+        if (configured > 0) {
+            return configured;
+        }
+        return ENABLED ? auto : fallback;
+    }
+
+    /** {@link #resolve} 的 tick 专用便捷式。 */
+    public static int resolveTickThreads(final int configured, final int fallback) {
+        return resolve(configured, fallback, autoTickThreads());
+    }
+
+    /** {@link #resolve} 的 worker 专用便捷式。 */
+    public static int resolveWorkerThreads(final int configured, final int fallback) {
+        return resolve(configured, fallback, autoWorkerThreads(effectiveCores()));
+    }
+
+    /** {@link #resolve} 的 IO 专用便捷式。 */
+    public static int resolveIoThreads(final int configured, final int fallback) {
+        return resolve(configured, fallback, autoIoThreads(effectiveCores()));
+    }
+
+    static int clamp(final int value, final int low, final int high) {
+        return Math.max(low, Math.min(high, value));
+    }
+
+    /** 保证状态里的一机多服复查只启动一次。 */
+    private static final AtomicBoolean RECHECK_STARTED = new AtomicBoolean(false);
+
+    /**
+     * 状态行：一次看全所有池子的实际取值。
+     *
+     * <p>运维据此判断"我的机器被怎么分配了"，也是排查"线程不动"的第一手信息。</p>
+     */
+    public static String status() {
+        if (RECHECK_STARTED.compareAndSet(false, true)) {
+            scheduleShareRecheck();
+        }
+        final int real = Runtime.getRuntime().availableProcessors();
+        final int cores = effectiveCores();
+        final StringBuilder sb = new StringBuilder(160);
+        sb.append("autoThreadSizing=").append(ENABLED ? "on" : "off");
+        sb.append(" cores=").append(cores);
+        if (cores != real) {
+            sb.append("(real=").append(real);
+            if (assumeCores() > 0) {
+                sb.append(",assumed");
+            } else {
+                sb.append(",servers=").append(serversOnBox());
+            }
+            sb.append(')');
+        }
+        sb.append(" tick=").append(ENABLED ? String.valueOf(autoTickThreads()) : "upstream")
+          .append('(').append(tickCap()).append(')');
+        sb.append(" worker=").append(ENABLED ? String.valueOf(autoWorkerThreads(cores)) : "upstream")
+          .append('(').append(workerCap()).append(')');
+        sb.append(" io=").append(ENABLED ? String.valueOf(autoIoThreads(cores)) : "upstream")
+          .append('(').append(ioCap()).append(')');
+        sb.append(" path=").append(autoPathfindingThreads());
+        sb.append(" async=").append(autoFoliaAsyncThreads());
+        sb.append(" prop=").append(autoPropagators());
+        sb.append(" servers=").append(serversOnBox());
+        return sb.toString();
+    }
+}
