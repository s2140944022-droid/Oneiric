+package io.papermc.paper.oneiric;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * Oneiric - {@code oneiric.yml} 的**读写器**。
+ *
+ * <h2>为什么读写都在这里</h2>
+ *
+ * <p>只写不读 = 用户改了文件却没生效；只读不写 = 用户不知道该改什么。
+ * 两者都在本类，格式才可能真正对齐。</p>
+ *
+ * <h2>为什么不用 YAML 库</h2>
+ *
+ * <p>{@code oneiric.yml} 的结构被刻意限制成<b>一个平铺的 {@code switches:} 段</b> ——
+ * 每行 {@code 名字: 布尔值}，前置三行注释。用一份几十行的解析器就能读，
+ * 换来的是「不需要额外依赖、不需要担心 YAML 库版本漂移」。</p>
+ *
+ * <h2>优先级（不可颠倒）</h2>
+ *
+ * <ol>
+ *   <li>显式 {@code -Doneiric.<名字>=} 命令行参数 —— <b>最高</b>，运维临时覆盖用；</li>
+ *   <li>{@code oneiric.yml} 里的值；</li>
+ *   <li>{@link OneiricConfig#DEFAULT_ON} 里的默认值。</li>
+ * </ol>
+ *
+ * <p>命令行必须最高：起服脚本注入的覆盖不该被一个过期文件压掉。反过来，
+ * 文件里的值必须能覆盖默认值，否则文件就没用了。</p>
+ */
+public final class OneiricYml {
+
+    /** 文件名。 */
+    public static final String FILE = "oneiric.yml";
+
+    /** yml 实际生效了几个开关（仅诊断）。 */
+    private static volatile int loadedSwitches = 0;
+
+    /** yml 里被忽略的未知开关名（拼错的键）。 */
+    private static volatile String unknownKeys = "";
+
+    private OneiricYml() {
+    }
+
+    /**
+     * 从服务器根目录加载 {@code oneiric.yml}。
+     *
+     * <p>只设置<b>当前未被显式设置</b>的系统属性，因此不会压掉命令行参数。</p>
+     *
+     * @param serverRoot 服务器根目录（通常是进程工作目录）
+     */
+    public static void load(final Path serverRoot) {
+        if (serverRoot == null) {
+            return;
+        }
+        final Path file = serverRoot.resolve(FILE);
+        if (!Files.isRegularFile(file)) {
+            return;
+        }
+        final Map<String, Boolean> values;
+        try {
+            values = parse(file);
+        } catch (final IOException e) {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                    "[Oneiric] 读取 {} 失败，将使用内置默认值: {}", FILE, e.toString());
+            return;
+        }
+        int applied = 0;
+        final StringBuilder unknown = new StringBuilder();
+        for (final Map.Entry<String, Boolean> e : values.entrySet()) {
+            final String name = e.getKey();
+            if (!OneiricConfig.isKnown(name)) {
+                // 拼错的键必须被点名：静默忽略会让用户以为"我改了它"
+                if (unknown.length() > 0) {
+                    unknown.append(", ");
+                }
+                unknown.append(name);
+                continue;
+            }
+            final String prop = "oneiric." + name;
+            if (System.getProperty(prop) != null) {
+                continue; // 命令行优先，不覆盖
+            }
+            System.setProperty(prop, e.getValue().toString());
+            applied++;
+        }
+        loadedSwitches = applied;
+        if (unknown.length() > 0) {
+            unknownKeys = unknown.toString();
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                    "[Oneiric] {} 里有本 build 不认识的开关名（已忽略）: {}", FILE, unknown);
+        }
+    }
+
+    /**
+     * 解析 {@code switches:} 段。**只接受平铺结构**。
+     *
+     * <p>缩进比 {@code switches:} 更深、且形如 {@code 名字: true|false} 的行会被采纳；
+     * 以 {@code #} 开头的行整体忽略（注释）；非布尔的键忽略（本类不处理参数键）。</p>
+     */
+    static Map<String, Boolean> parse(final Path file) throws IOException {
+        final Map<String, Boolean> out = new LinkedHashMap<>();
+        boolean inSwitches = false;
+        int switchesIndent = -1;
+
+        for (final String rawLine : Files.readAllLines(file, StandardCharsets.UTF_8)) {
+            final String line = rawLine.stripTrailing();
+            final String trimmed = line.strip();
+            if (trimmed.isEmpty() || trimmed.startsWith("#")) {
+                continue;
+            }
+            final int indent = line.length() - line.stripLeading().length();
+            if (!inSwitches) {
+                if (trimmed.equals("switches:")) {
+                    inSwitches = true;
+                    switchesIndent = indent;
+                }
+                continue;
+            }
+            // 已经离开 switches 段（缩进回到同级或更少）
+            if (indent <= switchesIndent) {
+                inSwitches = false;
+                continue;
+            }
+            final int colon = trimmed.indexOf(':');
+            if (colon <= 0) {
+                continue;
+            }
+            final String name = trimmed.substring(0, colon).strip();
+            String value = trimmed.substring(colon + 1).strip();
+            // 去掉行尾注释：  true    # [默认开]
+            final int hash = value.indexOf('#');
+            if (hash >= 0) {
+                value = value.substring(0, hash).strip();
+            }
+            if (name.isEmpty() || value.isEmpty()) {
+                continue;
+            }
+            if (value.equalsIgnoreCase("true") || value.equalsIgnoreCase("false")) {
+                out.put(name, Boolean.parseBoolean(value.toLowerCase()));
+            }
+        }
+        return out;
+    }
