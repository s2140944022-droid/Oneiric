+            "redstone-trapdoor-connect",
+            "no-tnt-place-update",
+            "old-hopper-suckin",
+            "hopper-counter",
+            "hopper-counter-unlimited-speed",
+            "mc-technical-mode"
+    };
+
+    private static final Set<String> KNOWN = Set.of(NAMES);
+
+    private OneiricConfig() {
+    }
+
+    /** 该名字是否是本 build 认识的开关。供 yml 解析点名拼错的键。 */
+    public static boolean isKnown(final String name) {
+        return name != null && KNOWN.contains(name);
+    }
+
+    /** 开关是否生效。显式属性优先，其次 {@link #DEFAULT_ON}。 */
+    public static boolean isEnabled(final String name) {
+        return isEnabledOr(name, DEFAULT_ON.contains(name));
+    }
+
+    /**
+     * 带显式兜底的读取。**只给"必须默认开"的调用点用**。
+     *
+     * <p>存在的理由：{@link #isEnabled} 的兜底只看 {@code DEFAULT_ON}，而少数移植开关
+     * （Leaves 系那些"把 Paper 的优化退回原版语义"的）在旧树里是用
+     * {@code isEnabledOr(name, true)} 读的。保留这个方法是为了让移植过来的调用点
+     * **一行都不用改**，语义保持原样。</p>
+     */
+    public static boolean isEnabledOr(final String name, final boolean fallback) {
+        if (FORCED_OFF.contains(name)) {
+            return false;
+        }
+        final String raw = System.getProperty(PREFIX + name);
+        return (raw == null) ? fallback : Boolean.parseBoolean(raw.trim());
+    }
+
+    /** 实际生效的默认值（写 yml、写状态行必须用它，不能用 {@link #isEnabled}）。 */
+    public static boolean effectiveDefault(final String name) {
+        return !FORCED_OFF.contains(name) && DEFAULT_ON.contains(name);
+    }
+
+    /**
+     * 读一个整数值的 Oneiric 属性（供线程数等数值型开关使用）。
+     *
+     * <p>与 {@link #isEnabled} 的布尔读取并列：数值型配置不能走布尔路径。
+     * 解析失败时**点名告警**并返回兜底值 —— 一个写错的 {@code -Doneiric.xxx=abc}
+     * 必须让运维看见，而不是被静默替换成默认值。
+     */
+    public static int intValue(final String name, final int fallback) {
+        final String raw = System.getProperty(PREFIX + name);
+        if (raw == null) {
+            return fallback;
+        }
+        try {
+            return Integer.parseInt(raw.trim());
+        } catch (final NumberFormatException malformed) {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                    "[Oneiric] oneiric.{} 不是整数（{}），改用 {}", name, raw, fallback);
+            return fallback;
+        }
+    }
+
+    /** 全部开关的生效值，供状态行使用。 */
+    public static String status() {
+        final StringBuilder sb = new StringBuilder(256);
+        for (final String name : NAMES) {
+            if (sb.length() > 0) {
+                sb.append(' ');
+            }
+            sb.append(name).append('=').append(isEnabled(name) ? "true" : "false");
+            if (FORCED_OFF.contains(name)) {
+                sb.append("(forced-off)");
+            }
+        }
+        return sb.toString();
+    }
+
+    /** 全部开关名（副本）。 */
+}
+
diff --git a/src/main/java/io/papermc/paper/oneiric/OneiricEntityDensity.java b/src/main/java/io/papermc/paper/oneiric/OneiricEntityDensity.java
new file mode 100644
index 0000000000000000000000000000000000000000..95d43b203a70a67427bbf0499f9934c2ed438ddd
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/OneiricEntityDensity.java
@@ -0,0 +1,141 @@
+package io.papermc.paper.oneiric;
+
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.LongAdder;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.LivingEntity;
+
+/**
+ * Oneiric - 实体密度热力图（诊断）。
+ *
+ * <p>思路参考 Mili（GPLv3）的 {@code EntityDensityTracker}，但**刻意不沿用它的统计方式**：
+ * Mili 用 {@link net.minecraft.world.level.Level#getEntities()} 全量遍历，
+ * 在"高实体量"场景下这个诊断本身就成了 O(entities) 的开销，反过来干扰被测对象。</p>
+ *
+ * <p>这里改为在实体 tick 路径上**顺带累加**，不额外遍历：
+ * 每 tick 由 {@code ServerLevel} 调用一次 {@link #beginTick()} 清零当前 tick 的桶，
+ * 实体 tick 时调用 {@link #record(Entity)} 累加，tick 结束时 {@link #endTick()} 合成。</p>
+ *
+ * <p><b>只在开启时累加</b>。关闭时 {@link #record(Entity)} 是常量判断，零开销。</p>
+ *
+ * <p>用途：定位"实体全挤在几个区块"的热点，指导 region 划分和刷怪上限，
+ * 而不是改变任何游戏行为。</p>
+ */
+public final class OneiricEntityDensity {
+
+    private static final boolean ENABLED = OneiricConfig.isEnabled("entity-density");
+
+    /** 单元格边长（区块数）。4 区块 = 64 方块，与刷怪范围接近。 */
+    private static final int CELL_CHUNKS = Integer.getInteger("oneiric.entity-density.cell-chunks", 4);
+
+    /** 只保留 top-N 热点，避免诊断本身占用大量内存。 */
+    private static final int TOP_N = Integer.getInteger("oneiric.entity-density.top-n", 8);
+
+    private OneiricEntityDensity() {
+    }
+
+    public static boolean enabled() {
+        return ENABLED;
+    }
+
+    /**
+     * 每个区域线程的当前 tick 计数。
+     *
+     * <p><b>为什么是 ThreadLocal</b>：Folia 的多个区域线程会并发跑实体 tick，
+     * 共享 map 会把不同区域的计数混在一起，"每格密度"就失去意义。</p>
+     *
+     * <p><b>为什么不靠 beginTick 清零</b>：实测 {@code endTick()} 与下一次
+     * {@code record()} 的相对顺序由区域调度决定，不能假设 {@code beginTick} 一定先跑。
+     * 所以这里在 {@code endTick} 里**先取快照再 clear**，无论清零在哪，读到的都是
+     * 最近一个完整 tick 的数据。</p>
+     */
+    private static final ThreadLocal<java.util.HashMap<Long, Integer>> CURRENT =
+            ThreadLocal.withInitial(java.util.HashMap::new);
+
+    private static final LongAdder TOTAL_TICKS = new LongAdder();
+    private static final AtomicLong PEAK_DENSITY = new AtomicLong();
+    private static final LongAdder TOTAL_RECORDS = new LongAdder();
+    private static final AtomicLong LAST_TOTAL = new AtomicLong();
+    private static final AtomicLong LAST_CELLS = new AtomicLong();
+
+    public static void beginTick() {
+        if (!ENABLED) {
+            return;
+        }
+        // 只在"上一轮确实没被 endTick 消费"时才清，避免与 endTick 抢跑。
+        final java.util.HashMap<Long, Integer> cells = CURRENT.get();
+        if (cells.size() > MAX_RETAINED_CELLS) {
+            cells.clear();
+        }
+    }
+
+    /** 超过这个规模才在 beginTick 里主动清，防止实体量剧降后旧数据残留。 */
+    private static final int MAX_RETAINED_CELLS = Integer.getInteger("oneiric.entity-density.max-cells", 4096);
+
+    public static void record(final Entity entity) {
+        if (!ENABLED) {
+            return;
+        }
+        final long key = cellKey(entity.getBlockX(), entity.getBlockZ());
+        CURRENT.get().merge(key, 1, Integer::sum);
+        TOTAL_RECORDS.increment();
+    }
+
+    public static void endTick() {
+        if (!ENABLED) {
+            return;
+        }
+        // 先取快照再清：不依赖 beginTick 的执行时机。
+        final java.util.HashMap<Long, Integer> cells = CURRENT.get();
+        long total = 0L;
+        int peak = 0;
+        for (final int count : cells.values()) {
+            total += count;
+            if (count > peak) {
+                peak = count;
+            }
+        }
+        final int cellCount = cells.size();
+        cells.clear();
+
+        if (total == 0L) {
+            // 没有实体的 tick（例如空区域），不要把 last 清零。
+            TOTAL_TICKS.increment();
+            return;
+        }
+        LAST_TOTAL.set(total);
+        LAST_CELLS.set(cellCount);
+        long prev = PEAK_DENSITY.get();
+        while (peak > prev && !PEAK_DENSITY.compareAndSet(prev, peak)) {
+            prev = PEAK_DENSITY.get();
+        }
+        TOTAL_TICKS.increment();
+    }
+
+    /** 单元格坐标 → long key。与 Mili 相同的打包方式。 */
+    private static long cellKey(final int blockX, final int blockZ) {
+        final int cellX = Math.floorDiv(blockX, CELL_CHUNKS << 4);
+        final int cellZ = Math.floorDiv(blockZ, CELL_CHUNKS << 4);
+        return ((long) cellX << 32) | (cellZ & 0xFFFFFFFFL);
+    }
+
+    /**
+     * 一行诊断。{@code entities} 是本 tick 经实体 tick 路径累加到的总数，
+     * {@code cells} 是有实体的单元格数，{@code peak} 是历史最高单格密度。
+     *
+     * <p>注意 {@code entities} 与 {@code /list} 或 profiler 的实体总数可能不同：
+     * 它只统计**实际走到 tick 路径**的实体（未加载区块里的不算）。这正是它的价值所在 ——
+     * 和"官方实体数"对比就能看出"有多少实体没在 tick"。</p>
+     */
+    public static String report() {
+        if (!ENABLED) {
+            return "entity-density=off";
+        }
+        return String.format(
+                "entity-density=on ticks=%d records=%d last(entities=%d cells=%d) peakPerCell=%d cellChunks=%d",
+                TOTAL_TICKS.sum(), TOTAL_RECORDS.sum(), LAST_TOTAL.get(), LAST_CELLS.get(),
+                PEAK_DENSITY.get(), CELL_CHUNKS);
+    }
+}
diff --git a/src/main/java/io/papermc/paper/oneiric/OneiricEntityQueryBuffer.java b/src/main/java/io/papermc/paper/oneiric/OneiricEntityQueryBuffer.java
new file mode 100644
index 0000000000000000000000000000000000000000..f68f22103b85eaab287280b42cb603add701b114
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/OneiricEntityQueryBuffer.java
@@ -0,0 +1,54 @@
+package io.papermc.paper.oneiric;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Predicate;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.phys.AABB;
+
+/**
+ * Oneiric - 每线程可复用的实体查询缓冲区。
+ *
+ * <p>只缓存结果列表本身，不缓存实体、不跨线程共享、不改变查询顺序。
+ * 嵌套查询（例如激活判定过程中触发插件逻辑再次查询）会退化为一次性的
+ * 独立缓冲区，避免清空外层正在遍历的列表。</p>
+ */
+public final class OneiricEntityQueryBuffer implements AutoCloseable {
+
+    private static final ThreadLocal<OneiricEntityQueryBuffer> POOL =
+            ThreadLocal.withInitial(() -> new OneiricEntityQueryBuffer(true));
+
+    private final List<Entity> results = new ArrayList<>();
+    private final boolean pooled;
+    private boolean inUse;
+
+    private OneiricEntityQueryBuffer(final boolean pooled) {
+        this.pooled = pooled;
+    }
+
+    public static OneiricEntityQueryBuffer acquire() {
+        final OneiricEntityQueryBuffer pooled = POOL.get();
+        if (pooled.inUse) {
+            return new OneiricEntityQueryBuffer(false);
+        }
+        pooled.inUse = true;
+        pooled.results.clear();
+        return pooled;
+    }
+
+    public List<Entity> query(final ServerLevel level, final Entity except, final AABB box,
+                              final Predicate<? super Entity> predicate) {
+        this.results.clear();
+        level.moonrise$getEntityLookup().getEntities(except, box, this.results, predicate);
+        return this.results;
+    }
+
+    @Override
+    public void close() {
+        this.results.clear();
+        if (this.pooled) {
+            this.inUse = false;
+        }
+    }
+}
diff --git a/src/main/java/io/papermc/paper/oneiric/OneiricLongRangeCoupling.java b/src/main/java/io/papermc/paper/oneiric/OneiricLongRangeCoupling.java
new file mode 100644
index 0000000000000000000000000000000000000000..f6a46304fd4a7d90e5136c9c179ef1f692ea619a
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/OneiricLongRangeCoupling.java
@@ -0,0 +1,140 @@
+package io.papermc.paper.oneiric;
+
+import net.minecraft.world.entity.Entity;
+
+/**
+ * Oneiric - **长程耦合包络**：Folia 完全不处理的那一维。
+ *
+ * <h2>它要解决的问题（一句话）</h2>
+ *
+ * <p>Folia 的空节不变式只看邻接：两个活跃 section 之间隔了至少一个空 section，
+ * 就允许并行。但一台跨 3 个基础区的红石机器，中间可能恰好有一个**未加载**的基础区残着空节，
+ * 于是两侧被判成两个独立区、被两个线程同时 tick —— 那台机器在同一个 tick 里被劈成两半。</p>
+ *
+ * <h2>为什么必须「宁可偏大」</h2>
+ *
+ * <p>半径算小了，后果不是「少并行一点」，而是<b>把一台会互相影响的机器判成安全并并行</b> ——
+ * 那属于整个体系最不能出的一类错。所以本类的每个半径都取该类的**上界**。</p>
+ *
+ * <h2>它怎么影响分区</h2>
+ *
+ * <p>检测到某实体的包络跨了基础区，就<b>不</b>在本 tick 里做任何抢占（正在 tick 的区不可被打断），
+ * 而是把涉及的基础区登记进 {@link OneiricRegionPartition}。合并由内核在**下一个 tick 边界**自然生效。</p>
+ */
+public final class OneiricLongRangeCoupling {
+
+    /** 开关名。 */
+    public static final String SWITCH = "region-long-range-coupling";
+
+    /**
+     * 末影人传送距离的上界（方块）。原版 {@code follow_range = 16}，但传送可达 ±32。
+     *
+     * <p>这个数字是本类存在的理由之一：漏掉末影人会让包络严重偏小，
+     * 于是「被传送跨区的末影人」会在两个区里各 tick 一次。</p>
+     */
+    private static final double ENDERMAN_TELEPORT = 32.0D;
+
+    /** 默认影响半径（方块）：覆盖碰撞、追踪、物品拾取等常规交互。 */
+    private static final double DEFAULT_RADIUS = 5.0D;
+
+    /** TNT/水晶等可被插件改大的爆炸半径上界兜底。 */
+    private static final double EXPLOSION_RADIUS = 8.0D;
+
+    private OneiricLongRangeCoupling() {
+    }
+
+    public static boolean enabled() {
+        return OneiricConfig.isEnabled(SWITCH);
+    }
+
+    /**
+     * 该实体的**影响半径上界**（方块）。
+     *
+     * <p>只覆盖「会影响别的区块」的类别；未识别的一律按 {@link #DEFAULT_RADIUS} 处理，
+     * 因为「不认识」不能等于「没有影响」。</p>
+     */
+    public static double radiusOf(final Entity entity) {
+        if (entity == null) {
+            return DEFAULT_RADIUS;
+        }
+        final String name = entity.getClass().getName();
+        if (name.endsWith("EnderMan") || name.endsWith("Enderman")) {
+            return ENDERMAN_TELEPORT;
+        }
+        if (name.endsWith("PrimedTnt") || name.endsWith("Tnt") || name.endsWith("EndCrystal")) {
+            return EXPLOSION_RADIUS;
+        }
+        if (entity instanceof net.minecraft.world.entity.player.Player) {
+            return 8.0D;
+        }
+        return DEFAULT_RADIUS;
+    }
+
+    /**
+     * 该实体本 tick 的包络是否跨了 ≥2 个基础区。
+     *
+     * <p>判定用**包围盒四角 + 中心**，而不是只看中心：只看中心会漏掉
+     * 「站在边界上、半径覆盖两侧」这种最常见的情形。</p>
+     */
+    public static boolean crossesBaseRegion(final Entity entity, final double radius) {
+        if (entity == null) {
+            return false;
+        }
+        final double x = entity.getX();
+        final double z = entity.getZ();
+        final long center = chunkOf(x, z);
+        final long a = chunkOf(x - radius, z - radius);
+        final long b = chunkOf(x + radius, z + radius);
+        final long c = chunkOf(x - radius, z + radius);
+        final long d = chunkOf(x + radius, z - radius);
+        return a != center || b != center || c != center || d != center || a != b || c != d;
+    }
+
+    /** 世界坐标 → 基础区 key（先落区块，再落基础区）。 */
+    private static long chunkOf(final double blockX, final double blockZ) {
+        return OneiricBaseRegion.keyOfChunk(
+                ((int) Math.floor(blockX)) >> 4, ((int) Math.floor(blockZ)) >> 4);
+    }
+
+    /**
+     * 检查一个实体，跨区就把涉及的基础区登记成「必须同区」。
+     *
+     * <p>这条路径是被动观测：成本是一次包围盒算术，与并行度收益相比可忽略；
+     * 而不做它的代价是静默破序。</p>
+     *
+     * @return 本次新登记的边数
+     */
+    public static int observe(final Entity entity) {
+        if (!enabled() || entity == null) {
+            return 0;
+        }
+        final double radius = radiusOf(entity);
+        if (!crossesBaseRegion(entity, radius)) {
+            return 0;
+        }
+        final double x = entity.getX();
+        final double z = entity.getZ();
+        final long center = chunkOf(x, z);
+        final int minChunkX = ((int) Math.floor(x - radius)) >> 4;
+        final int maxChunkX = ((int) Math.floor(x + radius)) >> 4;
+        final int minChunkZ = ((int) Math.floor(z - radius)) >> 4;
+        final int maxChunkZ = ((int) Math.floor(z + radius)) >> 4;
+        int added = 0;
+        for (int cx = minChunkX; cx <= maxChunkX; ++cx) {
+            for (int cz = minChunkZ; cz <= maxChunkZ; ++cz) {
+                final long other = OneiricBaseRegion.keyOfChunk(cx, cz);
+                if (other != center && OneiricRegionPartition.find(other) != OneiricRegionPartition.find(center)) {
+                    OneiricRegionPartition.union(center, other,
+                            "envelope:" + entity.getClass().getSimpleName() + "@r" + (int) radius);
+                    ++added;
+                }
+            }
+        }
+        return added;
+    }
+
+    /** 状态行片段。 */
+    public static String status() {
+        return "long-range=" + (enabled() ? "on" : "off");
+    }
+}
diff --git a/src/main/java/io/papermc/paper/oneiric/OneiricParallelismReport.java b/src/main/java/io/papermc/paper/oneiric/OneiricParallelismReport.java
new file mode 100644
index 0000000000000000000000000000000000000000..256f9ca3b8f4f6c8c678f29ec247313fa73a8ad2
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/OneiricParallelismReport.java
@@ -0,0 +1,108 @@
+package io.papermc.paper.oneiric;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Oneiric - **并行度损失可见性**。
+ *
+ * <h2>为什么这是必做项，不是可选项</h2>
+ *
+ * <p>合并一旦发生，某个边界会<b>长期保持合并</b>，并行度永久损失，而且
+ * <b>没有任何日志</b>。这是整套设计里最隐蔽的一类性能损失：
+ * 服主只会觉得「开了并行但没变快」，而没有任何线索指向「哪条边界吃掉了并行度」。</p>
+ *
+ * <h2>两个计数必须分开报</h2>
+ *
+ * <table>
+ *   <caption>必须区分的两件事</caption>
+ *   <tr><th>计数</th><th>含义</th><th>是否算损失</th></tr>
+ *   <tr><td>{@code 因耦合否决}</td><td>边界上真的还有耦合 → 合并是<b>正确</b>的</td><td>❌ 不是损失</td></tr>
+ *   <tr><td>{@code 因粘性保持}</td><td>边界已无耦合，只是历史原因没拆</td><td>✅ 是损失</td></tr>
+ * </table>
+ *
+ * <p>混成一个数字，运维无法判断该不该介入：前者说明设计在正常工作，
+ * 后者说明需要拆机器或调小 simulation-distance。</p>
+ *
+ * <h2>并行度怎么算</h2>
+ *
+ * <p>{@code 有效并行度 = 活跃基础区数 − Σ(每簇成员数 − 1)}。
+ * 这是<b>结构上限</b>；实际并行度还受线程数限制，报告里把两者分开写，不混为一谈。</p>
+ */
+public final class OneiricParallelismReport {
+
+    /** 开关名。 */
+    public static final String SWITCH = "region-parallelism-report";
+
+    private OneiricParallelismReport() {
+    }
+
+    public static boolean enabled() {
+        return OneiricConfig.isEnabled(SWITCH);
+    }
+
+    /**
+     * 结构层面的并行度快照。
+     *
+     * @param activeBaseRegions 本 tick 真正活跃的基础区数
+     */
+    public static Snapshot snapshot(final int activeBaseRegions) {
+        final Map<Long, List<Long>> clusters = OneiricRegionPartition.clusters();
+        int mergedAway = 0;
+        int largest = 0;
+        long largestRoot = 0L;
+        for (final Map.Entry<Long, List<Long>> e : clusters.entrySet()) {
+            final int size = e.getValue().size();
+            if (size > 1) {
+                mergedAway += size - 1;
+                if (size > largest) {
+                    largest = size;
+                    largestRoot = e.getKey();
+                }
+            }
+        }
+        final int effective = Math.max(1, activeBaseRegions - mergedAway);
+        return new Snapshot(
+                activeBaseRegions,
+                effective,
+                mergedAway,
+                OneiricRegionPartition.vetoedSplitCount(),
+                clusters.size(),
+                largest,
+                largestRoot,
+                largest > 1 ? OneiricRegionPartition.reasonOf(largestRoot) : "");
+    }
+
+    /** 一行式状态（供 {@code /oneiric} 使用）。 */
+    public static String status(final int activeBaseRegions) {
+        if (!enabled()) {
+            return "parallelism-report=off";
+        }
+        final Snapshot s = snapshot(activeBaseRegions);
+        return "baseRegions=" + s.activeBaseRegions()
+                + " effective=" + s.effectiveParallelism()
+                + " mergedAway=" + s.mergedAway()
+                + " vetoedSplits=" + s.vetoedSplits()
+                + " clusters=" + s.clusters()
+                + (s.largestCluster() > 1
+                    ? " largest=" + s.largestCluster() + "(" + s.largestReason() + ")"
+                    : "");
+    }
+
+    /** 结构快照。字段名即报告口径，不留歧义。 */
+    public record Snapshot(
+            int activeBaseRegions,
+            int effectiveParallelism,
+            int mergedAway,
+            long vetoedSplits,
+            int clusters,
+            int largestCluster,
+            long largestClusterRoot,
+            String largestReason
+    ) {
+        /** 并行度损失占比（0–1）。用于判断「值不值得去拆机器」。 */
+        public double lossRatio() {
+            return activeBaseRegions <= 0 ? 0.0D : (double) mergedAway / (double) activeBaseRegions;
+        }
+    }
+}
diff --git a/src/main/java/io/papermc/paper/oneiric/OneiricPartitionHook.java b/src/main/java/io/papermc/paper/oneiric/OneiricPartitionHook.java
new file mode 100644
index 0000000000000000000000000000000000000000..97ee5a1d37df455d19c3142320031e97ea2528ee
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/OneiricPartitionHook.java
@@ -0,0 +1,128 @@
+package io.papermc.paper.oneiric;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.LongUnaryOperator;
+
+/**
+ * Oneiric - 把 {@link OneiricRegionPartition} 的显式合并表注入 Folia 的 {@code ThreadedRegionizer}。
+ *
+ * <h2>为什么是「注入」而不是「重写」</h2>
+ *
+ * <p>上游的合并/分裂流程（状态机、锁、{@code fromTickOffset} 换算、队列迁移）彼此耦合极深，
+ * 重写其中任何一段都会连带破坏另外三段。所以我们只在<b>两个决策点</b>上加判据：</p>
+ *
+ * <ul>
+ *   <li>{@link #vetoSplit}：在 {@code onRegionRelease} 算出分裂候选之后拦一道 ——
+ *       如果按候选拆开会把某一簇拆散，就<b>否决</b>这次拆分（保持合并）；</li>
+ *   <li>{@link #forceMerge}：在 {@code addChunk} 选定合并宿主之后追加一段 ——
+ *       如果表里说这些 section 属于同一簇，就<b>强制</b>把对方并进来。</li>
+ * </ul>
+ *
+ * <h2>坐标一致性：为什么 section 必须等于基础区</h2>
+ *
+ * <p>本钩子把 <b>section key 直接当作基础区 key</b> 使用。这要求
+ * {@code TickRegions.regionShift == OneiricBaseRegion.SHIFT (3)}，即每个 section
+ * 恰好是 8×8 区块 = 一个基础区。{@link #assertAligned(int)} 在启动时校验这条前提；
+ * 不满足就在状态行明确暴露，绝不静默按错的几何算（那正是「两套几何混用」缺陷的来源）。</p>
+ *
+ * <h2>并发契约</h2>
+ *
+ * <p>两个判定都在 regionizer 的 <b>写锁内</b>被调用，因此它们不得加锁、不得阻塞、
+ * 不得触碰世界状态；只做纯计算。</p>
+ */
+public final class OneiricPartitionHook {
+
+    /** 启动期几何一致性断言的结果，供状态行显示。 */
+    private static volatile boolean aligned = true;
+    private static volatile int observedShift = -1;
+
+    private OneiricPartitionHook() {
+    }
+
+    /**
+     * 校验 section 粒度与基础区一致。**必须在 regionizer 构造之前调用**。
+     *
+     * <p>不一致时只记状态、不抛异常：抛异常会让服务器起不来，而这里的后果是
+     * 「合并表按错的几何生效」—— 出声比崩溃更合适，由 {@code /oneiric} 直接显示 MISALIGNED。</p>
+     */
+    public static void assertAligned(final int regionShift) {
+        observedShift = regionShift;
+        final boolean ok = regionShift == OneiricBaseRegion.SHIFT;
+        if (!ok && aligned) {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                    "[Oneiric] 分区层几何不一致：section shift={} 而基础区 shift={}。"
+                            + "合并表将按 8×8 区块判定，但内核按 {}×{} 区块划分 —— "
+                            + "这会让「表说同区」与「实际同区」不是同一个东西。"
+                            + "请把 section 粒度设为 3（8×8 区块）。",
+                    regionShift, OneiricBaseRegion.SHIFT,
+                    1 << regionShift, 1 << regionShift);
+        }
+        aligned = ok;
+    }
+
+    /** 几何是否已对齐。 */
+
+    /**
+     * 分区层是否生效。**这是总闸**：{@code region-tick} 关掉时，
+     * {@link #forceMerge} 与 {@link #vetoSplit} 全部直接返回 false，等于回到 Folia 原行为。
+     *
+     * <p>为什么要把 {@code region-tick} 接在这里而不是让它只当装饰：
+     * 一个只在名单里、没有任何读取点的开关是**假开关** —— 用户改了它，行为不变，
+     * 而状态行还照着 yml 报 true。本项目的红线是「状态栏必须说真话」。</p>
+     */
+    public static boolean active() {
+        return OneiricConfig.isEnabled(OneiricConfig.REGION_TICK)
+                && OneiricRegionPartition.enabled();
+    }
+
+    /** 状态行片段。 */
+    public static String status() {
+        return "hook=" + (aligned ? "aligned" : "MISALIGNED")
+                + (observedShift >= 0 ? "(shift=" + observedShift + ")" : "");
+    }
+
+    /**
+     * 在 {@code addChunk} 选定合并宿主之后调用：判断「这次新增的 section 是否与宿主之外的 region 同簇」。
+     *
+     * <p>返回 true 表示<b>必须</b>把其它 region 并进宿主（由调用方执行上游的合并原语）。</p>
+     *
+     * @param hostSections  宿主 region 已有的 section key
+     * @param otherSections 待并入 region 的 section key
+     */
+
+    /**
+     * 在 {@code onRegionRelease} 算出分裂候选之后调用：判断按候选拆开是否会拆散某一簇。
+     *
+     * <p><b>拆散 = 否决</b>。这正是「耦合绝不被切开」这条红线的落地点：
+     * 结构上可分，但只要表里说这两半必须同区，就不许拆。</p>
+     *
+     * @param groups 分裂候选：每个元素是一个新 region 的 section 集合
+     * @return true 表示**必须否决**这次拆分（保持合并）
+     */
+    public static boolean vetoSplit(final List<List<Long>> groups) {
+        if (!active() || groups.size() <= 1) {
+            return false;
+        }
+        // 每一簇只能出现在一个 group 里；出现两次即说明会被拆散
+        final Map<Long, Integer> seen = new HashMap<>(groups.size() * 4);
+        for (int i = 0; i < groups.size(); ++i) {
+            for (final Long section : groups.get(i)) {
+                final long cluster = OneiricRegionPartition.find(section);
+                final Integer prev = seen.putIfAbsent(cluster, i);
+                if (prev != null && prev != i) {
+                    OneiricRegionPartition.noteVetoedSplit();
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /** 便于调用方构造：把 section 集合按簇分组，用于诊断输出。 */
+
+    /** 便于内核调用方把「section key」当作「基础区 key」查簇。 */
+}
diff --git a/src/main/java/io/papermc/paper/oneiric/OneiricPurpurCompat.java b/src/main/java/io/papermc/paper/oneiric/OneiricPurpurCompat.java
new file mode 100644
index 0000000000000000000000000000000000000000..826110dfc6875a3b9144834bc6c3d95f35f6fda2
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/OneiricPurpurCompat.java
@@ -0,0 +1,167 @@
+package io.papermc.paper.oneiric;
+
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Oneiric - **Purpur 插件 API 的服务端实现**。
+ *
+ * <h2>为什么需要这一层</h2>
+ *
+ * <p>目标是「一个核心同时跑 Bukkit / Paper / Purpur 三套 API 的插件」。Bukkit 与 Paper 面
+ * 基座已自带；Purpur 面需要在 API 里加接口，<b>并且</b>在服务端给实现 ——
+ * 只加接口不加实现，服务端编译不过；加了实现但抛异常，插件会在运行时炸。</p>
+ *
+ * <h2>三类实现的诚实程度不同，必须分开看</h2>
+ *
+ * <table>
+ *   <caption>哪些是真实现、哪些是明确不支持</caption>
+ *   <tr><th>类别</th><th>方法</th><th>状态</th></tr>
+ *   <tr><td><b>真实现</b></td>
+ *       <td>{@code getServerName} / {@code isLagging} / AFK 三件套 / {@code usesPurpurClient}</td>
+ *       <td>✅ 行为正确</td></tr>
+ *   <tr><td><b>明确不支持</b></td>
+ *       <td>{@code addFuel} / {@code removeFuel} / {@code sendBlockHighlight*} / {@code clearBlockHighlights} / {@code sendDeathScreen}</td>
+ *       <td>⚠️ 抛 {@link UnsupportedOperationException} 并写一条日志</td></tr>
+ * </table>
+ *
+ * <p><b>为什么"明确不支持"比"假装实现"好</b>：假装实现会让插件静默失效（燃料没加进去、高亮没显示），
+ * 运维查不出原因；抛异常至少让调用点立刻暴露，日志里能直接看到是哪个 API。
+ * 这与项目「拒绝而不是延后」的红线一致。</p>
+ *
+ * <p>这些"不支持"项都是 **Purpur 的可选增强 API**，不属于 Bukkit/Paper 契约，
+ * 绝大多数插件不会调用；真正影响兼容性的是 <b>类是否存在</b>（{@code NoClassDefFoundError}），
+ * 而 {@code org.purpurmc.purpur.*} 那 21 个类已经全部就位。</p>
+ */
+public final class OneiricPurpurCompat {
+
+    /** AFK 状态：player UUID → 是否 AFK。用并发 map 因为玩家可能在不同 region 线程上被读写。 */
+    private static final Map<UUID, Boolean> AFK = new ConcurrentHashMap<>();
+
+    /** 服务端名。Purpur 允许配置，这里取 Bukkit 名（可被 oneiric.server-name 覆盖）。 */
+    private static volatile String serverName;
+
+    private OneiricPurpurCompat() {
+    }
+
+    // ================= 真实现 =================
+
+    /** {@code Server#getServerName()}。 */
+    public static String serverName() {
+        final String configured = System.getProperty("oneiric.server-name");
+        if (configured != null && !configured.isBlank()) {
+            return configured.trim();
+        }
+        if (serverName == null) {
+            try {
+                serverName = org.bukkit.Bukkit.getName();
+            } catch (final Throwable ignored) {
+                serverName = "Oneiric";
+            }
+        }
+        return serverName;
+    }
+
+    /**
+     * {@code Server#isLagging()}。
+     *
+     * <p>判据用 **TPS &lt; 19.0**（与 Purpur 的可配置阈值等价，但这里固定，
+     * 避免为一个诊断接口再引入一个开关）。取不到 TPS 时返回 false ——
+     * 诊断接口报错比报"在卡"更糟。</p>
+     */
+    public static boolean isLagging() {
+        try {
+            final double[] tps = org.bukkit.Bukkit.getTPS();
+            return tps != null && tps.length > 0 && tps[0] < 19.0D;
+        } catch (final Throwable ignored) {
+            return false;
+        }
+    }
+
+    /** {@code Player#isAfk()}。 */
+    public static boolean isAfk(final UUID player) {
+        return player != null && Boolean.TRUE.equals(AFK.get(player));
+    }
+
+    /** {@code Player#setAfk(boolean)}。 */
+    public static void setAfk(final UUID player, final boolean afk) {
+        if (player == null) {
+            return;
+        }
+        if (afk) {
+            AFK.put(player, Boolean.TRUE);
+        } else {
+            AFK.remove(player);
+        }
+    }
+
+    /**
+     * 带**事件**的 AFK 切换：{@code Player#setAfk(boolean)} 的真正入口。
+     *
+     * <h2>为什么必须真的 fire 事件</h2>
+     *
+     * <p>只把状态写进 map 是不够的：Purpur 插件依赖 {@code PlayerAFKEvent} 做自建 AFK 系统
+     * （签到、挂机检测、踢人）。如果 21 个 Purpur 类只是"存在但永不触发"，
+     * 那插件加载得起来、注册得上去、**但永远收不到回调** —— 这比缺类更隐蔽。</p>
+     *
+     * @return 事件被取消时返回 false（状态不变，与原版 Purpur 语义一致）
+     */
+    public static boolean setAfkWithEvent(final org.bukkit.entity.Player player, final boolean afk) {
+        if (player == null) {
+            return false;
+        }
+        final org.purpurmc.purpur.event.PlayerAFKEvent event =
+                new org.purpurmc.purpur.event.PlayerAFKEvent(
+                        player, afk, false, null, !org.bukkit.Bukkit.isPrimaryThread());
+        if (!event.callEvent()) {
+            return false; // 被插件取消：不改状态
+        }
+        setAfk(player.getUniqueId(), afk);
+        return true;
+    }
+
+    /** 玩家退出时清掉，避免 UUID 泄漏。由 PlayerQuitEvent 的监听点调用。 */
+    public static void forget(final UUID player) {
+        if (player != null) {
+            AFK.remove(player);
+        }
+    }
+
+    /**
+     * {@code Player#usesPurpurClient()}。
+     *
+     * <p>恒 false：Purpur Client 是一种客户端 mod，通过握手标记自己。
+     * 本核心不实现该握手，返回 false 是**正确**的（就是"没有检测到"），不是缺失。</p>
+     */
+    public static boolean usesPurpurClient() {
+        return false;
+    }
+
+    // ================= 明确不支持 =================
+
+    /**
+     * 统一的"未实现"出口。
+     *
+     * <p>抛 {@link UnsupportedOperationException} 并**只记一次日志**（按 API 名去重），
+     * 避免插件在循环里调用时刷屏。</p>
+     */
+    public static RuntimeException unsupported(final String api) {
+        if (WARNED.add(api)) {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                    "[Oneiric] Purpur API {} 未实现（本核心只保证类存在与契约签名，不实现该增强功能）。"
+                            + "调用它会抛 UnsupportedOperationException —— 这是刻意行为，避免静默失效。",
+                    api);
+        }
+        return new UnsupportedOperationException(
+                "Oneiric: Purpur API " + api + " is not implemented by this core");
+    }
+
+    /** 已告警过的 API 名（每个只告警一次）。 */
+    private static final java.util.Set<String> WARNED = ConcurrentHashMap.newKeySet();
+
+    /** 状态行片段。 */
+    public static String status() {
+        return "purpur-api=on(afk=" + AFK.size() + ")";
+    }
+}
diff --git a/src/main/java/io/papermc/paper/oneiric/OneiricRegionPartition.java b/src/main/java/io/papermc/paper/oneiric/OneiricRegionPartition.java
new file mode 100644
index 0000000000000000000000000000000000000000..d3cb2d33a506452a5a3d0933227e358027218d92
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/OneiricRegionPartition.java
@@ -0,0 +1,208 @@
+package io.papermc.paper.oneiric;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.LongAdder;
+
+/**
+ * Oneiric - **显式合并表**：本方案与 Folia 的唯一实质差异。
+ *
+ * <h2>为什么需要它</h2>
+ *
+ * <p>Folia 的空节不变式只覆盖**邻接**：两个活跃 section 之间没有空节，就必须合并。
+ * 它覆盖不了**距离** —— 一台跨 3 个基础区的红石机器，中间可能恰好有一个未加载的
+ * 基础区（空节还在），于是 Folia 会把两侧判成两个独立区，**并行 tick**。
+ * 结果是那台机器在同一个 tick 里被两个线程各 tick 一半 —— 生电行为直接错。</p>
+ *
+ * <p>本表回答的是邻接之外的那一维：<b>这两个基础区之间有没有长程耦合？</b>
+ * 有，就记成「必须同区」，由 regionizer 的合并/分裂路径强制生效。</p>
+ *
+ * <h2>与固定基础区的分工</h2>
+ *
+ * <table>
+ *   <caption>两级结构：只有第二级会变</caption>
+ *   <tr><th>级别</th><th>由什么决定</th><th>会不会变</th></tr>
+ *   <tr><td>基础区</td><td>纯坐标函数（{@link OneiricBaseRegion}）</td><td><b>永不改变</b></td></tr>
+ *   <tr><td>调度单元（簇）</td><td><b>本表的并查集</b></td><td>会合并、会拆分</td></tr>
+ * </table>
+ *
+ * <h2>为什么要「可审计、可复现」</h2>
+ *
+ * <p>Folia 的单元成员是算出来的活对象图，tick 中途可能正在变；本表的成员是**显式状态**，
+ * 任何时刻都能给出确定答案，而且能在 {@code /oneiric} 里列出来、能解释「为什么这两个区块被并行 tick」。</p>
+ *
+ * <h2>并发契约</h2>
+ *
+ * <p>并查集的读（{@link #find}）会被 tick 热路径调用，因此父指针表是 {@link ConcurrentHashMap}，
+ * 读路径<b>永远无锁</b>；合并走 {@code synchronized} 的低频写路径。</p>
+ */
+public final class OneiricRegionPartition {
+
+    /** 开关名：{@code oneiric.region-partition}。默认 <b>true</b>（本方案的核心）。 */
+    public static final String SWITCH = "region-partition";
+
+    /** 并查集：基础区 key → 父 key。只有「必须同区」的边才会写入。 */
+    private static final ConcurrentHashMap<Long, Long> PARENT = new ConcurrentHashMap<>();
+
+    /** 每条合并边的理由，供 {@code /oneiric} 输出「为什么合并」。 */
+    private static final ConcurrentHashMap<Long, String> REASON = new ConcurrentHashMap<>();
+
+    /** 合并 / 拆分 / 被耦合否决的拆分 / 主动强制合并 计数。并行度损失的可见化入口。 */
+    private static final LongAdder MERGES = new LongAdder();
+    private static final LongAdder SPLITS = new LongAdder();
+    private static final LongAdder VETOED_SPLITS = new LongAdder();
+    private static final LongAdder FORCED_MERGES = new LongAdder();
+
+    private OneiricRegionPartition() {
+    }
+
+    /** 开关是否打开。默认开：没有它，跨距离耦合就是静默破序。 */
+    public static boolean enabled() {
+        return OneiricConfig.isEnabled(SWITCH);
+    }
+
+    /**
+     * 查找基础区所在簇的代表元。**读路径无锁**。
+     *
+     * <p>没有登记过的基础区返回自身 —— 即「自成一个簇」。
+     * 这正是「没有合并时每个基础区自成一区」的显式表达。</p>
+     */
+    public static long find(final long baseRegion) {
+        long cur = baseRegion;
+        // 深度上限防御：正常情况下只会被 union 成树；上限只为防将来写坏 PARENT 造成死循环
+        // （宁可返回当前值，也绝不挂死 tick 线程）。
+        for (int guard = 0; guard < 64; ++guard) {
+            final Long parent = PARENT.get(cur);
+            if (parent == null || parent == cur) {
+                return cur;
+            }
+            cur = parent;
+        }
+        return cur;
+    }
+
+    /** 两个基础区是否被判定为「必须同区」。 */
+
+    /** chunk 坐标直接问「和哪个簇」。 */
+
+    /**
+     * 登记一条「必须同区」的边。低频路径，可以 {@code synchronized}。
+     *
+     * <p>已同簇时不重复计数、不覆盖已有理由（<b>先到的理由更接近根因</b>）。</p>
+     */
+    public static synchronized long union(final long a, final long b, final String reason) {
+        final long ra = find(a);
+        final long rb = find(b);
+        if (ra == rb) {
+            return ra;
+        }
+        // 以较小 key 为代表元：输出稳定、可复现，与插入顺序无关。
+        final long keep;
+        final long drop;
+        if (Long.compareUnsigned(ra, rb) <= 0) {
+            keep = ra;
+            drop = rb;
+        } else {
+            keep = rb;
+            drop = ra;
+        }
+        PARENT.put(drop, keep);
+        REASON.putIfAbsent(keep, reason == null ? "unspecified" : reason);
+        MERGES.increment();
+        return keep;
+    }
+
+    /** 该簇为什么会合并。仅供诊断输出。 */
+    public static String reasonOf(final long baseRegion) {
+        return REASON.getOrDefault(find(baseRegion), "");
+    }
+
+    /** 当前登记的簇：代表元 → 成员基础区列表。用于 {@code /oneiric} 与持久化。 */
+    public static Map<Long, List<Long>> clusters() {
+        final Map<Long, List<Long>> out = new ConcurrentHashMap<>();
+        for (final Map.Entry<Long, Long> e : PARENT.entrySet()) {
+            final long root = find(e.getKey());
+            out.computeIfAbsent(root, k -> new ArrayList<>()).add(e.getKey());
+        }
+        // 代表元自己也要出现在成员表里（PARENT 里可能没有它自己的条目）
+        for (final Long root : new ArrayList<>(out.keySet())) {
+            final List<Long> members = out.get(root);
+            if (!members.contains(root)) {
+                members.add(root);
+            }
+        }
+        return out;
+    }
+
+    /** 被登记的合并边总数。 */
+    public static long mergeCount() {
+        return MERGES.sum();
+    }
+
+    /** 显式拆分次数。 */
+    public static long splitCount() {
+        return SPLITS.sum();
+    }
+
+    /**
+     * **被耦合否决的拆分次数** —— 这是「并行度损失」里**正常**的那一半。
+     *
+     * <p>它和「因粘性保持」必须分开报：前者说明边界上真的还有耦合（合并是**正确**的），
+     * 后者说明只是历史原因没拆（合并是**损失**）。混成一个数，运维无法判断该不该介入。</p>
+     */
+    public static long vetoedSplitCount() {
+        return VETOED_SPLITS.sum();
+    }
+
+    /** 记一次「本可以拆，但因为表里说必须同区而不拆」。 */
+    public static void noteVetoedSplit() {
+        VETOED_SPLITS.increment();
+    }
+
+    /** 记一次真正的拆分。 */
+
+    /**
+     * 记一次**主动强制合并**（regionizer 在 tick 边界把同簇的已分离区并起来）。
+     *
+     * <p>与 {@link #union} 的区别：{@code union} 登记的是「未来要同区」的意图（并查集边），
+     * 本方法是那次意图**真的落地**了一个 region —— 两者数量不一致是正常现象，
+     * 差额就是「登记了但还没走到合并时机」的边。</p>
+     */
+    public static void noteForcedMerge(final int count) {
+        if (count > 0) {
+            FORCED_MERGES.add(count);
+        }
+    }
+
+    /** 主动强制合并掉的 region 总数。 */
+    public static long forcedMergeCount() {
+        return FORCED_MERGES.sum();
+    }
+
+    /** 清空（仅测试与关服用）。 */
+    public static synchronized void clear() {
+        PARENT.clear();
+        REASON.clear();
+        MERGES.reset();
+        SPLITS.reset();
+        VETOED_SPLITS.reset();
+        FORCED_MERGES.reset();
+    }
+
+    /** 状态行片段。 */
+    public static String status() {
+        return "partition=" + (enabled() ? "on" : "off")
+                + " edges=" + PARENT.size()
+                + " merges=" + mergeCount()
+                + " forcedMerges=" + forcedMergeCount()
+                + " splits=" + splitCount()
+                + " vetoedSplits=" + vetoedSplitCount();
+    }
+
+    /** 已登记的合并边数量（用于并行度损失计算）。 */
+
+    /** 只读快照，供持久化使用。 */
+}
diff --git a/src/main/java/io/papermc/paper/oneiric/OneiricStatus.java b/src/main/java/io/papermc/paper/oneiric/OneiricStatus.java
new file mode 100644
index 0000000000000000000000000000000000000000..090b8e066c28956d8b90b40a3bbb9162b4bb581b
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/OneiricStatus.java
@@ -0,0 +1,160 @@
+package io.papermc.paper.oneiric;
+
+import io.papermc.paper.threadedregions.TickRegionScheduler;
+import io.papermc.paper.threadedregions.TickRegions;
+import io.papermc.paper.threadedregions.ThreadedRegionizer;
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+
+/**
+ * Oneiric - 状态汇总：**所有并行相关数字的唯一出口**。
+ *
+ * <h2>为什么必须把「损失」和「不是损失」分开报</h2>
+ *
+ * <p>这套设计里最容易被误解的一件事：合并次数多，<b>不等于</b>实现有问题。
+ * 边界上真有耦合时合并是<b>正确</b>的；只有「边界已无耦合、只是历史原因没拆」才是损失。
+ * 混成一个数字，运维会去优化一件本来就不该优化的事，或者反过来漏掉真正的损失。</p>
+ *
+ * <h2>{@code /oneiric} 必须能报出的七项</h2>
+ *
+ * <ol>
+ *   <li>{@code 区数} —— 当前实际存在的调度单元数；</li>
+ *   <li>{@code 并行区数} —— 本 tick 处于 TICKING 的单元数；</li>
+ *   <li>{@code 每区 mspt} —— 由内核 profiler 提供（缺省时不编造）；</li>
+ *   <li>{@code 掉队区数} —— 落后 ≥1 个周期的单元数；</li>
+ *   <li>{@code 合并次数}；</li>
+ *   <li>{@code 因粘性保持}（损失）；</li>
+ *   <li>{@code 因耦合否决}（不是损失）。</li>
+ * </ol>
+ */
+public final class OneiricStatus {
+
+    private OneiricStatus() {
+    }
+
+    /**
+     * 一行式状态。**永远返回非 null**，且**不抛异常** ——
+     * 状态命令本身绝不能把服务器搞崩。
+     */
+    public static String line() {
+        final StringBuilder sb = new StringBuilder(512);
+        sb.append("[Oneiric] ").append(OneiricBaseRegion.status())
+          .append(" | ").append(OneiricPartitionHook.status())
+          .append(" | ").append(OneiricRegionPartition.status())
+          .append(" | ").append(OneiricLongRangeCoupling.status());
+
+        final Snapshot s = snapshot();
+        sb.append(" | ").append(s.describe());
+        sb.append(" | switches: ").append(OneiricConfig.status());
+        return sb.toString();
+    }
+
+    /** 采集一次快照。任何一个环节取不到数就**跳过**，绝不编造。 */
+    public static Snapshot snapshot() {
+        int regions = 0;
+        int ticking = 0;
+        int lagging = 0;
+        final List<String> perRegion = new ArrayList<>();
+
+        try {
+            final MinecraftServer server = MinecraftServer.getServer();
+            if (server != null) {
+                for (final ServerLevel level : server.getAllLevels()) {
+                    final ThreadedRegionizer< ? , ? > regioniser = level.regioniser;
+                    if (regioniser == null) {
+                        continue;
+                    }
+                    final int[] counts = countRegions(regioniser);
+                    regions += counts[0];
+                    ticking += counts[1];
+                    lagging += counts[2];
+                }
+            }
+        } catch (final Throwable ignored) {
+            // 状态采集失败不能影响服务器：宁可少报，不可崩服。
+        }
+
+        int activeBaseRegions = 0;
+        try {
+            activeBaseRegions = Math.max(1, regions);
+        } catch (final Throwable ignored) {
+            // 同上
+        }
+
+        return new Snapshot(
+                regions,
+                ticking,
+                lagging,
+                activeBaseRegions,
+                TickRegions.getRegionChunkShift(),
+                ThreadCounts.of(),
+                perRegion
+        );
+    }
+
+    /**
+     * 统计单个世界 regionizer 的 区数 / TICKING 数。
+     *
+     * <p>{@code state} 是 {@code ThreadedRegion} 的公开字段，取值与内核常量一一对应：
+     * {@code 0=TRANSIENT / 1=READY / 2=TICKING / 3=DEAD}。这里用数值比较而不用常量名，
+     * 因为那几个常量是 {@code private}，且内核不打算公开它们。</p>
+     *
+     * <p><b>必须用加锁版本</b>{@code computeForAllRegions}，不能用 {@code ...Unsynchronised}：
+     * 后者明确要求"调用者已持有锁"，而状态命令是从**任意线程**（控制台/插件）发起的，
+     * 用一个未加锁的遍历去读正在被合并/分裂的 {@code regionsById} 会直接崩服。
+     * 读锁的代价在这里完全可以接受 —— 状态命令是低频操作。</p>
+     *
+     * <p>掉队数暂不采集：调度起点（{@code tickSchedule}）未通过任何公开 API 暴露，
+     * 与其编造一个读数，不如不报。</p>
+     */
+    private static int[] countRegions(final ThreadedRegionizer< ? , ? > regioniser) {
+        final int[] out = new int[3];
+        try {
+            regioniser.computeForAllRegions(region -> {
+                out[0]++;
+                if (region.state == 2) { // STATE_TICKING
+                    out[1]++;
+                }
+            });
+        } catch (final Throwable ignored) {
+            // 读不到就返回已统计到的部分
+        }
+        return out;
+    }
+
+    /** 线程数快照。 */
+    public record ThreadCounts(int tickThreads) {
+        static ThreadCounts of() {
+            try {
+                final TickRegionScheduler scheduler = TickRegions.getScheduler();
+                return new ThreadCounts(scheduler == null ? 0 : scheduler.getTotalThreadCount());
+            } catch (final Throwable ignored) {
+                return new ThreadCounts(0);
+            }
+        }
+    }
+
+    /** 一次状态快照。字段名即报告口径。 */
+    public record Snapshot(
+            int regions,
+            int tickingRegions,
+            int laggingRegions,
+            int activeBaseRegions,
+            int sectionShift,
+            ThreadCounts threads,
+            List<String> perRegionMspt
+    ) {
+        public String describe() {
+            final StringBuilder sb = new StringBuilder(256);
+            sb.append("regions=").append(regions)
+              .append(" ticking=").append(tickingRegions)
+              .append(" lagging=").append(laggingRegions)
+              .append(" tickThreads=").append(threads.tickThreads())
+              .append(" sectionShift=").append(sectionShift);
+            sb.append(" | ").append(OneiricParallelismReport.status(activeBaseRegions));
+            return sb.toString();
+        }
+    }
+}
diff --git a/src/main/java/io/papermc/paper/oneiric/OneiricTechnicalMode.java b/src/main/java/io/papermc/paper/oneiric/OneiricTechnicalMode.java
new file mode 100644
index 0000000000000000000000000000000000000000..01e0834138ee8d0dc6fd11df112240d946d2851f
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/OneiricTechnicalMode.java
@@ -0,0 +1,114 @@
+package io.papermc.paper.oneiric;
+
+import io.papermc.paper.configuration.GlobalConfiguration;
+
+import java.util.Map;
+
+/**
+ * Oneiric - **技术模式（mc-technical-mode）**：把 Paper 关掉的原版机制恢复回来。
+ *
+ * <h2>为什么需要它</h2>
+ *
+ * <p>Paper 出于"安全"默认关掉了一批原版机制，而生电服几乎全都依赖它们：</p>
+ *
+ * <table border="1">
+ *   <caption>Paper 默认关闭、生电必需的项</caption>
+ *   <tr><th>配置项</th><th>Paper 默认</th><th>关掉的后果</th></tr>
+ *   <tr><td>{@code allowPistonDuplication}</td><td>false</td><td><b>所有复制机失效</b>（TNT/地毯/矿车/轨道）</td></tr>
+ *   <tr><td>{@code allowHeadlessPistons}</td><td>false</td><td>无头活塞装置失效</td></tr>
+ *   <tr><td>{@code allowPermanentBlockBreakExploits}</td><td>false</td><td>永破类装置失效（床炸等）</td></tr>
+ *   <tr><td>{@code allowTripwireDisarmingExploits}</td><td>false</td><td><b>绊线复制失效</b>（剪断的绊线不消失）</td></tr>
+ *   <tr><td>{@code allowUnsafeEndPortalTeleportation}</td><td>false</td><td>末地门传送受限、沙砾复制失效</td></tr>
+ * </table>
+ *
+ * <p>另外三项不是"原版机制"，但技术服需要它们不被限制：
+ * 数据包限速、书里解析选择器、空计分板队伍保存。</p>
+ *
+ * <h2>为什么用「运行期覆写」而不是「改字段默认值」</h2>
+ *
+ * <p><b>改默认值只能影响"配置文件里没写这一项"的情况。</b>老服务器上
+ * {@code config/paper-global.yml} 早已被 Paper 自己写入了 {@code false}，
+ * 显式值优先于字段默认值 —— 所以只改默认值对存量服完全无效。</p>
+ *
+ * <p>运行期覆写不受此限：配置加载完成后再把它们改成 true，无论文件里写了什么。</p>
+ *
+ * <h2>调用时机（这是踩过的坑）</h2>
+ *
+ * <p>本类必须在**两条**路径上都被调用：</p>
+ * <ol>
+ *   <li><b>开服</b>：{@code DedicatedServer} 里 Paper 配置就绪后</li>
+ *   <li><b>/reload</b>：{@code PaperConfigurations#reload}</li>
+ * </ol>
+ *
+ * <p>早期实现只接了第 2 条，导致<b>开服时这五项一直是 false，只有 reload 过才生效</b>。
+ * 那种"改了配置不生效、reload 一下突然好了"的表现极难排查。</p>
+ *
+ * <h2>来源</h2>
+ *
+ * <p>照搬自老 Oneiric 树的 {@code org.leavesmc.leaves.util.McTechnicalModeHelper}
+ * （Leaves 的 mc technical survival mode 实现）。绊线复制那一行是
+ * Oneiric 补上的 —— Leaves 原版漏了它，导致绊线复制在技术模式下仍不工作。</p>
+ */
+public final class OneiricTechnicalMode {
+
+    /** 开关名，与 oneiric.yml 一致。 */
+    public static final String SWITCH = "mc-technical-mode";
+
+    private OneiricTechnicalMode() {
+    }
+
+    /** 若开关打开则执行覆写。这是两个调用点都该用的入口。 */
+    public static void applyIfEnabled() {
+        if (OneiricConfig.isEnabled(SWITCH)) {
+            apply();
+        } else {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                    "[Oneiric] mc-technical-mode=关：TNT复制/无头活塞/永破/绊线复制/末地门不安全传送"
+                            + " 保持 Paper 默认（false）。生电装置会失效。");
+        }
+    }
+
+    /**
+     * 无条件覆写。仅供 {@link #applyIfEnabled()} 内部使用，
+     * 以及测试/诊断路径直接调用。
+     */
+    public static void apply() {
+        final GlobalConfiguration.UnsupportedSettings unsupported =
+                GlobalConfiguration.get().unsupportedSettings;
+
+        final boolean pistonDupWas = unsupported.allowPistonDuplication;
+        final boolean headlessWas = unsupported.allowHeadlessPistons;
+        final boolean permanentBreakWas = unsupported.allowPermanentBlockBreakExploits;
+        final boolean tripwireWas = unsupported.allowTripwireDisarmingExploits;
+        final boolean endPortalWas = unsupported.allowUnsafeEndPortalTeleportation;
+
+        unsupported.allowPistonDuplication = true;
+        unsupported.allowHeadlessPistons = true;
+        unsupported.allowPermanentBlockBreakExploits = true;
+        // Oneiric - 这一行是 Leaves 原版漏掉的：没有它，绊线复制在技术模式下仍然失效。
+        unsupported.allowTripwireDisarmingExploits = true;
+        unsupported.allowUnsafeEndPortalTeleportation = true;
+
+        // 技术服不应该被数据包限速误伤：把全局限额放宽到 5000/s 并清空逐玩家覆盖。
+        final GlobalConfiguration.PacketLimiter.PacketLimit allPackets =
+                GlobalConfiguration.get().packetLimiter.allPackets;
+        GlobalConfiguration.get().packetLimiter.allPackets =
+                new GlobalConfiguration.PacketLimiter.PacketLimit(allPackets.interval(), 5000.0D, allPackets.action());
+        GlobalConfiguration.get().packetLimiter.overrides = Map.of();
+
+        // 书里的选择器要能解析（地图画/告示牌类装置依赖）。
+        GlobalConfiguration.get().itemValidation.resolveSelectorsInBooks = true;
+
+        // 空的计分板队伍要能保存（技术服的记分板时序装置依赖）。
+        GlobalConfiguration.get().scoreboards.saveEmptyScoreboardTeams = true;
+
+        // 只在真的改动了值的时候打印，避免每次 reload 都刷一行没有信息量的日志。
+        if (!pistonDupWas || !headlessWas || !permanentBreakWas || !tripwireWas || !endPortalWas) {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").info(
+                    "[Oneiric] 生电开关（mc-technical-mode=开）：TNT复制={} 无头活塞={} 永破={} 绊线复制={} 末地门不安全传送={}",
+                    unsupported.allowPistonDuplication, unsupported.allowHeadlessPistons,
+                    unsupported.allowPermanentBlockBreakExploits, unsupported.allowTripwireDisarmingExploits,
+                    unsupported.allowUnsafeEndPortalTeleportation);
+        }
+    }
+}
diff --git a/src/main/java/io/papermc/paper/oneiric/OneiricTeleportCompat.java b/src/main/java/io/papermc/paper/oneiric/OneiricTeleportCompat.java
new file mode 100644
index 0000000000000000000000000000000000000000..f460c4b4158297d8f677d3e96ed868bf01c4453c
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/OneiricTeleportCompat.java
@@ -0,0 +1,67 @@
+package io.papermc.paper.oneiric;
+
+import org.bukkit.Bukkit;
+import org.bukkit.Location;
+import org.bukkit.World;
+import org.bukkit.entity.Entity;
+
+/**
+ * Oneiric - **同步 {@code teleport()} 的兼容层**。
+ *
+ * <h2>为什么要这样做，而不是"假装同步"</h2>
+ *
+ * <p>Folia 在 {@code CraftEntity#teleport0} 开头直接抛 {@code UnsupportedOperationException}，
+ * 于是所有依赖同步传送的老插件全部炸掉。常见"补救"是偷偷转 {@code teleportAsync} 再返回 true ——
+ * 那是在撒谎：方法返回时传送还没发生，调用方紧接着的代码会在旧位置执行。</p>
+ *
+ * <p>本类的做法来自 LuminolAddon 的实测结论：<b>Folia 自己的 {@code teleportAsync} 里本来就有
+ * 一条 same-region 快路径是同步执行完的</b> —— 目标同世界、实体与目标周边都归当前 region、
+ * 目标区块已加载时，{@code teleportAsync} 返回时传送**已经发生**。
+ * 在那些条件下走它，同步语义 100% 成立，不需要撒任何谎。</p>
+ *
+ * <h2>条件不成立时</h2>
+ *
+ * <p>跨区 / 跨世界 / 区块未加载时，同步语义在分区线程模型下**无法满足**：
+ * 跨区移动必须由目标区的线程执行，同步等待就是死锁配方。
+ * 这时**返回 false、传送不发生** —— 与 v6 §十四「拒绝而不是延后」一致：
+ * 宁可让调用方知道失败，也不给它一个假的成功。</p>
+ *
+ * <h2>为什么条件取 1 区块半径而不是单点</h2>
+ *
+ * <p>与 Folia 内部 {@code // check for same region} 的判断对齐：单点判断会放过
+ * "目标点在边界上、落地后立刻跨界"的情形。这个细节照抄 LuminolAddon，不要"优化"。</p>
+ */
+public final class OneiricTeleportCompat {
+
+    private OneiricTeleportCompat() {
+    }
+
+    /**
+     * 这次同步传送能否**真正同步完成**。
+     *
+     * @return true 表示调用 {@code teleportAsync} 后返回时传送已完成，同步语义成立
+     */
+    public static boolean canCompleteSynchronously(final Entity entity, final Location to) {
+        if (entity == null || to == null) {
+            return false;
+        }
+        final World world = to.getWorld();
+        if (world == null || !world.equals(entity.getWorld())) {
+            return false; // 跨世界必然异步（Folia 要求 destination == this.level()）
+        }
+        // 连当前实体都不归本线程管，谈不上同步
+        if (!Bukkit.isOwnedByCurrentRegion(entity)) {
+            return false;
+        }
+        // 目标点周边 1 区块都必须归本线程（与 Folia 内部判断对齐）
+        if (!Bukkit.isOwnedByCurrentRegion(to, 1)) {
+            return false;
+        }
+        return world.isChunkLoaded(to.getBlockX() >> 4, to.getBlockZ() >> 4);
+    }
+
+    /** 状态行片段。 */
+    public static String status() {
+        return "sync-teleport=" + (OneiricConfig.isEnabled("compat-sync-teleport") ? "on" : "off");
+    }
+}
diff --git a/src/main/java/io/papermc/paper/oneiric/OneiricThreadSizing.java b/src/main/java/io/papermc/paper/oneiric/OneiricThreadSizing.java
new file mode 100644
index 0000000000000000000000000000000000000000..0c41be8e110313faac51ddbe9e6129757cdb3fc0
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/OneiricThreadSizing.java
