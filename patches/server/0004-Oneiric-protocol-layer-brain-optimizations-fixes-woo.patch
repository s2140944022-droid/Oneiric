+        }
+    }
+
+    /**
+     * **缺键补写**：把新版本新增、而旧 yml 里没有的开关追加进去。
+     *
+     * <p>为什么需要它：{@code writeIfMissing} 原来的行为是「文件存在就跳过」。
+     * 于是老配置文件遇到新版本时，新开关永远不在 yml 里 —— 运维既看不到也改不了，
+     * 而代码里它们走 {@code DEFAULT_ON} 生效，形成「配置看不见但行为已变」的黑箱。</p>
+     *
+     * <p>只追加缺失的键与注释，<b>不改动用户已有值、不重排已有条目</b>。
+     * 这是刻意的：配置文件是运维的资产，程序不该顺手重写它们。</p>
+     */
+    private static void appendMissingSwitch(final Path file) {
+        try {
+            final String existing = Files.readString(file, StandardCharsets.UTF_8);
+            final StringBuilder add = new StringBuilder(512);
+            int appended = 0;
+            for (final String name : OneiricConfig.NAMES) {
+                // 已有同名键（行首缩进 + name + 冒号）就跳过。用行首锚定避免误匹配值里出现的同名子串。
+                // 必须用 MULTILINE：原来的 ".*^" 只有单行模式，^ 只匹配整个文件开头，
+                // 导致除第一行外的所有键都被判为"缺失"，每次启动都重复追加一遍。
+                if (java.util.regex.Pattern.compile("^\\s*" + java.util.regex.Pattern.quote(name) + ":",
+                        java.util.regex.Pattern.MULTILINE).matcher(existing).find()) {
+                    continue;
+                }
+                final boolean value = OneiricConfig.effectiveDefault(name);
+                add.append('\n');
+                block(add, name, value, "（新版本新增）" + name,
+                        "本项由新版本加入，你原来的配置文件里没有它。",
+                        "取内置默认值 " + value + "。",
+                        "需要改变行为时直接改这一行，然后重启。");
+                appended++;
+            }
+            if (appended == 0) {
+                return;
+            }
+            Files.writeString(file, existing + add, StandardCharsets.UTF_8,
+                    java.nio.file.StandardOpenOption.APPEND);
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").info(
+                    "[Oneiric] {} 补写了 {} 个新版本开关（原有值未改动）", FILE, appended);
+        } catch (final IOException e) {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                    "[Oneiric] 补写 {} 失败: {}", FILE, e.toString());
+        }
+    }
+
+    /** 按既有排版写一个开关：段标题 + 三行说明 + 键值行。 */
+    private static void block(final StringBuilder sb, final String name, final boolean value,
+                              final String title, final String what, final String why, final String when) {
+        sb.append("  # ").append(title).append('\n');
+        sb.append("  # 【做什么】").append(what).append('\n');
+        sb.append("  # 【为什么默认").append(value ? "开" : "关").append("】").append(why).append('\n');
+        sb.append("  # 【什么时候该改】").append(when).append('\n');
+        sb.append("  ").append(name).append(": ").append(value).append('\n');
+        // Oneiric - 自检：block() 里写死的默认值必须与 OneiricConfig.effectiveDefault() 一致。
+        // 两处不同步会让「yml 写的默认值」和「实际生效值」出现分歧 —— 运维最难查的一类问题。
+        //
+        // 只在**没有被显式覆盖**时比较：命令行 -Doneiric.<name>=... 或已存在的 yml 值
+        // 本来就有权与内置默认值不同。把它们也算进来会让每次用 -D 覆盖都刷一条假告警，
+        // 反而掩盖真正的不一致。
+        if (System.getProperty("oneiric." + name) == null && value != OneiricConfig.effectiveDefault(name)) {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                    "[Oneiric] 开关 {} 的 yml 默认值({}) 与生效默认值({}) 不一致，请检查 OneiricYml.block() 调用",
+                    name, value, OneiricConfig.effectiveDefault(name));
+        }
+    }
+
+    /** yml 实际生效了几个开关。 */
+
+    /** 状态行片段。 */
+    public static String status() {
+        return "yml=" + (loadedSwitches > 0 ? loadedSwitches + "switches" : "defaults")
+                + (unknownKeys.isEmpty() ? "" : " unknown=[" + unknownKeys + "]");
+    }
+}
diff --git a/src/main/java/io/papermc/paper/oneiric/brain/ActivityBitSet.java b/src/main/java/io/papermc/paper/oneiric/brain/ActivityBitSet.java
new file mode 100644
index 0000000000000000000000000000000000000000..1073ba5aae580140a1fca765c8b7f64b3364f16c
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/brain/ActivityBitSet.java
@@ -0,0 +1,168 @@
+package io.papermc.paper.oneiric.brain;
+
+import it.unimi.dsi.fastutil.objects.AbstractObjectSet;
+import it.unimi.dsi.fastutil.objects.ObjectIterator;
+import java.util.NoSuchElementException;
+import java.util.Set;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.world.entity.schedule.Activity;
+
+/**
+ * Oneiric - 活动集合的位集实现。
+ *
+ * <p>移植自 CanvasMC/Canvas（GPLv3）的 {@code io.canvasmc.canvas.util.map.ActivityBitSet}。
+ * 原版用 {@code HashSet} 存 activeActivities，每次 {@code contains} 都要哈希 + equals；
+ * 这里改成 {@code 1 << id} 位运算，并把「集合是否变化」暴露成 dirty 标记，
+ * 让上层可以缓存派生数组（见 {@code Brain.startEachNonRunningBehavior}）。</p>
+ *
+ * <p><b>与 Canvas 的差异</b>：Canvas 的 MC 26.x 里 {@link Activity} 带 {@code public int id} 字段；
+ * 1.21.1 的 {@link Activity} 只是 registry 包装，没有该字段。这里改为
+ * {@link BuiltInRegistries#ACTIVITY} 的 id 查表，并在类初始化时一次性建好 id 数组，
+ * 避免每次 {@code contains} 都走 registry 查找。</p>
+ */
+public final class ActivityBitSet extends AbstractObjectSet<Activity> {
+
+    /** 活动总数（registry 大小）。 */
+    public static final int ACTIVITY_SIZE = BuiltInRegistries.ACTIVITY.size();
+
+    /** id -> Activity 与 Activity -> id 的双向表，只读，类加载时建立。 */
+    private static final Activity[] BY_ID = new Activity[ACTIVITY_SIZE];
+    private static final int[] ID_BY_ORDINAL = new int[ACTIVITY_SIZE];
+
+    static {
+        int i = 0;
+        for (final Activity activity : BuiltInRegistries.ACTIVITY) {
+            BY_ID[i] = activity;
+            ID_BY_ORDINAL[i] = BuiltInRegistries.ACTIVITY.getId(activity);
+            i++;
+        }
+    }
+
+    private int bitset = 0;
+    private boolean dirty = true;
+
+    /** 活动在 registry 中的 id；未知活动返回 -1。 */
+    private static int idOf(final Object o) {
+        if (!(o instanceof Activity activity)) {
+            return -1;
+        }
+        final int registryId = BuiltInRegistries.ACTIVITY.getId(activity);
+        return (registryId < 0 || registryId >= ACTIVITY_SIZE) ? -1 : registryId;
+    }
+
+    /**
+     * 读取并清除 dirty 标记。
+     *
+     * @return 自上次读取以来集合是否发生过变化
+     */
+    public boolean unsetDirty() {
+        if (this.dirty) {
+            this.dirty = false;
+            return true;
+        }
+        return false;
+    }
+
+    public int bitSet() {
+        return this.bitset;
+    }
+
+    @Override
+    public boolean add(final Activity activity) {
+        final int id = idOf(activity);
+        if (id < 0) {
+            return false;
+        }
+        final int mask = 1 << id;
+        if ((this.bitset & mask) != 0) {
+            return false;
+        }
+        this.bitset |= mask;
+        this.dirty = true;
+        return true;
+    }
+
+    @Override
+    public boolean remove(final Object o) {
+        final int id = idOf(o);
+        if (id < 0) {
+            return false;
+        }
+        final int mask = 1 << id;
+        if ((this.bitset & mask) != 0) {
+            this.bitset &= ~mask;
+            this.dirty = true;
+            return true;
+        }
+        return false;
+    }
+
+    @Override
+    public boolean contains(final Object o) {
+        final int id = idOf(o);
+        return id >= 0 && (this.bitset & (1 << id)) != 0;
+    }
+
+    @Override
+    public ObjectIterator<Activity> iterator() {
+        return new ObjectIterator<>() {
+            private int index = 0;
+
+            {
+                while (this.index < ACTIVITY_SIZE && (ActivityBitSet.this.bitset & (1 << this.index)) == 0) {
+                    this.index++;
+                }
+            }
+
+            @Override
+            public boolean hasNext() {
+                return this.index < ACTIVITY_SIZE;
+            }
+
+            @Override
+            public Activity next() {
+                if (!this.hasNext()) {
+                    throw new NoSuchElementException();
+                }
+                final Activity activity = BY_ID[this.index++];
+                while (this.index < ACTIVITY_SIZE && (ActivityBitSet.this.bitset & (1 << this.index)) == 0) {
+                    this.index++;
+                }
+                return activity;
+            }
+        };
+    }
+
+    @Override
+    public int size() {
+        return Integer.bitCount(this.bitset);
+    }
+
+    @Override
+    public void clear() {
+        this.bitset = 0;
+        this.dirty = true;
+    }
+
+    @Override
+    public boolean equals(final Object o) {
+        if (o == this) {
+            return true;
+        }
+        if (!(o instanceof Set<?> s)) {
+            return false;
+        }
+        return s.size() == this.size() && this.containsAll(s);
+    }
+
+    @Override
+    public int hashCode() {
+        int hash = 0;
+        for (int i = 0; i < ACTIVITY_SIZE; i++) {
+            if ((this.bitset & (1 << i)) != 0) {
+                hash += BY_ID[i].hashCode();
+            }
+        }
+        return hash;
+    }
+}
