new file mode 100644
index 0000000000000000000000000000000000000000..ab123f0f1635d1cad33885ac49d19dbcd8a923b6
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/brain/BehaviorControlArraySet.java
@@ -0,0 +1,183 @@
+package io.papermc.paper.oneiric.brain;
+
+import it.unimi.dsi.fastutil.objects.AbstractObjectSet;
+import it.unimi.dsi.fastutil.objects.ObjectIterator;
+import java.util.NoSuchElementException;
+import java.util.Objects;
+import java.util.function.Consumer;
+import javax.annotation.Nullable;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.ai.behavior.BehaviorControl;
+
+/**
+ * Oneiric - 行为集合的数组实现。
+ *
+ * <p>移植自 CanvasMC/Canvas（GPLv3）的 {@code io.canvasmc.canvas.util.map.BehaviorControlArraySet}。</p>
+ *
+ * <p><b>为什么需要它</b>：原版 {@code availableBehaviorsByPriority} 的内层是 {@code LinkedHashSet}，
+ * 每 tick 遍历都要走迭代器、每次访问都要装箱。这个实现用数组 + 下标遍历，
+ * 并提供 {@link #raw()} 让 {@code Brain} 零分配扫描。</p>
+ *
+ * <p><b>与 Canvas 的差异</b>：Canvas 额外维护 {@code running} 计数，用于「整组跳过没有活跃行为的集合」。
+ * 我们**没有启用那条快速路径** —— 实测 {@code Brain.tick} 里 {@code tickEachRunningBehavior}
+ * 只占 20%，而计数一旦错位就会静默漏 tick 行为，属于用功能性风险换小收益。所以这里只保留
+ * 数组语义，计数相关方法全部删除。</p>
+ */
+public final class BehaviorControlArraySet<E extends LivingEntity> extends AbstractObjectSet<BehaviorControl<? super E>> {
+
+    private static final BehaviorControl[] EMPTY_ARRAY = {};
+
+    private @Nullable BehaviorControl<? super E>[] a;
+    private int size;
+
+    public BehaviorControlArraySet() {
+        this.a = EMPTY_ARRAY;
+    }
+
+    /** 内部数组视图，供 {@code Brain} 零分配遍历。调用方不得修改。 */
+    public @Nullable BehaviorControl<? super E>[] raw() {
+        return this.a;
+    }
+
+    @Override
+    public int size() {
+        return this.size;
+    }
+
+    private int findKey(final Object o) {
+        final @Nullable BehaviorControl<? super E>[] arr = this.a;
+        for (int i = this.size; i-- != 0; ) {
+            if (Objects.equals(arr[i], o)) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    @Override
+    public boolean isEmpty() {
+        return this.size == 0;
+    }
+
+    @Override
+    public boolean contains(final Object k) {
+        return this.findKey(k) != -1;
+    }
+
+    @Override
+    public ObjectIterator<BehaviorControl<? super E>> iterator() {
+        return new ObjectIterator<>() {
+            int curr = -1;
+            int next = 0;
+
+            @Override
+            public boolean hasNext() {
+                return this.next < BehaviorControlArraySet.this.size;
+            }
+
+            @Override
+            public BehaviorControl<? super E> next() {
+                if (!this.hasNext()) {
+                    throw new NoSuchElementException();
+                }
+                return Objects.requireNonNull(BehaviorControlArraySet.this.a[this.curr = this.next++]);
+            }
+
