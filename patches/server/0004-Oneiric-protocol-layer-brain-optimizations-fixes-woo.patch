+ * {@code Boolean.getBoolean("oneiric.foo")} 时，默认值会散落到所有读取点，
+ * 于是「状态栏说关、实际是开」这类不一致必然发生。</p>
+ *
+ * <p>本类的三条契约：</p>
+ * <ol>
+ *   <li>一个开关名在这里登记一次，{@link #NAMES} 是 oneiric.yml 与状态行的<b>唯一来源</b>；</li>
+ *   <li>默认值只在 {@link #DEFAULT_ON} 里写一次，读取点不得自带默认值；</li>
+ *   <li>生电硬禁止的开关在 {@link #FORCED_OFF} 里，<b>显式 -D 也不接受</b>。</li>
+ * </ol>
+ */
+public final class OneiricConfig {
+
+    private static final String PREFIX = "oneiric.";
+
+    /** 默认开启的开关。 */
+    public static final Set<String> DEFAULT_ON = Set.of(
+            // 分区层：本方案的核心，默认开。
+            "region-partition",
+            // 长程耦合强制合并：关掉它等于回到 Folia 的行为（跨距离耦合会静默并行）。
+            "region-long-range-coupling",
+            // 并行度可见性：没有它，强制合并造成的损失永远没人知道。
+            "region-parallelism-report",
+            // 线程数自动 sizing（照搬老树的 OneiricThreadSizing + 新增 Folia tick 线程算法）
+            "auto-thread-sizing",
+            "auto-share-cores",
+            // 区域化 tick 本体（Folia 内核自带开关的 Oneiric 视图）。
+            "region-tick",
+            // 插件 API 兼容：同步 teleport。默认开，因为"插件零改动"是本项目的红线之一。
+            // 它在条件不成立时**返回 false 而不是撒谎**，所以开着也不会引入错误语义。
+            "compat-sync-teleport",
+            // 插件 API 兼容：可修改的传送事件（EntityTeleportEvent / PlayerTeleportEvent.getTo）。
+            "compat-teleport-event",
+            // 性能热路径：复用实体查询缓冲区。默认开；纯分配优化，不改变查询结果与顺序。
+            "entity-query-reuse",
+            "activation-query-reuse",
+            // 诊断（brain-profiling / brain-profiling-per-sensor / entity-density）默认关，
+            // 只在 NAMES 里登记（让 yml 能看到），不进 DEFAULT_ON。
+            // 生电稳定性：更新抑制防崩。默认开；不改装置行为，只在 tick 边界消费异常。
+            "update-suppression-crash-fix",
+            // Folia 跨区修复：拴绳 / 寻路。默认开；不在别人区域上建拴绳或寻路。
+            "off-region-leash-fix",
+            "off-region-pathfind-fix",
+            // 生电客户端协议层（Carpet / BBOR / XaeroMap / AppleSkin / Jade / Servux / Syncmatica / REI）。
+            // 默认全开：这些协议只在客户端主动握手后才响应，不占带宽、不影响原版客户端。
+            "protocol-layer",
+            "protocol-carpet",
+            "protocol-bbor",
+            "protocol-xaero",
+            "protocol-appleskin",
+            "protocol-jade",
+            "protocol-chatimage",
+            "protocol-servux-hud-logger",
+            "protocol-servux-hud-metadata",
+            "protocol-servux-entity",
+            "protocol-servux-structure",
+            "protocol-servux-litematics",
+            "protocol-syncmatica",
+            "protocol-bladeren",
+            // 生电原版对齐（从旧 Oneiric 树移植，Leaves 系）：这两项默认开，因为它们是把
