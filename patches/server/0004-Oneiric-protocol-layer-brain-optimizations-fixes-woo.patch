+    /**
+     * 解析 {@code mobs.skeleton.bow-accuracy} 表达式（Oneiric 自实现，替代 Leaf 的 scriptEngine）。
+     *
+     * @param expr       配置表达式，例如 {@code "difficulty * 1.5"}
+     * @param difficulty 当前难度（1..3）
+     * @param fallback   解析失败时的默认值
+     */
+    /**
+     * 解析 {@code mobs.skeleton.bow-accuracy} 的表达式。
+     *
+     * <h2>为什么要自己写解析器</h2>
+     *
+     * <p>Leaf/Purpur 用 {@code Entity.scriptEngine}（Nashorn）求值形如
+     * {@code let difficulty = 3; 14 - difficulty * 4} 的表达式。本核心不引入脚本引擎
+     * （依赖重，且配置里写什么都可能被执行）—— 取而代之的是下面这个**只做四则运算**的
+     * 递归下降解析器。</p>
+     *
+     * <h2>支持什么</h2>
+     *
+     * <ul>
+     *   <li>数字字面量：{@code 14}、{@code 1.5}</li>
+     *   <li>变量 {@code difficulty}（当前难度 1..3）</li>
+     *   <li>运算符 {@code + - * /}，标准优先级（乘除高于加减）</li>
+     *   <li>括号 {@code ( )}、一元正负号</li>
+     * </ul>
+     *
+     * <p>Purpur 的默认值 {@code 14 - difficulty * 4} 因此能正确算出：难度 1→10、2→6、3→2。</p>
+     *
+     * <h2>解析失败时</h2>
+     *
+     * <p>记**一条**日志（不是每次调用都记）并退回 {@code fallback} 里能解析的部分；
+     * 绝不静默算出一个错值 —— 那会让骷髅的箭法在无人察觉时变成另一个数。</p>
+     */
+    private static float parseBowAccuracy(final String expr, final int difficulty, final String fallbackValue) {
+        if (expr == null || expr.isBlank()) {
+            return parseFloatOr(fallbackValue, 0.0F);
+        }
+        try {
+            final Parser parser = new Parser(expr, difficulty);
+            final float value = parser.parseExpression();
+            parser.skipWhitespace();
+            if (!parser.atEnd()) {
+                throw new IllegalArgumentException("表达式末尾有未消费的字符: '" + parser.rest() + "'");
+            }
+            return value;
+        } catch (final RuntimeException malformed) {
+            // 只告警一次：这个方法每次世界创建会被调用 3 次（难度 1..3）× 世界数。
+            if (BOW_ACCURACY_WARNED.compareAndSet(false, true)) {
+                org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                        "[Oneiric] mobs.skeleton.bow-accuracy 表达式 '{}' 解析失败（{}），"
+                                + "退回默认值 '{}'。支持的语法：数字、difficulty、+ - * / 、括号。",
+                        expr, malformed.getMessage(), fallbackValue);
+            }
+            return parseFloatOr(fallbackValue, 0.0F);
+        }
+    }
+
+    /** 保证 bow-accuracy 的解析失败只告警一次（每世界 3 次调用会刷屏）。 */
+    private static final java.util.concurrent.atomic.AtomicBoolean BOW_ACCURACY_WARNED =
+            new java.util.concurrent.atomic.AtomicBoolean(false);
+
+    /**
+     * 极小的递归下降表达式解析器：只认数字、{@code difficulty}、四则运算与括号。
+     *
+     * <p>不做任何「求值任意代码」的事 —— 这是它与 Nashorn 的根本区别。</p>
+     */
+    private static final class Parser {
+        private final String src;
+        private final int difficulty;
+        private int pos;
+
+        Parser(final String src, final int difficulty) {
+            this.src = src;
+            this.difficulty = difficulty;
+            this.pos = 0;
+        }
+
+        boolean atEnd() {
+            return this.pos >= this.src.length();
+        }
+
+        String rest() {
+            return this.src.substring(Math.min(this.pos, this.src.length()));
+        }
+
+        void skipWhitespace() {
+            while (this.pos < this.src.length() && Character.isWhitespace(this.src.charAt(this.pos))) {
+                this.pos++;
+            }
+        }
+
+        private char peek() {
+            this.skipWhitespace();
+            return this.pos < this.src.length() ? this.src.charAt(this.pos) : '\0';
+        }
+
+        private void expect(final char c) {
+            if (peek() != c) {
+                throw new IllegalArgumentException("期望 '" + c + "' 但读到 '" + peek() + "'");
+            }
+            this.pos++;
+        }
+
+        /** expression := term (('+' | '-') term)* */
+        float parseExpression() {
+            float left = parseTerm();
+            while (true) {
+                final char op = peek();
+                if (op == '+') {
+                    this.pos++;
+                    left += parseTerm();
+                } else if (op == '-') {
+                    this.pos++;
+                    left -= parseTerm();
+                } else {
+                    return left;
+                }
+            }
+        }
+
+        /** term := factor (('*' | '/') factor)* */
+        private float parseTerm() {
+            float left = parseFactor();
+            while (true) {
+                final char op = peek();
+                if (op == '*') {
+                    this.pos++;
+                    left *= parseFactor();
+                } else if (op == '/') {
+                    this.pos++;
+                    final float divisor = parseFactor();
+                    if (divisor == 0.0F) {
+                        throw new IllegalArgumentException("除以零");
+                    }
+                    left /= divisor;
+                } else {
+                    return left;
+                }
+            }
+        }
+
+        /** factor := ('+' | '-')? (number | 'difficulty' | '(' expression ')') */
+        private float parseFactor() {
+            final char c = peek();
+            if (c == '+') {
+                this.pos++;
+                return parseFactor();
+            }
+            if (c == '-') {
+                this.pos++;
+                return -parseFactor();
+            }
+            if (c == '(') {
+                this.pos++;
+                // 注意：parseExpression 内部不会消费 ')'
+                final float inner = parseExpression();
+                expect(')');
+                return inner;
+            }
+            if (c == '\0') {
+                throw new IllegalArgumentException("表达式意外结束");
+            }
+            // 变量 difficulty
+            if (this.src.startsWith("difficulty", this.pos)) {
+                this.pos += "difficulty".length();
+                return this.difficulty;
+            }
+            // 数字字面量
+            final int start = this.pos;
+            while (this.pos < this.src.length()) {
+                final char ch = this.src.charAt(this.pos);
+                if (Character.isDigit(ch) || ch == '.') {
+                    this.pos++;
+                } else {
+                    break;
+                }
+            }
+            if (this.pos == start) {
+                throw new IllegalArgumentException("无法识别的字符 '" + c + "'");
+            }
+            return Float.parseFloat(this.src.substring(start, this.pos));
+        }
+    }
+
+    private static float parseFloatOr(final String s, final float dflt) {
+        try {
+            return Float.parseFloat(s);
+        } catch (final Exception ignored) {
+            return dflt;
+        }
+    }
