@@ -0,0 +1,100 @@
+package org.leavesmc.leaves.protocol.jade.provider.entity;
+
+import com.mojang.authlib.GameProfile;
+import java.util.UUID;
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.ComponentSerialization;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.OwnableEntity;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+import org.leavesmc.leaves.protocol.jade.JadeProtocol;
+import org.leavesmc.leaves.protocol.jade.accessor.EntityAccessor;
+import org.leavesmc.leaves.protocol.jade.provider.StreamServerDataProvider;
+
+/**
+ * Oneiric - 宠物/驯服生物的主人显示。
+ *
+ * <p>移植自 LeavesMC/Leaves（GPLv3）。</p>
+ *
+ * <p><b>与 Leaves 的差异</b>：26.x 用 {@code EntityReference} + {@code Services#nameToIdCache()}，
+ * 1.21.1 用 {@code OwnableEntity#getOwnerUUID()} + {@code GameProfileCache}。
+ * 玩家名解析顺序保持一致：先看主人实体是否在线（直接用实体名），
+ * 再查服务器配置缓存，都拿不到就不显示。</p>
+ */
+public enum AnimalOwnerProvider implements StreamServerDataProvider<EntityAccessor, Component> {
+    INSTANCE;
+
+    private static final ResourceLocation MC_ANIMAL_OWNER = JadeProtocol.mc_id("animal_owner");
+
+    @Nullable
+    public static UUID getOwnerUUID(final Entity entity) {
+        if (entity instanceof final OwnableEntity ownable) {
+            return ownable.getOwnerUUID();
+        }
+        return null;
+    }
+
+    @Override
+    public @Nullable Component streamData(@NotNull final EntityAccessor accessor) {
+        final ServerLevel level = accessor.getLevel();
+        final UUID uuid = getOwnerUUID(accessor.getEntity());
+        if (uuid == null) {
+            return null;
+        }
+        final Entity owner = level.getEntity(uuid);
+        if (owner != null) {
+            return owner.getName();
+        }
+        final String name = lookupPlayerName(uuid, level.getServer());
+        return name == null ? null : Component.literal(name);
+    }
+
+    /** 先查 GameProfileCache（本服玩家），查不到再尝试在线解析。 */
+    @Nullable
+    public static String lookupPlayerName(@Nullable final UUID uuid, final MinecraftServer server) {
+        if (uuid == null) {
+            return null;
+        }
+        final GameProfileCacheHolder holder = GameProfileCacheHolder.of(server);
+        final GameProfile cached = holder.getById(uuid);
+        if (cached != null && cached.getName() != null) {
+            return cached.getName();
+        }
+        return null;
+    }
+
+    /** 把 {@code GameProfileCache} 的调用点集中在一处，避免各版本方法名差异扩散。 */
+    private static final class GameProfileCacheHolder {
+        private final net.minecraft.server.players.GameProfileCache cache;
+
+        private GameProfileCacheHolder(final net.minecraft.server.players.GameProfileCache cache) {
+            this.cache = cache;
+        }
+
+        static GameProfileCacheHolder of(final MinecraftServer server) {
+            return new GameProfileCacheHolder(server.getProfileCache());
+        }
+
+        @Nullable
+        GameProfile getById(final UUID uuid) {
+            return this.cache == null ? null : this.cache.get(uuid).orElse(null);
+        }
+    }
+
+    @Override
+    public @NotNull StreamCodec<RegistryFriendlyByteBuf, Component> streamCodec() {
+        return ComponentSerialization.STREAM_CODEC;
+    }
+
+    @Override
+    public ResourceLocation getUid() {
+        return MC_ANIMAL_OWNER;
+    }
+}
