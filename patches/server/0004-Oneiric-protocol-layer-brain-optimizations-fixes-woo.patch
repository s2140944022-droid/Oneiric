@@ -0,0 +1,79 @@
+package io.papermc.paper.oneiric;
+
+/**
+ * Oneiric - 固定基础区（base region）的**纯坐标函数**。
+ *
+ * <h2>它解决的是什么</h2>
+ *
+ * <p>Folia 的「一个 chunk 属于哪个 region」是**算出来的**：{@code ThreadedRegionizer} 按邻接不变式
+ * 与 BFS 连通分量推导，region 的成员集合是活对象图的一部分，tick 中途可能正在变。
+ * 于是「这个区块归谁」这个问题的答案，取决于你去问的时刻。</p>
+ *
+ * <p>投影到生电上就是：一个方块刻在决定「我能不能写这个 chunk」时，得到的是**当时的**答案，
+ * 而不是**这一 tick 开始时**的答案。这正是跨区写竞态的来源之一。</p>
+ *
+ * <h2>为什么是 8×8 区块</h2>
+ *
+ * <table>
+ *   <caption>基础区尺寸的取舍</caption>
+ *   <tr><th>尺寸</th><th>合并粒度</th><th>并行度</th></tr>
+ *   <tr><td>16×16 区块</td><td>粗：机器跨 2 格就吞掉 32×32</td><td>低</td></tr>
+ *   <tr><td><b>8×8 区块（本类）</b></td><td>细：跨 2 格只吞 16×16</td><td>高</td></tr>
+ * </table>
+ *
+ * <p>与 Folia 的 {@code gridExponent = 3} 同一粒度（{@code 1 << 3 == 8} 区块/边）。</p>
+ *
+ * <h2>三条铁结论（本类的全部契约）</h2>
+ *
+ * <ol>
+ *   <li>基础区**永远固定**：不随加载/卸载/合并/玩家移动改变，重启后完全一致。</li>
+ *   <li>会变的只有「哪些基础区被划进同一个调度单元」—— 那是 {@link OneiricRegionPartition} 的事。</li>
+ *   <li>一个区块属于哪个基础区，任何时刻都是坐标函数，不查表、不会判错。</li>
+ * </ol>
+ *
+ * <p><b>注意</b>：本类**不修改** Folia 的 region 划分逻辑。它是并行的**只读参考系**，
+ * 用来给所有权判定、诊断输出与合并表提供一个与时间无关的坐标系。</p>
+ */
+public final class OneiricBaseRegion {
+
+    /** 基础区边长（区块）：8×8 区块 = 128×128 方块。固定，不提供配置项。 */
+    public static final int CHUNKS_PER_SIDE = 8;
+
+    /** 由 {@link #CHUNKS_PER_SIDE} 推出的位移量（3）。 */
+    public static final int SHIFT = 3;
+
+    /** 区块内索引掩码（7）。 */
+    public static final int MASK = CHUNKS_PER_SIDE - 1;
+
+    private OneiricBaseRegion() {
+    }
+
+    /** 基础区 X 坐标：**纯函数**，只依赖入参。 */
+
+    /** 基础区 Z 坐标：**纯函数**，只依赖入参。 */
+
+    /** 把 (regionX, regionZ) 打包成一个 long，供 map key 与集合使用。 */
+    public static long key(final int regionX, final int regionZ) {
+        return ((long) regionX << 32) | (regionZ & 0xFFFF_FFFFL);
+    }
+
+    /** chunk 坐标 → 基础区 key。这是「不查表」的那个函数。 */
+    public static long keyOfChunk(final int chunkX, final int chunkZ) {
+        return key(chunkX >> SHIFT, chunkZ >> SHIFT);
+    }
+
+    /** 解包：基础区 key → regionX。 */
+
+    /** 解包：基础区 key → regionZ。 */
+
+    /** 该基础区覆盖的最小 chunk 坐标。 */
+
+    /** 该基础区覆盖的最小 chunk 坐标。 */
+
+    /** 两个 chunk 是否属于同一个基础区。 */
+
+    /** 状态行片段。 */
+    public static String status() {
+        return "base-region=" + CHUNKS_PER_SIDE + "x" + CHUNKS_PER_SIDE + "chunks";
+    }
+}
