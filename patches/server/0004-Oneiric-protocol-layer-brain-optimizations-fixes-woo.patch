+    public static final String[] FORCED_OFF_ORDER = {
+            "optimize-suffocation",
+            "optimize-entities",
+            "reduce-chunk-lookups",
+            "optimize-fluids"
+    };
+
+    /** 区域化 tick 本体。被 OneiricPartitionHook 用作总闸：关掉它，分区层全部不生效。 */
+    public static final String REGION_TICK = "region-tick";
+
+    /**
+     * **生电原版对齐**开关的顺序视图（供 yml 生成）。
+     *
+     * <p>与 {@link #FORCED_OFF_ORDER} 同样的理由：{@code Set} 迭代顺序不保证稳定，
+     * 而 yml 每次启动必须写出同样的行序，否则纯注释改动都会被 git 记成"文件变了"。</p>
+     */
+    public static final String[] TECHNICAL_SWITCHES = {
+            "vanilla-item-tick",
+            "vanilla-hopper",
+            "vanilla-random",
+            "zero-tick-plants",
+            "renewable-deepslate",
+            "allow-grindstone-overstacking",
+            "lava-riptide",
