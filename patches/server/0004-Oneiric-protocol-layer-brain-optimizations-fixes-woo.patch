+package org.leavesmc.leaves;
+
+import io.papermc.paper.oneiric.OneiricConfig;
+
+/**
+ * Oneiric - Leaves 配置垫片。
+ *
+ * <p>移植自 LeavesMC/Leaves（GPLv3）的协议层配置结构。
+ *
+ * <h2>为什么需要它</h2>
+ *
+ * <p>Leaves 的 176 个协议实现类直接用 {@code LeavesConfig.protocol.xxx} 读开关。
+ * 为了能<b>原样搬运</b>这些类（而不是改 176 个文件），这里提供同名同形的字段，
+ * 但底层读的是 Oneiric 自己的开关系统。</p>
+ *
+ * <p>每个字段都由 {@code oneiric.yml} 里对应的开关控制，例如
+ * {@code LeavesConfig.protocol.bborProtocol} 读 {@code protocol-bbor}。</p>
+ *
+ * <h2>与 Leaves 的差异</h2>
+ *
+ * <ul>
+ *   <li>不读 YAML 配置文件，读 Oneiric 的系统属性/yml 开关。</li>
+ *   <li>没有 {@code config} / {@code save()}（那是 Leaves 的配置管理器，未移植）。</li>
+ *   <li>新增 {@link #enabled(String)} 统一入口，便于默认值集中管理。</li>
+ * </ul>
+ */
+public class LeavesConfig {
+
+    /** 统一的开关读取：默认关（协议是可选功能，不该默认占用带宽）。 */
+    private static boolean enabled(final String name) {
+        return OneiricConfig.isEnabled(name);
+    }
+
+    public static final Mics mics = new Mics();
+    public static final Protocol protocol = new Protocol();
+    public static final Modify modify = new Modify();
+
+    /** 杂项。 */
+    public static final class Mics {
+        /** 是否允许发送 Leaves 自定义 payload 事件（供插件拦截协议包）。 */
+        public final boolean leavesPacketEvent = enabled("protocol-packet-event");
+    }
+
+    /** 原版机制微调。字段名与 Leaves 保持一致，便于原样移植。 */
+    public static final class Modify {
+        public final HopperCounter hopperCounter = new HopperCounter();
+    }
+
+    /** 羊毛漏斗计数器。 */
+    public static final class HopperCounter {
+        /** 总开关：是否允许羊毛漏斗计数器工作。 */
+        public final boolean enable = enabled("hopper-counter");
+        /** Carpet 的 hopperCountersUnlimitedSpeed：漏斗指向羊毛时不再限速。 */
+        public final boolean unlimitedSpeed = enabled("hopper-counter-unlimited-speed");
+    }
+
+    /** 协议开关。字段名与 Leaves 保持一致，便于原样移植。 */
+    public static final class Protocol {
+        /** BBOR：结构边界可视化。 */
+        public final boolean bborProtocol = enabled("protocol-bbor");
+        /** Xaero 小地图/世界地图。 */
+        public final boolean xaeroMapProtocol = enabled("protocol-xaero");
+        /** Xaero 服务器 ID（多服群组里区分地图来源，0 表示未设置）。 */
+        public final int xaeroMapServerID = Integer.getInteger("oneiric.xaero-server-id", 0);
+        /** Carpet 服务器协议（规则同步、TPS/mobcaps HUD）。 */
+        public final boolean leavesCarpetSupport = enabled("protocol-carpet");
+        /** ChatImage：聊天图片。 */
+        public final boolean chatImageProtocol = enabled("protocol-chatimage");
+        /** Jade：悬停方块信息。 */
+        public final boolean jadeProtocol = enabled("protocol-jade");
+        // Oneiric：REI 服务端协议未移植 —— 26.x 的配方展示 API（crafting.display.*）
+        // 在 1.21.1 不存在，且客户端 REI 版本的协议格式也不同，故不提供该开关。
+        /** 严格模式：未知 payload 不静默丢弃。 */
+        public final boolean strictMode = enabled("protocol-strict-mode");
+
+        public final AppleSkin appleskin = new AppleSkin();
+        public final Bladeren bladeren = new Bladeren();
+        public final Pca pca = new Pca();
+        public final Servux servux = new Servux();
+        public final Syncmatica syncmatica = new Syncmatica();
+    }
+
+    public static final class AppleSkin {
+        public final boolean enable = enabled("protocol-appleskin");
+        /** 饥饿值/饱和度同步间隔（tick）。 */
+        public final int syncTickInterval = Integer.getInteger("oneiric.appleskin-sync-interval", 20);
+    }
+
+    public static final class Bladeren {
+        public final boolean enable = enabled("protocol-bladeren");
+        /** MSPT 广播：跟随总开关，不再单独占一个键。 */
+        public final boolean msptSyncProtocol = enabled("protocol-bladeren");
+        public final int msptSyncTickInterval = Integer.getInteger("oneiric.bladeren-mspt-interval", 20);
+    }
+
+    public static final class Pca {
+        public final boolean enable = enabled("protocol-pca");
+        public final boolean syncPlayerEntity = enabled("protocol-pca-sync-player");
+    }
+
+    public static final class Servux {
+        public final boolean hudLoggerProtocol = enabled("protocol-servux-hud-logger");
+        public final boolean hudMetadataProtocol = enabled("protocol-servux-hud-metadata");
+        public final boolean entityProtocol = enabled("protocol-servux-entity");
+        public final boolean structureProtocol = enabled("protocol-servux-structure");
+        /** 是否把世界种子共享给 Servux 客户端（默认关，避免泄露地图种子）。 */
+        public final boolean hudMetadataShareSeed =
+                !"false".equalsIgnoreCase(System.getProperty("oneiric.servux-share-seed", "false"));
+        public final int hudUpdateInterval = Integer.getInteger("oneiric.servux-hud-interval", 20);
+        /** HUD 记录器白名单（空表示全部）。 */
+        public final java.util.List<String> hudEnabledLoggers =
+                java.util.Arrays.asList(System.getProperty("oneiric.servux-hud-loggers", "").split(","));
+        public final Litematics litematics = new Litematics();
+    }
+
