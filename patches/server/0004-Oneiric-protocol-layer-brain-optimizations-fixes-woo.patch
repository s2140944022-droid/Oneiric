diff --git a/src/main/java/org/leavesmc/leaves/command/CounterCommand.java b/src/main/java/org/leavesmc/leaves/command/CounterCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..b700cb218f3d794dbceedd5ebc81ee1c84ec721d
--- /dev/null
+++ b/src/main/java/org/leavesmc/leaves/command/CounterCommand.java
@@ -0,0 +1,155 @@
+package org.leavesmc.leaves.command;
+
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import net.kyori.adventure.text.format.TextColor;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.world.item.DyeColor;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.jetbrains.annotations.NotNull;
+import org.leavesmc.leaves.util.HopperCounter;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Oneiric - {@code /counter} 羊毛漏斗计数器命令。
+ *
+ * <p>移植自 LeavesMC/Leaves（GPLv3）的 {@code CounterCommand}，Powered by fabric-carpet。</p>
+ *
+ * <p><b>与 Leaves 的差异</b>：Leaves 用自建 Brigadier 命令树；这里改用 Bukkit 的
+ * {@link Command} + {@code CommandMap} 注册（与本核心的 {@code /oneiric} 一致），
+ * 参数解析和补全都在本类内完成，避免额外移植整套命令框架。</p>
+ */
+public final class CounterCommand extends Command {
+
+    public static final String NAME = "counter";
+
+    public CounterCommand() {
+        super(NAME);
+        this.setPermission("oneiric.commands.counter");
+        this.setDescription("Wool hopper counter (fabric-carpet compatible)");
+        this.setUsage("/counter [enable|disable|reset|<color> [reset|realtime]]");
+    }
+
+    /** 与 {@code /oneiric} 相同的注册方式，失败只记日志、不阻断启动。 */
+    public static void register() {
+        try {
+            org.bukkit.Bukkit.getCommandMap().register("oneiric", NAME, new CounterCommand());
+        } catch (final Throwable t) {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                "[Oneiric] 注册 /{} 命令失败（不影响启动）: {}", NAME, t.toString());
+        }
+    }
+
+    @Override
+    public boolean execute(@NotNull final CommandSender sender, @NotNull final String commandLabel,
+                           @NotNull final String[] args) {
+        if (!testPermission(sender)) {
+            return true;
+        }
+
+        if (args.length == 0) {
+            sender.sendMessage(Component.text("Hopper counter is ", NamedTextColor.GRAY)
+                .append(Component.text(HopperCounter.isEnabled() ? "enabled" : "disabled", NamedTextColor.AQUA)));
+            return true;
+        }
+
+        switch (args[0].toLowerCase(Locale.ROOT)) {
+            case "enable" -> {
+                HopperCounter.setEnabled(true);
+                sender.sendMessage(Component.text("Hopper counter is now ", NamedTextColor.GRAY)
+                    .append(Component.text("enabled", NamedTextColor.AQUA)));
+                return true;
+            }
+            case "disable" -> {
+                HopperCounter.setEnabled(false);
+                sender.sendMessage(Component.text("Hopper counter is now ", NamedTextColor.GRAY)
+                    .append(Component.text("disabled", NamedTextColor.AQUA)));
+                return true;
+            }
+            case "reset" -> {
+                HopperCounter.resetAll(MinecraftServer.getServer(), false);
+                sender.sendMessage(Component.text("Restarted all counters", NamedTextColor.GRAY));
+                return true;
+            }
+            default -> {
+            }
+        }
+
+        final DyeColor color = dyeColor(args[0]);
+        if (color == null) {
+            sender.sendMessage(Component.text("Unknown color: " + args[0], NamedTextColor.RED));
+            return true;
+        }
+
+        final HopperCounter counter = HopperCounter.getCounter(color);
+        if (args.length == 1) {
+            display(sender, counter, false);
+            return true;
+        }
+
+        switch (args[1].toLowerCase(Locale.ROOT)) {
+            case "reset" -> {
+                counter.reset(MinecraftServer.getServer());
+                sender.sendMessage(Component.text("Restarted counter ", NamedTextColor.GRAY)
+                    .append(Component.text(color.getName(), TextColor.color(color.getTextColor()))));
+            }
+            case "realtime" -> display(sender, counter, true);
+            default -> sender.sendMessage(Component.text("Usage: /counter <color> [reset|realtime]", NamedTextColor.RED));
+        }
+        return true;
+    }
+
+    private static void display(final CommandSender sender, final HopperCounter counter, final boolean realTime) {
+        for (final Component component : counter.format(MinecraftServer.getServer(), realTime)) {
+            sender.sendMessage(component);
+        }
+    }
+
+    @Override
+    public @NotNull List<String> tabComplete(@NotNull final CommandSender sender, @NotNull final String alias,
+                                             @NotNull final String[] args) {
+        if (!testPermissionSilent(sender)) {
+            return Collections.emptyList();
+        }
+        if (args.length == 1) {
+            final String prefix = args[0].toLowerCase(Locale.ROOT);
+            final List<String> out = new ArrayList<>();
+            for (final String base : new String[]{"enable", "disable", "reset"}) {
+                if (base.startsWith(prefix)) {
+                    out.add(base);
+                }
+            }
+            for (final DyeColor color : DyeColor.values()) {
+                if (color.getName().startsWith(prefix)) {
+                    out.add(color.getName());
+                }
+            }
+            return out;
+        }
+        if (args.length == 2 && dyeColor(args[0]) != null) {
+            final String prefix = args[1].toLowerCase(Locale.ROOT);
+            final List<String> out = new ArrayList<>();
+            for (final String base : new String[]{"reset", "realtime"}) {
+                if (base.startsWith(prefix)) {
+                    out.add(base);
+                }
+            }
+            return out;
+        }
+        return Collections.emptyList();
+    }
+
+    private static DyeColor dyeColor(final String name) {
+        for (final DyeColor color : DyeColor.values()) {
+            if (color.getName().equalsIgnoreCase(name)) {
+                return color;
+            }
+        }
+        return null;
+    }
+}
