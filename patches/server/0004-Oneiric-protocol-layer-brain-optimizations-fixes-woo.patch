diff --git a/src/main/java/net/minecraft/world/entity/ai/OneiricBrainProfiling.java b/src/main/java/net/minecraft/world/entity/ai/OneiricBrainProfiling.java
new file mode 100644
index 0000000000000000000000000000000000000000..713826cd5ff40f58f7303e8bb4675ad3118633d6
--- /dev/null
+++ b/src/main/java/net/minecraft/world/entity/ai/OneiricBrainProfiling.java
@@ -0,0 +1,124 @@
+package net.minecraft.world.entity.ai;
+
+import io.papermc.paper.oneiric.OneiricConfig;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.LongAdder;
+
+/**
+ * Oneiric - 大脑（Brain）细粒度计时累加器。
+ *
+ * <p><b>为什么不用原版 ProfilerFiller</b>：Folia 区域线程用的是自己的
+ * {@code RegionizedProfiler}（{@code /profiler} 命令），它只采集区域级分段，
+ * 不读取原版 {@code ProfilerFiller} 的 push/pop。往原版 profiler 里 push
+ * 在这里既看不到、又要承担字符串拼接开销（实测把 TPS 从 20 压到 16.6）。</p>
+ *
+ * <p>因此这里用最轻的方式：开启时对四段代码各做一次 {@code System.nanoTime()}
+ * 前后相减，累加到 {@link LongAdder}；关闭时所有调用点是常量判断，零开销。
+ * 数据通过 {@link #report()} 输出，接入 {@code /oneiric} 状态行。</p>
+ *
+ * <p>累加器是线程安全的：Folia 的多个区域线程会并发调用同一套静态计数，
+ * {@link LongAdder} 正是为这种高频并发累加设计的。</p>
+ */
+public final class OneiricBrainProfiling {
+
+    private static final boolean ENABLED = OneiricConfig.isEnabled("brain-profiling");
+    private static final boolean PER_SENSOR = OneiricConfig.isEnabled("brain-profiling-per-sensor");
+
+    private static final LongAdder MEMORY_NANOS = new LongAdder();
+    private static final LongAdder SENSOR_NANOS = new LongAdder();
+    private static final LongAdder START_NANOS = new LongAdder();
+    private static final LongAdder TICK_NANOS = new LongAdder();
+    private static final LongAdder BRAIN_CALLS = new LongAdder();
+
+    private OneiricBrainProfiling() {
+    }
+
+    public static boolean enabled() {
+        return ENABLED;
+    }
+
+    public static boolean perSensor() {
+        return PER_SENSOR;
+    }
+
+    public static void recordMemory(final long nanos) {
+        MEMORY_NANOS.add(nanos);
+    }
+
+    public static void recordSensors(final long nanos) {
+        SENSOR_NANOS.add(nanos);
+    }
+
+    public static void recordStart(final long nanos) {
+        START_NANOS.add(nanos);
+    }
+
+    public static void recordTick(final long nanos) {
+        TICK_NANOS.add(nanos);
+    }
+
+    public static void recordCall() {
+        BRAIN_CALLS.increment();
+    }
+
+    // 启动行为扫描的规模统计：用来判断 41us 是"扫描太宽"还是"tryStart 太贵"。
+    private static final LongAdder START_ACTIVE_ACTIVITIES = new LongAdder();
+    private static final LongAdder START_EXAMINED = new LongAdder();
+    private static final LongAdder START_STARTED = new LongAdder();
+    /** activeBehaviors 缓存重建次数。若接近 calls 说明缓存没命中。 */
+    private static final LongAdder ACTIVE_BEHAVIORS_REBUILDS = new LongAdder();
+
+    public static void recordStartScan(final int activeActivities, final int examined, final int started) {
+        START_ACTIVE_ACTIVITIES.add(activeActivities);
+        START_EXAMINED.add(examined);
+        START_STARTED.add(started);
+    }
+
+    public static void recordActiveBehaviorsRebuild() {
+        ACTIVE_BEHAVIORS_REBUILDS.increment();
+    }
+
+    // 活动切换与 PANIC 计数：验证 activeBehaviors 缓存是否随活动变化正确重建。
+    private static final LongAdder ACTIVITY_CHANGES = new LongAdder();
+    private static final LongAdder PANIC_ACTIVATIONS = new LongAdder();
+
+    /** {@code Brain.setActiveActivity} 真正改变活动集合时调用。 */
+    public static void recordActivityChange(final boolean panic) {
+        ACTIVITY_CHANGES.increment();
+        if (panic) {
+            PANIC_ACTIVATIONS.increment();
+        }
+    }
+
+    /**
+     * 取一次快照并清零。返回格式：{@code calls=N mem=Xus sensors=Yus start=Zus tick=Wus}。
+     * 每段显示的是“每次 Brain.tick 的平均开销”，单位微秒。
+     */
+    public static String report() {
+        if (!ENABLED) {
+            return "brain-profiling=off";
+        }
+        final long calls = BRAIN_CALLS.sumThenReset();
+        final long mem = MEMORY_NANOS.sumThenReset();
+        final long sensors = SENSOR_NANOS.sumThenReset();
+        final long start = START_NANOS.sumThenReset();
+        final long tick = TICK_NANOS.sumThenReset();
+        final long activeActivities = START_ACTIVE_ACTIVITIES.sumThenReset();
+        final long examined = START_EXAMINED.sumThenReset();
+        final long started = START_STARTED.sumThenReset();
+        final long rebuilds = ACTIVE_BEHAVIORS_REBUILDS.sumThenReset();
+        final long activityChanges = ACTIVITY_CHANGES.sumThenReset();
+        final long panics = PANIC_ACTIVATIONS.sumThenReset();
+        if (calls == 0L) {
+            return "brain-profiling=on calls=0";
+        }
+        final double perCall = 1.0D / calls / 1000.0D; // nanos -> us per call
+        return String.format(
+                "brain-profiling=on calls=%d mem=%.2fus sensors=%.2fus start=%.2fus tick=%.2fus"
+                        + " startScan(active=%.2f examined=%.2f started=%.2f) cache(rebuild=%d rate=%.1f%%)"
+                        + " activity(changes=%d panics=%d)",
+                calls, mem * perCall, sensors * perCall, start * perCall, tick * perCall,
+                (double) activeActivities / calls, (double) examined / calls, (double) started / calls,
+                rebuilds, 100.0D * rebuilds / calls, activityChanges, panics);
+    }
+}
