+
+    /** 全部开关名。oneiric.yml 与状态行的唯一来源。 */
+    public static final String[] NAMES = {
+            // ── 分区层（本方案核心）
+            "region-tick",
+            "region-partition",
+            "region-long-range-coupling",
+            "region-parallelism-report",
+            // 线程数自动 sizing（照搬老树的 OneiricThreadSizing + 新增 Folia tick 线程算法）
+            "auto-thread-sizing",
+            "auto-share-cores",
+            // ── 插件 API 兼容
+            "compat-sync-teleport",
+            "compat-teleport-event",
+            // ── 性能热路径（分配复用，不改变行为）
+            "entity-query-reuse",
+            "activation-query-reuse",
+            // ── 诊断（默认关）
+            "brain-profiling",
+            "brain-profiling-per-sensor",
+            "entity-density",
+            // ── 生电稳定性 / Folia 跨区修复（默认开）
+            "update-suppression-crash-fix",
+            "off-region-leash-fix",
+            "off-region-pathfind-fix",
+            // ── 生电客户端协议层（默认开）
