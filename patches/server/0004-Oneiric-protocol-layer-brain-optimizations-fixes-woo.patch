index 0000000000000000000000000000000000000000..45fcefca31dd26cfadaa5fbe5300574218f23c33
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/redstone/UpdateSuppressionException.java
@@ -0,0 +1,172 @@
+package io.papermc.paper.oneiric.redstone;
+
+import java.util.ArrayList;
+import java.util.List;
+import javax.annotation.Nullable;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.Block;
+import org.bukkit.Location;
+import org.bukkit.Material;
+import org.bukkit.entity.Player;
+
+/**
+ * Oneiric - 更新抑制异常（生电服稳定性修复）。
+ *
+ * <p>移植自 LeavesMC/Leaves（GPLv3）的 {@code org.leavesmc.leaves.util.UpdateSuppressionException}。</p>
+ *
+ * <h2>为什么必须有它</h2>
+ *
+ * <p>更新抑制（update suppression）是生电最常用的技巧之一：刷沙机、刷蜡机、部分 TNT 装置
+ * 都依赖"在方块更新链中途抛异常"来截断更新传播。原版这里会抛
+ * {@link ClassCastException} / {@link StackOverflowError} / {@link IllegalArgumentException}，
+ * 而服务端的 tick 循环把这个异常当成**致命错误**处理 —— 直接生成崩溃报告并关服。</p>
+ *
+ * <p>也就是说：<b>服主一开刷沙机就可能崩服</b>。这不是边缘场景，是生电服的日常操作。</p>
+ *
+ * <h2>做法</h2>
+ *
+ * <p>不改变"抛异常"这个机制本身（那是装置依赖的行为），而是改变<b>异常被谁捕获</b>：
+ * 把原始异常包进本类，在 tick 循环 / 包处理 / 实体 tick 的边界处捕获并
+ * {@link #consume()}，记录一条日志 + 触发可取消事件，然后<b>继续正常 tick</b>。
+ * 方块更新链依然在抛出点被截断，装置行为不变。</p>
+ *
+ * <h2>与 Leaves 的差异</h2>
+ *
+ * <ul>
+ *   <li>不依赖 {@code LeavesLogger}，用 log4j（Oneiric 全局日志）。</li>
+ *   <li>不依赖 {@code ServerBot}（我们没有假玩家体系），玩家名直接输出。</li>
+ *   <li>事件类在本包内自带，不依赖 Leaves API 包。</li>
+ * </ul>
+ */
+public class UpdateSuppressionException extends RuntimeException {
+
+    private @Nullable BlockPos pos;
+    private @Nullable Level level;
+    private @Nullable Block source;
+    private @Nullable ServerPlayer player;
+    private final Throwable throwable;
+
+    public UpdateSuppressionException(@Nullable BlockPos pos, @Nullable Level level,
+                                      @Nullable Block source, @Nullable ServerPlayer player,
+                                      Throwable throwable) {
+        super("Update Suppression");
+        this.pos = pos;
+        this.level = level;
+        this.source = source;
+        this.player = player;
+        this.throwable = throwable;
+    }
+
+    /** 便捷构造：只有原始异常（最常见的情况 —— 抛出点不知道上下文）。 */
+    public static UpdateSuppressionException of(final Throwable throwable) {
+        return new UpdateSuppressionException(null, null, null, null, throwable);
+    }
+
+    public void providePlayer(final ServerPlayer player) {
+        if (this.level == null) {
+            this.level = player.level();
+        }
+        this.player = player;
+    }
+
+    public void provideLevel(final Level level) {
+        // Leaves 原实现这里是 if (this.level != null)，逻辑反了（会把已设置的覆盖成 null 之外的值）。
+        // 正确语义：只在缺失时补上，不覆盖已有值。
+        if (this.level == null) {
+            this.level = level;
+        }
+    }
+
+    public void provideBlock(final Level level, final BlockPos pos, final Block source) {
+        provideLevel(level);
+        provideBlock(pos, source);
+    }
+
+    public void provideBlock(final BlockPos pos, final Block source) {
+        if (this.pos == null) {
+            this.pos = pos;
+        }
+        if (this.source == null) {
+            this.source = source;
+        }
+    }
+
+    /**
+     * 消费掉这次更新抑制：触发事件 + 记一条日志，然后返回。
+     *
+     * <p>调用方（tick 循环）在 {@code catch} 里调用它，之后继续正常 tick。
+     * 这正是"服不崩、装置照常工作"的全部实现。</p>
+     */
+    public void consume() {
+        submitEvent();
+        org.apache.logging.log4j.LogManager.getLogger("Oneiric").info("[Oneiric] {}", getMessage());
+    }
+
+    private void submitEvent() {
+        Location location = null;
+        if (this.pos != null && this.level != null) {
+            location = new Location(this.level.getWorld(),
+                    this.pos.getX(), this.pos.getY(), this.pos.getZ());
+        }
+        Material material = null;
+        if (this.source != null) {
+            material = this.source.defaultBlockState().getBukkitMaterial();
+        }
+        Player bukkitPlayer = null;
+        if (this.player != null) {
+            bukkitPlayer = this.player.getBukkitEntity();
+        }
+        new OneiricUpdateSuppressionEvent(bukkitPlayer, location, material, this.throwable).callEvent();
+    }
+
+    @Override
+    public String getMessage() {
+        final List<String> messages = new ArrayList<>();
+        messages.add("检测到 " + getTypeName() + " 更新抑制（生电装置正常行为，服务器不崩）");
+        if (this.source != null) {
+            messages.add("来源 " + this.source.defaultBlockState().getBukkitMaterial().name());
+        }
+        if (this.pos != null) {
+            messages.add("位置 [x:" + this.pos.getX() + ",y:" + this.pos.getY() + ",z:" + this.pos.getZ() + "]");
+        }
+        if (this.level != null) {
+            messages.add("世界 " + this.level.getWorld().getName());
+        }
+        if (this.player != null) {
+            messages.add("玩家 " + this.player.getBukkitEntity().getName());
+        }
+        return String.join(" ", messages);
+    }
+
+    private String getTypeName() {
+        final Class<? extends Throwable> type = this.throwable.getClass();
+        if (type == ClassCastException.class) {
+            return "CCE";
+        }
+        if (type == StackOverflowError.class) {
+            return "SOE";
+        }
+        if (type == IllegalArgumentException.class) {
+            return "IAE";
+        }
+        return type.getSimpleName();
+    }
+
+    /**
+     * 不填充自己的栈：真正的栈在 {@code throwable} 里。
+     *
+     * <p>生电的更新抑制经常由 {@link StackOverflowError} 触发（递归更新），
+     * 在这里再抓一次栈既慢又会掩盖原始栈。</p>
+     */
+    @Override
+    public Throwable fillInStackTrace() {
+        return this;
+    }
+
+    @Override
+    public StackTraceElement[] getStackTrace() {
+        return this.throwable.getStackTrace();
+    }
+}
