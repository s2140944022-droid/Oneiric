+            "protocol-syncmatica",
+            "protocol-bladeren",
+            // ── 生电原版对齐（Leaves 系，从旧树移植）
+            "vanilla-item-tick",
+            "vanilla-hopper",
+            // 技术模式：恢复 Paper 关掉的原版机制（复制机/无头活塞/永破/绊线复制）。
+            // 生电服应默认开 —— 关着的话所有复制机都不工作。
+            "mc-technical-mode",
+            "vanilla-random",
+            "zero-tick-plants",
+            "renewable-deepslate",
+            "allow-grindstone-overstacking",
+            "lava-riptide",
+            "crafter1gt",
+            "redstone-trapdoor-connect",
+            "no-tnt-place-update",
+            "old-hopper-suckin",
+            // 羊毛漏斗计数器（Carpet hopperCounters）。默认开：只在漏斗指向羊毛时生效，
+            // 不改变普通漏斗行为。/counter 命令按颜色读计数。
+            "hopper-counter",
+            // Carpet 的 hopperCountersUnlimitedSpeed：漏斗指向羊毛时一次 tick 内搬空。
