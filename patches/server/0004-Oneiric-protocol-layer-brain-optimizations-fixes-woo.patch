@@ -0,0 +1,77 @@
+package io.papermc.paper.oneiric;
+
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.TextColor;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * Oneiric - {@code /oneiric} 状态命令。
+ *
+ * <h2>它必须存在的理由</h2>
+ *
+ * <p>这套设计里所有关键判断都是"看不见的"：合并发生了没有、哪条边界吃掉了并行度、
+ * 分裂被否决了几次。没有这个命令，运维只能靠猜。v6 §十五 的七项指标就是它的输出契约。</p>
+ *
+ * <h2>为什么它不能抛异常</h2>
+ *
+ * <p>状态命令本身把服务器搞崩，是比"没状态"严重得多的故障。因此所有采集路径都已
+ * 吞掉异常（见 {@link OneiricStatus}），本类也不再向外抛。</p>
+ */
+public final class OneiricCommand extends Command {
+
+    /** 命令名。 */
+    public static final String NAME = "oneiric";
+
+    public OneiricCommand() {
+        super(NAME);
+        this.setPermission("oneiric.commands.status");
+        this.setDescription("Show Oneiric region-parallelism status");
+        this.setUsage("/oneiric");
+    }
+
+    /**
+     * 注册到 Bukkit 命令表。与 Luminol 自己的 {@code OneiricCoreConfig.setupLatch()} 同一做法
+     * （{@code Bukkit.getCommandMap().register(fallbackPrefix, name, command)}）。
+     *
+     * <p>幂等：重复注册只会抛 {@code CommandConflict}，这里吞掉 —— 命令注册失败
+     * 不该阻止服务器启动，但必须**留下一条日志**，否则"我敲 /oneiric 没反应"无从排查。</p>
+     */
+    public static void register() {
+        try {
+            org.bukkit.Bukkit.getCommandMap().register("oneiric", NAME, new OneiricCommand());
+        } catch (final Throwable t) {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                    "[Oneiric] 注册 /{} 命令失败（不影响启动）: {}", NAME, t.toString());
+        }
+    }
+
+    @Override
+    public boolean execute(@NotNull final CommandSender sender, @NotNull final String commandLabel,
+                           @NotNull final String[] args) {
+        if (!testPermission(sender)) {
+            return true;
+        }
+        // 多行输出：先给结论行，再给两个明细行。控制台日志保持干净（只在手敲命令时输出）。
+        sender.sendMessage(Component.text("[Oneiric] " + OneiricBaseRegion.status())
+                .color(TextColor.color(0x55AAFF)));
+        sender.sendMessage(Component.text("  " + OneiricStatus.snapshot().describe()));
+        sender.sendMessage(Component.text("  " + OneiricRegionPartition.status()
+                + " | " + OneiricPartitionHook.status()
+                + " | " + OneiricLongRangeCoupling.status()
+                + " | " + OneiricYml.status()));
+        sender.sendMessage(Component.text("  switches: " + OneiricConfig.status()));
+        // Oneiric - 大脑细粒度计时（默认关）。开启后这一行给出每段每次调用的平均开销；
+        // 每次读取都会清零，所以连续敲两次 /oneiric 得到的是"两次之间"的增量。
+        if (OneiricConfig.isEnabled("brain-profiling")) {
+            sender.sendMessage(Component.text("  " + net.minecraft.world.entity.ai.OneiricBrainProfiling.report()));
+        }
+        // Oneiric - 实体密度热力图（默认关）。统计"真正走到 tick 路径"的实体数，
+        // 与官方实体数对比即可看出有多少实体在未加载区块里没被 tick。
+        if (OneiricConfig.isEnabled("entity-density")) {
+            sender.sendMessage(Component.text("  " + OneiricEntityDensity.report()));
+        }
+        return true;
+    }
+}
