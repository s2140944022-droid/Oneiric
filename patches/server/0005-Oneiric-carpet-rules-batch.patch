diff --git a/src/main/java/net/minecraft/world/entity/ai/gossip/GossipContainer.java b/src/main/java/net/minecraft/world/entity/ai/gossip/GossipContainer.java
index c7f012674361a323c1efeca4660cd3f46d308ee1..d0bc393b08ff263eba7c99f27a87d92e6f84b2a1 100644
--- a/src/main/java/net/minecraft/world/entity/ai/gossip/GossipContainer.java
+++ b/src/main/java/net/minecraft/world/entity/ai/gossip/GossipContainer.java
@@ -115,6 +115,34 @@ public class GossipContainer {
 
     public int getReputation(UUID target, Predicate<GossipType> gossipTypeFilter) {
         GossipContainer.EntityGossips entityGossips = this.gossips.get(target);
+        // Oneiric - 村民折扣全服共享（Leaves: Shared villager discounts）。
+        // 只对 MAJOR_POSITIVE 生效：打折是"全体玩家对同一村民的共同印象"，
+        // 负面声望仍然各自独立，避免恶意刷负分连坐。
+        if (org.leavesmc.leaves.LeavesConfig.modify.sharedVillagerDiscounts
+            && gossipTypeFilter.test(GossipType.MAJOR_POSITIVE)) {
+            int otherRep = 0;
+            if (entityGossips != null) {
+                otherRep = entityGossips.weightedValue(v -> gossipTypeFilter.test(v) && v != GossipType.MAJOR_POSITIVE);
+            }
+            int majorPositiveRep = this.gossips.values().stream()
+                .mapToInt(a -> a.weightedValue(v -> v == GossipType.MAJOR_POSITIVE))
+                .sum();
+            return otherRep + Math.min(majorPositiveRep, GossipType.MAJOR_POSITIVE.max * GossipType.MAJOR_POSITIVE.weight);
+        }
+        // Oneiric - 无限交易折扣（Leaves: Villager infinite discounts）。
+        //
+        // Ore-doubling 之外的另一个用途：生电服常年和同一批村民交易，原版的
+        // max 上限与每日衰减会让折扣「掉回去」。这里不改 GossipType 枚举本身
+        // （那是全局状态，开关关闭后无法恢复，还会波及所有村民），
+        // 只在读取时给正向声望抬高上限 —— 关闭开关即刻恢复原版表现。
+        if (org.leavesmc.leaves.LeavesConfig.modify.oldMC.villagerInfiniteDiscounts && entityGossips != null) {
+            final int base = entityGossips.weightedValue(gossipTypeFilter);
+            if (base <= 0) {
+                return base;
+            }
+            final int uncapped = entityGossips.weightedValue(v -> gossipTypeFilter.test(v) && v != GossipType.MAJOR_NEGATIVE && v != GossipType.MINOR_NEGATIVE);
+            return Math.max(base, uncapped);
+        }
         return entityGossips != null ? entityGossips.weightedValue(gossipTypeFilter) : 0;
     }
 
@@ -185,6 +213,7 @@ public class GossipContainer {
     public static class EntityGossips {
         final Object2IntMap<GossipType> entries = new Object2IntOpenHashMap<>();
 
+
         public int weightedValue(Predicate<GossipType> gossipTypeFilter) {
