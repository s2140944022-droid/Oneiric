From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fuchen <fuchen@oneiric.local>
Date: Fri, 20 Nov 2026 01:53:26 +0800
Subject: [PATCH] Oneiric: derive tick-event gate generation from the global
 tick handle (more precise than wall-clock buckets)


diff --git a/src/main/java/io/papermc/paper/oneiric/OneiricTickEventGate.java b/src/main/java/io/papermc/paper/oneiric/OneiricTickEventGate.java
index ef628d8932daa5d0be491e823c550a9bc3b4cd3b..5497c53e1aa15a4e015312319d29d2a6acfe5dca 100644
--- a/src/main/java/io/papermc/paper/oneiric/OneiricTickEventGate.java
+++ b/src/main/java/io/papermc/paper/oneiric/OneiricTickEventGate.java
@@ -16,85 +16,96 @@ import java.util.concurrent.atomic.AtomicLong;
  * 并发 {@code add} 会把索引推到数组外。实测 spark 在正式服每分钟抛
  * 837 次 {@code ArrayIndexOutOfBoundsException}。</p>
  *
- * <h2>为什么不用 tick 计数器</h2>
+ * <h2>每个 tick 的代际从哪里来</h2>
  *
- * <p>试过两条路，都不成立：</p>
+ * <p>用 {@link io.papermc.paper.threadedregions.RegionizedServer#getGlobalTickData()
+ * RegionizedServer 的全局 tick 句柄}：{@code GlobalTickTickHandle} 是一个<b>独立于区域
+ * tick 的调度任务</b>，每 tick 只跑一次，它的 {@code getCurrentTick()} 才是真正的全局 tick。</p>
+ *
+ * <p>踩过的两个坑（都记在这里，避免以后有人改回去）：</p>
  * <ul>
  *   <li>{@code RegionizedServer.getCurrentTick()} 返回的是<b>当前区域</b>的 tick，
- *       而且在没有区域上下文时抛异常。不同区域的 currentTick 在同一全局 tick 内
- *       可能不同，用它做代际会漏放或重复放行。</li>
+ *       而且没有区域上下文时抛异常。不同区域的 currentTick 在同一全局 tick 内可能不同。</li>
  *   <li>{@code RegionizedServer.tickCount} 在 {@code globalTick} 里递增，
- *       而 {@code globalTick} 是<b>每个区域每 tick</b> 都调一次的 ——
- *       它同样随区域数量增长，也不能当全局 tick 用。</li>
+ *       而 {@code globalTick} 是<b>每个区域每 tick</b> 都调一次的 —— 同样随区域数量增长。</li>
  * </ul>
  *
- * <h2>实际做法：按真实时间分桶</h2>
- *
- * <p>用 {@link System#nanoTime()} 除以目标 tick 周期得到「时间桶编号」，
- * 同一个桶内只放行一次。这与「每个 server tick 一次」在语义上等价
- * （目标 tick 周期就是 50ms），但不依赖任何区域的 tick 计数，
- * 也不会因为区域数变化而漂移。</p>
+ * <h2>为什么还要时间兜底</h2>
  *
- * <p>放行的是「第一个到达的线程」，不是「server 主线程」—— Folia 里
- * 区域 tick 本来就不在 server 线程上跑，强行回到 server 线程会引入跨线程调度。</p>
+ * <p>全局 tick 句柄在服务器启动的最初几个 tick 里可能还没开始推进
+ * （{@code setInitialStart} 之后才调度）。若此时正好有区域在 tick，
+ * 全局 tick 会一直停在同一个值，闸门就会把所有事件都挡住。
+ * 所以代际取「全局 tick 与 50ms 时间桶的较大者」：正常情况下两者同步推进，
+ * 启动瞬间由时间桶兜底放行。</p>
  */
 public final class OneiricTickEventGate {
 
     /** 目标 tick 周期（纳秒）。20 TPS = 50ms。 */
     private static final long TICK_NANOS = 50_000_000L;
-    /** 连续两个桶被视为「同一 tick」的容差，避免 49.9ms / 50.1ms 跨桶抖动。 */
+
+    /** 连续两个事件被视为「同一 tick」的容差，避免恰好跨桶的抖动。 */
     private static final long WINDOW_NANOS = TICK_NANOS + TICK_NANOS / 2;
 
-    private static final AtomicLong LAST_START = new AtomicLong(Long.MIN_VALUE);
-    private static final AtomicLong LAST_END = new AtomicLong(Long.MIN_VALUE);
+    private static final AtomicLong LAST_START_TICK = new AtomicLong(Long.MIN_VALUE);
+    private static final AtomicLong LAST_END_TICK = new AtomicLong(Long.MIN_VALUE);
+    private static final AtomicLong LAST_START_NANOS = new AtomicLong(Long.MIN_VALUE);
+    private static final AtomicLong LAST_END_NANOS = new AtomicLong(Long.MIN_VALUE);
 
     private OneiricTickEventGate() {
     }
 
-    /** 当前时间桶（单调）。 */
-    private static long bucket() {
-        return System.nanoTime() / TICK_NANOS;
+    /** 全局 tick；句柄未就绪时退回时间桶。 */
+    private static long generation() {
+        try {
+            final long tick = io.papermc.paper.threadedregions.RegionizedServer.getGlobalTickData().getCurrentTick();
+            // tick 为 0 说明 GlobalTickTickHandle 还没开始推进，用时间桶兜底。
+            if (tick > 0) {
+                return tick;
+            }
+        } catch (final Throwable ignored) {
+            // 全局 tick 句柄在极早期可能尚未初始化。
+        }
+        return Long.MIN_VALUE;
     }
 
-    /**
-     * start 事件是否应放行。
-     *
-     * <p>用 CAS 推进「最后一次放行的时间戳」：只有当当前时间距上次放行
-     * 超过 {@link #WINDOW_NANOS} 时才放行。并发调用中只有一个线程能成功推进，
-     * 其余直接返回 false。</p>
-     */
     public static boolean allowStart() {
-        return allow(LAST_START);
+        return allow(LAST_START_TICK, LAST_START_NANOS);
     }
 
-    /** 同 {@link #allowStart()}，用于 end 事件。 */
     public static boolean allowEnd() {
-        return allow(LAST_END);
+        return allow(LAST_END_TICK, LAST_END_NANOS);
     }
 
-    private static boolean allow(final AtomicLong last) {
+    private static boolean allow(final AtomicLong lastTick, final AtomicLong lastNanos) {
         final long now = System.nanoTime();
-        while (true) {
-            final long prev = last.get();
-            // 时间戳未初始化时直接放行（服务器刚启动）。
-            if (prev != Long.MIN_VALUE && now - prev < WINDOW_NANOS) {
+        final long gen = generation();
+
+        if (gen != Long.MIN_VALUE) {
+            // 主路径：同一全局 tick 内只放行一次。
+            final long prev = lastTick.get();
+            if (prev == gen) {
                 return false;
             }
-            if (last.compareAndSet(prev, now)) {
+            if (lastTick.compareAndSet(prev, gen)) {
+                lastNanos.set(now);
                 return true;
             }
+            return false;
         }
+
+        // 兜底路径：全局 tick 尚不可用，按真实时间分桶。
+        final long prev = lastNanos.get();
+        if (prev != Long.MIN_VALUE && now - prev < WINDOW_NANOS) {
+            return false;
+        }
+        return lastNanos.compareAndSet(prev, now);
     }
 
     /** 状态行用。 */
     public static String status() {
-        final long now = System.nanoTime();
-        return "tick-event-gate(bucket=" + bucket()
-            + " startAge=" + msAge(now, LAST_START.get()) + "ms"
-            + " endAge=" + msAge(now, LAST_END.get()) + "ms)";
-    }
-
-    private static String msAge(final long now, final long then) {
-        return then == Long.MIN_VALUE ? "never" : Long.toString((now - then) / 1_000_000L);
+        final long gen = generation();
+        return "tick-event-gate(globalTick=" + (gen == Long.MIN_VALUE ? "n/a" : Long.toString(gen))
+            + " startTick=" + LAST_START_TICK.get()
+            + " endTick=" + LAST_END_TICK.get() + ")";
     }
 }
