index 0000000000000000000000000000000000000000..372f7c96f7ffb37559d3b9670bf456111baba8e2
--- /dev/null
+++ b/src/main/java/org/leavesmc/leaves/command/PhotographerCommand.java
@@ -0,0 +1,139 @@
+package org.leavesmc.leaves.command;
+
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import org.bukkit.Bukkit;
+import org.bukkit.Location;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+import org.jetbrains.annotations.NotNull;
+import org.leavesmc.leaves.replay.ServerPhotographer;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Oneiric - {@code /photographer} 命令：创建/移除摄影师（回放录制）。
+ *
+ * <p>移植自 LeavesMC/Leaves（GPLv3）的 PhotographerCommand，简化为 Bukkit Command
+ * （与 /counter、/oneiric 同一注册方式）。</p>
+ *
+ * <p>创建必须在**目标位置**的 region 上调度（Folia），创建接口内部已处理；
+ * 移除同样按摄影师所在 region 调度。</p>
+ */
+public final class PhotographerCommand extends Command {
+
+    public static final String NAME = "photographer";
+
+    public PhotographerCommand() {
+        super(NAME);
+        this.setPermission("oneiric.commands.photographer");
+        this.setDescription("Create a replay photographer");
+        this.setUsage("/photographer create <id> | remove <id> | list");
+    }
+
+    public static void register() {
+        try {
+            org.bukkit.Bukkit.getCommandMap().register("oneiric", NAME, new PhotographerCommand());
+        } catch (final Throwable t) {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                "[Oneiric] 注册 /{} 命令失败（不影响启动）: {}", NAME, t.toString());
+        }
+    }
+
+    @Override
+    public boolean execute(@NotNull final CommandSender sender, @NotNull final String label,
+                           @NotNull final String[] args) {
+        if (!testPermission(sender)) {
+            return true;
+        }
+
+        if (args.length == 0) {
+            sender.sendMessage(Component.text(this.getUsage(), NamedTextColor.GRAY));
+            return true;
+        }
+
+        switch (args[0].toLowerCase(Locale.ROOT)) {
+            case "create" -> {
+                if (!(sender instanceof Player player)) {
+                    sender.sendMessage(Component.text("只能由玩家创建（需要在目标位置生成）", NamedTextColor.RED));
+                    return true;
+                }
+                if (args.length < 2) {
+                    sender.sendMessage(Component.text("用法: /photographer create <id>", NamedTextColor.RED));
+                    return true;
+                }
+                final String id = args[1];
+                final Location loc = player.getLocation();
+                ServerPhotographer.PhotographerCreateState state =
+                    new ServerPhotographer.PhotographerCreateState(loc, id, org.leavesmc.leaves.replay.RecorderOption.createDefaultOption());
+                try {
+                    ServerPhotographer.createPhotographer(state);
+                    sender.sendMessage(Component.text("摄影师 " + id + " 创建中（0.07+）", NamedTextColor.AQUA));
+                } catch (Exception e) {
+                    sender.sendMessage(Component.text("创建失败: " + e.getMessage(), NamedTextColor.RED));
+                }
+                return true;
+            }
+            case "remove" -> {
+                if (args.length < 2) {
+                    sender.sendMessage(Component.text("用法: /photographer remove <id>", NamedTextColor.RED));
+                    return true;
+                }
+                final ServerPhotographer photographer = ServerPhotographer.getPhotographer(args[1]);
+                if (photographer == null) {
+                    sender.sendMessage(Component.text("找不到摄影师 " + args[1], NamedTextColor.RED));
+                    return true;
+                }
+                photographer.remove(false, true);
+                sender.sendMessage(Component.text("摄影师 " + args[1] + " 已移除并保存", NamedTextColor.AQUA));
+                return true;
+            }
+            case "list" -> {
+                final List<ServerPhotographer> list = ServerPhotographer.getPhotographers();
+                sender.sendMessage(Component.text("摄影师数量: " + list.size(), NamedTextColor.AQUA));
+                for (final ServerPhotographer photographer : list) {
+                    sender.sendMessage(Component.text(
+                        "- " + photographer.createState.id + " @ " + photographer.serverLevel().getWorld().getName()
+                            + " (" + photographer.getX() + ", " + photographer.getY() + ", " + photographer.getZ() + ")",
+                        NamedTextColor.GRAY));
+                }
+                return true;
+            }
+            default -> sender.sendMessage(Component.text(this.getUsage(), NamedTextColor.RED));
+        }
+        return true;
+    }
+
+    @Override
+    public @NotNull List<String> tabComplete(@NotNull final CommandSender sender, @NotNull final String alias,
+                                             @NotNull final String[] args) {
+        if (!testPermissionSilent(sender)) {
+            return Collections.emptyList();
+        }
+        if (args.length == 1) {
+            final String prefix = args[0].toLowerCase(Locale.ROOT);
+            final List<String> out = new ArrayList<>();
+            for (final String base : new String[]{"create", "remove", "list"}) {
+                if (base.startsWith(prefix)) {
+                    out.add(base);
+                }
+            }
+            return out;
+        }
+        if (args.length == 2 && args[0].equalsIgnoreCase("remove")) {
+            final String prefix = args[1].toLowerCase(Locale.ROOT);
+            final List<String> out = new ArrayList<>();
+            for (final ServerPhotographer photographer : ServerPhotographer.getPhotographers()) {
+                if (photographer.createState.id.toLowerCase(Locale.ROOT).startsWith(prefix)) {
+                    out.add(photographer.createState.id);
+                }
+            }
+            return out;
+        }
+        return Collections.emptyList();
+    }
+}
