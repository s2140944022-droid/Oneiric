+package org.leavesmc.leaves.replay;
+
+import net.minecraft.network.Connection;
+import net.minecraft.network.protocol.Packet;
+import net.minecraft.network.protocol.PacketFlow;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.network.CommonListenerCookie;
+import net.minecraft.server.network.ServerGamePacketListenerImpl;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * Oneiric - 摄影师的包监听器。
+ *
+ * <p>send() 不重写：数据包经 Connection.send 进入 {@link Recorder} 被记录。
+ * tick() 置空：假连接没有 keepalive 应答，跑原版 tick 会被"超时"踢掉。</p>
+ *
+ * <p>移植模式来自 LeavesMC/Leaves 的 ServerBotPacketListenerImpl（GPLv3）。</p>
+ */
+public class ServerPhotographerPacketListenerImpl extends ServerGamePacketListenerImpl {
+
+    public ServerPhotographerPacketListenerImpl(MinecraftServer server, Connection connection, ServerPhotographer player) {
+        super(server, connection, player, CommonListenerCookie.createInitial(player.gameProfile, false));
+    }
+
+    // Oneiric - 1.21.1 的父类没有 send(Packet, ChannelFutureListener)/disconnect(DisconnectionDetails)/
+    // isAcceptingMessages/hasClientLoaded 的可覆盖签名（它们是 Leaves 26.x 加的），只保留 tick 置空：
+    // 不跑 keepalive，假连接就不会被"超时"踢掉。数据包走 Connection.send 进入 Recorder 被记录。
+
+    @Override
+    public void tick() {
+        // no-op：不处理移动、不跑 keepalive。数据包捕获在 Recorder（Connection 层）。
+    }
+
+    @Override
+    public void disconnect(@NotNull net.minecraft.network.DisconnectionDetails disconnectionInfo, org.bukkit.event.player.PlayerKickEvent.Cause cause) {
+        // no-op：摄影师的移除走 removePhotographer，不走断线流程
+    }
+}
