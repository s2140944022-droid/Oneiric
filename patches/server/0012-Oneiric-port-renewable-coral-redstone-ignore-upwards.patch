+import com.google.gson.JsonSerializer;
+import org.jetbrains.annotations.NotNull;
+
+import java.lang.reflect.Type;
+import java.util.UUID;
+
+/** Oneiric - 移植自 LeavesMC/Leaves（GPLv3）。 */
+public class UUIDSerializer implements JsonSerializer<UUID> {
+    @Override
+    public JsonElement serialize(@NotNull UUID src, Type typeOfSrc, @NotNull com.google.gson.JsonSerializationContext context) {
+        return new JsonPrimitive(src.toString());
+    }
