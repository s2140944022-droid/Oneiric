+/**
+ * Oneiric - 录制选项。移植自 LeavesMC/Leaves（GPLv3）。
+ *
+ * <p>与 Leaves 的差异：BukkitRecorderOption 是 API 侧转换入口，随 API 层一并提供，
+ * 服务端内部先只用 {@link #createDefaultOption()}。</p>
+ */
+public class RecorderOption {
+
+    public int recordDistance = -1;
+    public String serverName = "Oneiric";
+    public RecordWeather forceWeather = null;
+    public int forceDayTime = -1;
+    public boolean ignoreChat = false;
+    public boolean ignoreItem = false;
+
+    @NotNull
