diff --git a/src/main/java/org/leavesmc/leaves/entity/BotApi.java b/src/main/java/org/leavesmc/leaves/entity/BotApi.java
new file mode 100644
index 0000000000000000000000000000000000000000..c0eb38a9a115c170d1c3b7254b290d726eda26ad
--- /dev/null
+++ b/src/main/java/org/leavesmc/leaves/entity/BotApi.java
@@ -0,0 +1,67 @@
+package org.leavesmc.leaves.entity;
+
+import org.bukkit.Bukkit;
+import org.bukkit.entity.Player;
+import org.checkerframework.checker.nullness.qual.NonNull;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * Oneiric - 假玩家 API 的静态入口。
+ *
+ * <h2>为什么需要这个桥</h2>
+ *
+ * <p>Leaves 把 {@code getBotManager()} 加在 {@code org.bukkit.Server} 与 {@code Bukkit} 上，
+ * 那是靠 <b>patches/api</b> 改 API 模块实现的。Oneiric 的 {@code patches/api} 是空的
+ * （API 模块保持上游 Folia/Luminol 原样），因此没有 {@code Bukkit.getBotManager()}。</p>
+ *
+ * <p>但插件是照着 Leaves 的接口写的 —— 它们会调 {@code Bukkit.getBotManager()}。
+ * 与其改所有插件，这里提供一个同形的静态方法：把 {@code Bukkit.getBotManager()}
+ * 机械替换成 {@code BotApi.getBotManager()} 即可，方法签名与返回类型完全一致。</p>
+ *
+ * <p>注意：没有任何"改名偷偷拦截"的做法 —— 做不到就是做不到，这里明写着差异。</p>
+ */
+public final class BotApi {
+
+    private BotApi() {
+    }
+
+    /** 与 Leaves 的 {@code Bukkit#getBotManager()} 等价。 */
+    public static @NonNull BotManager getBotManager() {
+        final org.bukkit.Server server = Bukkit.getServer();
+        if (server instanceof org.bukkit.craftbukkit.CraftServer craftServer) {
+            return craftServer.getBotManager();
+        }
+        throw new UnsupportedOperationException("Bot API is only available on Oneiric");
+    }
+
+    /**
+     * 与 Leaves 的 {@code Bukkit#getBot(String)} / {@code getBot(UUID)} 等价。
+     *
+     * @param name bot 名（区分大小写无关）
+     * @return bot，不存在时 {@code null}
+     */
+    public static @Nullable Bot getBot(final String name) {
+        return getBotManager().getBot(name);
+    }
+
+    /** 与 Leaves 的 {@code Bukkit#getBot(UUID)} 等价。 */
+    public static @Nullable Bot getBot(final java.util.UUID uuid) {
+        return getBotManager().getBot(uuid);
+    }
+
+    /**
+     * 与 Leaves 的 {@code Bukkit#getOnlinePlayers()} 在 bot 语义上的对应物。
+     *
+     * <p>Leaves 里 bot 也在 {@code Bukkit.getOnlinePlayers()} 中（因为它们是 ServerPlayer）。
+     * Oneiric 保持同样的行为：bot 会出现在 {@code getOnlinePlayers()} 里，
+     * 但 {@code Server#getOnlinePlayers} 的 {@code playerView} 只看 realPlayers。</p>
+     */
+    public static java.util.Collection<Bot> getBots() {
+        return getBotManager().getBots();
+    }
+
+    /** 便捷判断：这个 Bukkit 玩家是不是假玩家。 */
+    public static boolean isBot(final Player player) {
+        return player instanceof Bot;
+    }
+}
