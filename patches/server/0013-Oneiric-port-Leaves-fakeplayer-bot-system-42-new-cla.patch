+    // Oneiric start - 假玩家
+    protected void setBotList(final org.leavesmc.leaves.bot.BotList botList) {
+        this.botList = botList;
+    }
+
+    /**
+     * Oneiric - 假玩家表。
+     *
+     * <p>不返回 null：{@code tickChildren} / 停服 / PlayerList 都会无条件调用它。
+     * DedicatedServer 启动时会显式 {@code setBotList}；这里的惰性创建只是兜底
+     * （例如单元测试里的 MinecraftServer 子类），避免一句 NPE 打断整个 tick 循环。</p>
+     */
+    public org.leavesmc.leaves.bot.BotList getBotList() {
+        org.leavesmc.leaves.bot.BotList list = this.botList;
+        if (list == null) {
+            // 兜底路径会被多个区域线程并发命中（PlayerList#placeNewPlayer 在区域线程上），
+            // 而 BotList 构造器会写静态 INSTANCE —— 必须串行，否则会造出两个实例。
+            synchronized (this) {
+                list = this.botList;
+                if (list == null) {
+                    list = new org.leavesmc.leaves.bot.BotList(this);
+                    this.botList = list;
+                }
+            }
+        }
+        return list;
+    }
+    // Oneiric end - 假玩家
+
