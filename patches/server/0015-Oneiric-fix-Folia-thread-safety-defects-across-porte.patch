@@ -304,6 +304,53 @@ public class BotCommand extends Command {
         botList.removeBot(bot, BotRemoveEvent.RemoveReason.COMMAND, sender, false);
     }
 
+    /**
+     * Oneiric - 在 bot 所属区域线程上排定"延迟移除"。
+     *
+     * <p>返回值和 {@code removeTaskId} 的语义沿用 Leaves 的 {@code int}（-1 = 无任务），
+     * 但内部持有的是 Folia 的 {@link io.papermc.paper.threadedregions.scheduler.ScheduledTask}。用一个
+     * 自增 id 映射到任务，取消时按 id 找回 —— 这样字段类型不用改，Leaves 的
+     * 检查点（{@code == -1}）也全都继续成立。</p>
+     */
+    private static final Map<Integer, io.papermc.paper.threadedregions.scheduler.ScheduledTask> REMOVE_TASKS =
+            new java.util.concurrent.ConcurrentHashMap<>();
+    private static final java.util.concurrent.atomic.AtomicInteger REMOVE_TASK_IDS =
+            new java.util.concurrent.atomic.AtomicInteger();
+
+    private static int scheduleRemove(ServerBot bot, BotList botList, CommandSender sender, long delayTicks) {
+        final int id = REMOVE_TASK_IDS.incrementAndGet();
+        final io.papermc.paper.threadedregions.scheduler.ScheduledTask task = Bukkit.getRegionScheduler().runDelayed(
+            MinecraftInternalPlugin.INSTANCE, bot.getLocation(), t -> {
+                REMOVE_TASKS.remove(id);
+                bot.removeTaskId = -1;
+                botList.removeBot(bot, BotRemoveEvent.RemoveReason.COMMAND, sender, false);
+            }, Math.max(1L, delayTicks));
+        REMOVE_TASKS.put(id, task);
+        return id;
+    }
+
+    private static void cancelRemoveTask(ServerBot bot) {
+        cancelScheduledRemoval(bot);
+    }
+
+    /**
+     * Oneiric - 取消 bot 的"定时移除"，供 {@link BotList#removeBot} 复用。
+     *
+     * <p>{@code removeTaskId} 的 id 是我们自己发的，任务对象在 {@link #REMOVE_TASKS} 里；
+     * 不能用 {@code Bukkit.getScheduler().cancelTask(id)} —— 那是另一套 id 空间。</p>
+     */
+    public static void cancelScheduledRemoval(ServerBot bot) {
+        final int id = bot.removeTaskId;
+        if (id == -1) {
+            return;
+        }
+        final io.papermc.paper.threadedregions.scheduler.ScheduledTask task = REMOVE_TASKS.remove(id);
+        if (task != null) {
+            task.cancel();
+        }
+        bot.removeTaskId = -1;
+    }
+
     private void onAction(CommandSender sender, String @NotNull [] args) {
         if (!LeavesConfig.fakeplayerUseAction) {
             return;
