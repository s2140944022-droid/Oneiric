                     return;
                 }
-                Bukkit.getScheduler().cancelTask(bot.removeTaskId);
-                bot.removeTaskId = -1;
+                cancelRemoveTask(bot);
                 sender.sendMessage(text("Remove cancel"));
                 return;
             }
@@ -289,12 +288,13 @@ public class BotCommand extends Command {
             boolean isReschedule = bot.removeTaskId != -1;
 
             if (isReschedule) {
-                Bukkit.getScheduler().cancelTask(bot.removeTaskId);
+                cancelRemoveTask(bot);
             }
-            bot.removeTaskId = Bukkit.getScheduler().runTaskLater(MinecraftInternalPlugin.INSTANCE, () -> {
-                bot.removeTaskId = -1;
-                botList.removeBot(bot, BotRemoveEvent.RemoveReason.COMMAND, sender, false);
-            }, time).getTaskId();
+            // Oneiric - 与 Leaves 的差异：Leaves 用 Bukkit.getScheduler().runTaskLater，
+            // 那在 Folia 上由**全局线程**执行，回调里再去动 bot 状态就是跨区写，
+            // 且 removeTaskId 变成全局线程写、区域线程读的普通 int。
+            // 这里改用 bot 所属区域的调度器，回调直接落在正确的线程上。
+            bot.removeTaskId = scheduleRemove(bot, botList, sender, time);
 
