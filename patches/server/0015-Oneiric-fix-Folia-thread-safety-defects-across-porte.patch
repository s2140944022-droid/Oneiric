     }
+
+    /**
+     * Oneiric - Folia 版粘贴：<b>逐区块投递到该区块所属的区域线程</b>。
+     *
+     * <h2>为什么不能直接用 {@link #pasteTo}</h2>
+     *
+     * <p>{@code placeToWorldWithinChunk} 会 {@code world.setBlock(...)}、
+     * {@code world.addFreshEntity(...)}、往区块的 tick 队列排任务 —— 全是区域状态。
+     * 一个 Litematic 往往横跨多个区块，而 Folia 里相邻区块可能属于<b>不同</b>的区域线程。
+     * 在一个线程上把整片区域写完，等于跨区写别人的区块：轻则丢方块，重则死锁在区块锁上。</p>
+     *
+     * <p>所以这里按 {@link ChunkPos} 拆开，每个区块投递到自己的区域。
+     * {@code done} 在<b>所有</b>区块都写完后再触发一次（用于给玩家发提示）。</p>
+     *
+     * @param done 全部区块完成后的回调，可为 {@code null}
+     */
+    public void pasteToFolia(ServerLevel serverWorld, ReplaceBehavior replaceBehavior, @Nullable Runnable done) {
+        final Box enclosingBox = this.getEnclosingBox();
+        if (enclosingBox == null || enclosingBox.pos1() == null || enclosingBox.pos2() == null) {
+            ServuxProtocol.LOGGER.error("receiver a null enclosing box");
+            return;
+        }
+
+        final java.util.List<ChunkPos> chunks =
+                streamChunkPos(Objects.requireNonNull(enclosingBox.toVanilla())).toList();
+        if (chunks.isEmpty()) {
+            if (done != null) {
+                done.run();
+            }
+            return;
+        }
+
+        final java.util.concurrent.atomic.AtomicInteger remaining =
+                new java.util.concurrent.atomic.AtomicInteger(chunks.size());
+        final java.util.concurrent.atomic.AtomicReference<Throwable> failure =
+                new java.util.concurrent.atomic.AtomicReference<>();
+
+        for (final ChunkPos chunkPos : chunks) {
+            try {
+                org.bukkit.Bukkit.getRegionScheduler().execute(
+                    org.leavesmc.leaves.plugin.MinecraftInternalPlugin.INSTANCE,
+                    serverWorld.getWorld(), chunkPos.x, chunkPos.z,
+                    () -> {
+                        try {
+                            SchematicPlacingUtils.placeToWorldWithinChunk(
+                                serverWorld, chunkPos, this, replaceBehavior, false);
+                        } catch (final Throwable t) {
+                            failure.compareAndSet(null, t);
+                        } finally {
+                            if (remaining.decrementAndGet() == 0 && done != null) {
+                                if (failure.get() != null) {
+                                    org.leavesmc.leaves.LeavesLogger.LOGGER.warn(
+                                        "Litematic paste failed in chunk {},{}", chunkPos.x, chunkPos.z, failure.get());
+                                }
+                                done.run();
+                            }
+                        }
+                    });
+            } catch (final RuntimeException rejected) {
+                // 区域已卸载 / 调度器关闭：把这个区块算作完成，避免计数永远等不到 0
+                failure.compareAndSet(null, rejected);
+                if (remaining.decrementAndGet() == 0 && done != null) {
+                    done.run();
+                }
+            }
+        }
+    }
 }
