         }
 
         public void spawnWithSkin(Consumer<Bot> consumer) {
+            // 拉皮肤是网络 I/O，必须在异步线程做（否则会卡住调用它的区域线程）
             Bukkit.getScheduler().runTaskAsynchronously(MinecraftInternalPlugin.INSTANCE, () -> {
                 this.mojangAPISkin();
-                Bukkit.getScheduler().runTask(MinecraftInternalPlugin.INSTANCE, () -> {
-                    CraftBot bot = this.spawn();
-                    if (bot != null && consumer != null) {
-                        consumer.accept(bot);
-                    }
-                });
+                // Oneiric - 与 Leaves 的差异：Leaves 这里用 Bukkit.getScheduler().runTask()，
+                // 那是全局线程；然后 createNewBot 发现自己不在目标区域、投递后返回 null，
+                // 于是 consumer 永远不会被调用。
+                //
+                // 这里直接投递到目标位置所属的区域线程：spawn() 会在正确的线程上完成，
+                // 返回值就是真正的 bot，consumer 才真的能收到回调。
+                final Location at = this.location;
+                if (at == null) {
+                    return;
+                }
+                try {
+                    Bukkit.getRegionScheduler().execute(MinecraftInternalPlugin.INSTANCE, at, () -> {
+                        final CraftBot bot = this.spawn();
+                        if (bot != null && consumer != null) {
+                            consumer.accept(bot);
+                        }
+                    });
+                } catch (final RuntimeException rejected) {
+                    org.leavesmc.leaves.LeavesLogger.LOGGER.warn("Failed to schedule bot spawn at " + at, rejected);
+                }
             });
         }
 
