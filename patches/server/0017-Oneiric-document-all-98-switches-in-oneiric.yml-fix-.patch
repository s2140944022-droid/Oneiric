@@ -99,11 +99,22 @@ public final class OneiricYml {
     /**
      * 解析 {@code switches:} 段。**只接受平铺结构**。
      *
-     * <p>缩进比 {@code switches:} 更深、且形如 {@code 名字: true|false} 的行会被采纳；
-     * 以 {@code #} 开头的行整体忽略（注释）；非布尔的键忽略（本类不处理参数键）。</p>
