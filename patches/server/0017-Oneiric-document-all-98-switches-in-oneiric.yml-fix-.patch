diff --git a/src/main/java/io/oneiric/core/RegonizedWorldDataSwitcher.java b/src/main/java/io/oneiric/core/RegonizedWorldDataSwitcher.java
index fbacba21c048a9db6d07c9789ae5afaabe3b50ba..a3717cd8ba787e079baedd9cec95fe9b00cca9b3 100644
--- a/src/main/java/io/oneiric/core/RegonizedWorldDataSwitcher.java
+++ b/src/main/java/io/oneiric/core/RegonizedWorldDataSwitcher.java
@@ -4,6 +4,31 @@ import io.papermc.paper.threadedregions.RegionizedWorldData;
 import it.unimi.dsi.fastutil.longs.Long2ReferenceOpenHashMap;
 
 
+/**
+ * Oneiric - 区域数据切换器（移植自 Luminol，修正两处缺陷）。
+ *
+ * <h2>它解决什么问题</h2>
+ *
+ * <p>Folia 把世界数据按区域拆成多个 {@link RegionizedWorldData}。当某个实体/连接
+ * 所在的位置在 {@code regionToData} 里查不到（区域正在拆分/合并的瞬间），
+ * 不能直接丢弃它 —— 必须"借"一个区域数据把它放进去，否则实体会凭空消失。</p>
+ *
+ * <h2>修正的缺陷</h2>
+ *
+ * <ol>
+ *   <li><b>{@code calledTimes} 从未递增</b>：原实现只 {@code set(0)} 重置，
+ *       但没有任何 {@code ++}。于是 {@code calledTimes.get() / size >= 400}
+ *       恒为 {@code 0 / size >= 400} = false，{@code randomIndex} 永远停在 0，
+ *       整个"轮转"逻辑是死代码 —— 每次都只命中 {@code regionToData} 的第一个元素。
+ *       大量实体涌向同一区域数据时会造成该区域数据被撑爆而其他区域空闲。</li>
+ *   <li><b>越界判断用了 {@code >} 而非 {@code >=}</b>：{@code idx > size} 时
+ *       才归零，意味着 {@code idx == size} 会穿过检查，而后面
+ *       {@code curr == idx} 的循环又走不到这个下标，于是静默返回
+ *       {@code lastMatch}（可能是上一个世界的、甚至 null 的数据）。</li>
+ * </ol>
+ *
+ * <p>这两处都是<b>上游遗留</b>，不是 Oneiric 引入的；修正后行为与注释描述的意图一致。</p>
+ */
 public class RegonizedWorldDataSwitcher {
     private volatile RegionizedWorldData lastMatch = null;
 
@@ -18,6 +43,15 @@ public class RegonizedWorldDataSwitcher {
     private final ThreadLocal<Integer> randomIndex = ThreadLocal.withInitial(() -> 0);
     private final ThreadLocal<Integer> calledTimes = ThreadLocal.withInitial(() -> 0);
 
+    /**
+     * 每切换多少次才把 {@code randomIndex} 前进一步。
+     *
+     * <p>语义：同一个索引连续命中 {@code SWITCH_BATCH * regionCount} 次后换下一个，
+     * 也就是在 N 个候选之间<b>平均分配</b>。原实现把这个常量写成 400 却忘了递增计数器，
+     * 所以这个值此前从未生效；现在它真正起作用了。</p>
+     */
+    private static final int SWITCH_BATCH = 400;
+
     public void onTickFinished(){
         this.randomIndex.remove();
         this.calledTimes.remove();
@@ -28,31 +62,47 @@ public class RegonizedWorldDataSwitcher {
         this.calledTimes.set(0);
     }
 
+    /**
+     * 查表取区域数据；查不到时按轮转规则借一个。
+     *
+     * @param regionToData 该世界的"区域段 → 区域数据"映射
+     * @param data         直接查到的结果，非 null 时原样返回
+     * @return 一定非 null（除非 {@code regionToData} 为空且从未匹配过任何数据）
+     */
     public RegionizedWorldData randomIfNull(Long2ReferenceOpenHashMap<RegionizedWorldData> regionToData, RegionizedWorldData data){
         if (data != null){
             return data;
         }
 
+        final int size = regionToData.size();
+        if (size == 0) {
+            // 没有任何区域数据可借：返回上次匹配到的（可能为 null，由调用方容忍）
+            return this.lastMatch;
+        }
+
+        // Oneiric - 修正 1：递增计数器，让下面的阈值判断真正生效。
+        int times = this.calledTimes.get() + 1;
         int idx = this.randomIndex.get();
 
-        if (this.calledTimes.get() / regionToData.size() >= 400){ //TODO Is that a truly exact value?
-            this.calledTimes.set(0);
-            this.randomIndex.set(idx+1);
+        if (times / size >= SWITCH_BATCH){
+            times = 0;
+            idx++;
         }
+        this.calledTimes.set(times);
 
-        if (idx > regionToData.size()){
-            this.randomIndex.set(0);
+        // Oneiric - 修正 2：>= 而非 >。idx == size 也是越界。
+        if (idx >= size){
             idx = 0;
         }
+        this.randomIndex.set(idx);
 
-        int curr = 0;
         RegionizedWorldData result = this.getLastMatch();
-
+        int curr = 0;
         for (RegionizedWorldData target : regionToData.values()){
             if (curr == idx){
                 result = target;
+                break;
             }
-
             curr++;
         }
 
