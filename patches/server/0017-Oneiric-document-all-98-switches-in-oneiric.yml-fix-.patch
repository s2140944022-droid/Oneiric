+     * （{@code Boolean.parseBoolean} 对 "true"/"false" 的行为一致）。</p>
      */
-    static Map<String, Boolean> parse(final Path file) throws IOException {
-        final Map<String, Boolean> out = new LinkedHashMap<>();
+    static Map<String, String> parse(final Path file) throws IOException {
+        final Map<String, String> out = new LinkedHashMap<>();
         boolean inSwitches = false;
         int switchesIndent = -1;
 
@@ -137,12 +148,16 @@ public final class OneiricYml {
             if (hash >= 0) {
                 value = value.substring(0, hash).strip();
             }
+            // 去掉 YAML 字符串的成对引号：prefix: "Bot_"
+            if (value.length() >= 2
+                    && ((value.startsWith("\"") && value.endsWith("\""))
+                        || (value.startsWith("'") && value.endsWith("'")))) {
+                value = value.substring(1, value.length() - 1);
+            }
             if (name.isEmpty() || value.isEmpty()) {
                 continue;
             }
-            if (value.equalsIgnoreCase("true") || value.equalsIgnoreCase("false")) {
-                out.put(name, Boolean.parseBoolean(value.toLowerCase()));
-            }
+            out.put(name, value);
         }
         return out;
     }
