+    /**
+     * Oneiric - 写一个<b>非布尔</b>开关：数值或字符串。
+     *
+     * <p>与 {@link #block} 的区别只在最后一行：这里按类型决定是否需要引号。
+     * 字符串值一律加双引号，因为 {@code fakeplayer-unable-names} 这类值可能含逗号，
+     * 裸写会被 YAML 误解析成数组；而 {@link #parse} 又会把成对引号去掉，
+     * 所以加引号对读取方完全透明。</p>
+     *
+     * @param value 已格式化成字符串的值（调用方负责 {@code Integer.toString} 等）
+     * @param quote 是否需要加引号
+     */
+    private static void blockRaw(final StringBuilder sb, final String name, final String value,
+                                 final boolean quote, final String title,
+                                 final String what, final String why, final String when) {
+        sb.append("  # ").append(title).append('\n');
+        sb.append("  # 【做什么】").append(what).append('\n');
+        sb.append("  # 【默认值】").append(why).append('\n');
+        sb.append("  # 【什么时候该改】").append(when).append('\n');
+        sb.append("  ").append(name).append(": ");
+        if (quote) {
+            sb.append('"').append(value.replace("\"", "")).append('"');
+        } else {
+            sb.append(value);
+        }
+        sb.append('\n');
+    }
