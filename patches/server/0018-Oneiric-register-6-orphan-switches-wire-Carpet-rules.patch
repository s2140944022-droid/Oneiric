         // 这一段的 15 项以前只登记在 OneiricConfig.NAMES 里、没有写进 yml：
diff --git a/src/main/java/net/minecraft/server/dedicated/DedicatedServer.java b/src/main/java/net/minecraft/server/dedicated/DedicatedServer.java
index db51c7a6e721163b83afcf6f67deceb826e9f5e3..549f3a60cd441ea972dd1fc6bd897bb60960aced 100644
--- a/src/main/java/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/src/main/java/net/minecraft/server/dedicated/DedicatedServer.java
@@ -258,6 +258,15 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
             org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
                     "[Oneiric] 协议层初始化失败（不影响启动）: {}", t.toString());
         }
+        // Oneiric - 把已实现的开关登记成 Carpet 规则，让 Carpet 客户端 HUD 能看到当前值。
+        // 必须在协议层 init 之后：规则表与协议类是同一套静态状态。
+        // 以前这里没有调用，于是发给客户端的永远是空规则表。
+        try {
+            org.leavesmc.leaves.LeavesConfig.registerCarpetRules();
+        } catch (final Throwable t) {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                    "[Oneiric] Carpet 规则登记失败（不影响启动）: {}", t.toString());
+        }
         // Oneiric end
         // Purpur - Oneiric：初始化 Purpur 主配置（purpur.yml）。
         // 必须在任何世界创建**之前**：PurpurWorldConfig 在 Level 构造期就会读 PurpurConfig 的静态字段，
diff --git a/src/main/java/net/minecraft/world/item/BlockItem.java b/src/main/java/net/minecraft/world/item/BlockItem.java
index 96fb69ec6db2e7c8c728435f0c537b076259b2fb..306c67ac730c4efc6a44a7f7a2a46b3295abcb4e 100644
--- a/src/main/java/net/minecraft/world/item/BlockItem.java
+++ b/src/main/java/net/minecraft/world/item/BlockItem.java
@@ -163,6 +163,40 @@ public class BlockItem extends Item {
     @Nullable
     protected BlockState getPlacementState(BlockPlaceContext context) {
         BlockState iblockdata = this.getBlock().getStateForPlacement(context);
+        // Oneiric start - 替代方块放置（Carpet accurateBlockPlacement / Litematica easy place）
+        //
+        // 这两个解码器（CarpetAlternativeBlockPlacement / LitematicaEasyPlaceProtocol）
+        // 一直在源码树里，但**没有任何调用点** —— 等于两份死代码。
+        // 客户端按协议发来编码过的点击坐标，服务端必须在这里反解，否则朝向永远按原版算，
+        // 投影自动建造就会放错方向。
+        switch (org.leavesmc.leaves.LeavesConfig.alternativeBlockPlacement) {
+            case CARPET -> {
+                final BlockState tryState =
+                        org.leavesmc.leaves.protocol.CarpetAlternativeBlockPlacement
+                                .alternativeBlockPlacement(this.getBlock(), context);
+                if (tryState != null) {
+                    iblockdata = tryState;
+                }
+            }
+            case CARPET_FIX -> {
+                final BlockState tryState =
+                        org.leavesmc.leaves.protocol.CarpetAlternativeBlockPlacement
+                                .alternativeBlockPlacementFix(this.getBlock(), context);
+                if (tryState != null) {
+                    iblockdata = tryState;
+                }
+            }
+            case LITEMATICA -> {
+                if (iblockdata != null && this.canPlace(context, iblockdata)) {
+                    return org.leavesmc.leaves.protocol.LitematicaEasyPlaceProtocol
+                            .applyPlacementProtocol(iblockdata, context);
+                }
+            }
+            case NONE -> {
+                // 原版行为
+            }
+        }
+        // Oneiric end
 
         return iblockdata != null && this.canPlace(context, iblockdata) ? iblockdata : null;
     }
diff --git a/src/main/java/org/leavesmc/leaves/LeavesConfig.java b/src/main/java/org/leavesmc/leaves/LeavesConfig.java
index ad2a41eb3197196e094c414d1a8804f2632dd267..cd207bad256e29adb89b7de96269696aaa6f7a3a 100644
--- a/src/main/java/org/leavesmc/leaves/LeavesConfig.java
+++ b/src/main/java/org/leavesmc/leaves/LeavesConfig.java
@@ -253,6 +253,62 @@ public class LeavesConfig {
         }
     }
 
+    /**
+     * Oneiric - 把已实现的开关登记成 Carpet 规则，让 Carpet 客户端 HUD 能显示它们的当前值。
+     *
+     * <h2>为什么需要</h2>
+     *
+     * <p>{@code CarpetServerProtocol} 早就实现了规则同步通道（{@code Rules} NBT），
+     * 但**没有任何地方调用 {@code CarpetRules.register(...)}**，所以发给客户端的
+     * 永远是一张空表 —— 玩家装了 Carpet 也看不到服务器开了哪些规则。</p>
+     *
+     * <h2>只登记真的实现了的</h2>
+     *
+     * <p>这里刻意只列「有对应服务端实现」的规则。把没实现的也写进去，玩家会在 HUD 上
+     * 看到一个开着却没有任何行为的规则 —— 那比看不到更糟。</p>
+     *
+     * <p>规则名沿用 Carpet 的原名（{@code renewableCoral} 等），这样 Carpet 客户端
+     * 才能按名字匹配上；管理侧标识统一用 {@code carpet} 或 {@code pca}，与 Leaves 一致。</p>
+     */
+    public static void registerCarpetRules() {
+        registerOne("carpet", "renewableCoral", modify.oldMC.renewableCoral);
+        registerOne("carpet", "renewableCoralExpand", modify.oldMC.renewableCoralExpanded);
+        registerOne("carpet", "redstoneIgnoreUpwardsUpdate", modify.oldMC.updater.redstoneIgnoreUpwardsUpdate);
+        registerOne("carpet", "instantBlockUpdaterReintroduced", modify.oldMC.updater.instantBlockUpdaterReintroduced);
+        registerOne("carpet", "cceUpdateSuppression", modify.oldMC.updater.cceUpdateSuppression);
+        registerOne("carpet", "soundUpdateSuppression", modify.oldMC.updater.soundUpdateSuppression);
+        registerOne("carpet", "movableBuddingAmethyst", modify.movableBuddingAmethyst);
+        registerOne("carpet", "shearsWrench", modify.redstoneShearsWrench);
+        registerOne("carpet", "flattenTriangularDistribution", modify.flattenTriangularDistribution);
+        registerOne("carpet", "hopperCounters", modify.hopperCounter.enable);
+        registerOne("carpet", "hopperCountersUnlimitedSpeed", modify.hopperCounter.unlimitedSpeed);
+        registerOne("carpet", "optimizedDragonRespawn", modify.optimizedDragonRespawn);
+        registerOne("carpet", "spiderJockeysDropGapples", modify.spiderJockeysDropGapples > 0.0D);
+        registerOne("pca", "avoidAnvilTooExpensive", modify.avoidAnvilTooExpensive);
+        registerOne("pca", "sharedVillagerDiscounts", modify.sharedVillagerDiscounts);
+        registerOne("carpet", "zeroTickPlants", modify.oldMC.zeroTickPlants);
+        registerOne("carpet", "renewableDeepslate", modify.oldMC.renewableDeepslate);
+        registerOne("carpet", "renewableSponges", modify.oldMC.renewableSponges);
+        registerOne("carpet", "crafter1gt", modify.oldMC.crafter1gt);
+        registerOne("carpet", "copperBulb1gt", modify.oldMC.copperBulb1gt);
+        registerOne("carpet", "oldZombieReinforcement", modify.oldMC.oldZombieReinforcement);
+        registerOne("carpet", "oldRaidBehavior", modify.oldMC.oldRaidBehavior);
+        registerOne("carpet", "oldMinecartMotion", modify.oldMC.oldMinecartMotionBehavior);
+        registerOne("carpet", "tntWetExplosionNoItemDamage", modify.oldMC.tntWetExplosionNoItemDamage);
+        registerOne("carpet", "keepLeashConnectWhenUseFirework", modify.oldMC.keepLeashConnectWhenUseFirework);
+        registerOne("carpet", "allowInfNanMotionValues", modify.oldMC.allowInfNanMotionValues);
+        registerOne("carpet", "spawnInvulnerableTime", modify.oldMC.spawnInvulnerableTime);
+        registerOne("carpet", "spectatorDontGetAdvancement", modify.spectatorDontGetAdvancement);
+        registerOne("carpet", "stickChangeArmorStandArmStatus", modify.stickChangeArmorStandArmStatus);
+        registerOne("carpet", "snowballAndEggCanKnockback", modify.snowballAndEggCanKnockback);
+        registerOne("carpet", "disableVaultBlacklist", modify.oldMC.disableVaultBlacklist);
+    }
+
+    private static void registerOne(final String manager, final String carpetName, final boolean value) {
+        org.leavesmc.leaves.protocol.CarpetServerProtocol.CarpetRules.register(
+                org.leavesmc.leaves.protocol.CarpetServerProtocol.CarpetRule.of(manager, carpetName, value));
+    }
+
     /** 羊毛漏斗计数器。 */
     public static final class HopperCounter {
         /** 总开关：是否允许羊毛漏斗计数器工作。 */
@@ -311,6 +367,44 @@ public class LeavesConfig {
         public final boolean syncPlayerEntity = enabled("protocol-pca-sync-player");
     }
 
+    /**
+     * Oneiric - 替代方块放置（Carpet / Litematica 协议）。
+     *
+     * <p>原版放置方块时朝向由客户端"看哪里"决定；Carpet 的 accurateBlockPlacement 与
+     * Litematica 的 easy place 都是把目标状态编码进点击坐标的偏移里（协议层），
+     * 服务端要按那个偏移反推出正确朝向。{@link #type} 选择用哪套解码。</p>
+     *
+     * <p>这个配置项以前**整个缺失**：{@code CarpetAlternativeBlockPlacement} 与
+     * {@code LitematicaEasyPlaceProtocol} 两个类都在源码树里，但没有任何调用点，
+     * 等于两份死代码。补上这个开关后它们才真正生效。</p>
+     */
+    public enum AlternativePlaceType {
+        /** 关闭。 */
+        NONE,
+        /** Carpet 的 accurateBlockPlacement。 */
+        CARPET,
+        /** Carpet 的修正版（处理更多元件）。 */
+        CARPET_FIX,
+        /** Litematica 的 easy place。 */
+        LITEMATICA
+    }
+
+    /** 当前启用的替代放置模式。用 -Doneiric.alternative-block-placement=CARPET 等方式设置。 */
+    public static final AlternativePlaceType alternativeBlockPlacement = parsePlaceType(
+            OneiricConfig.stringValue("alternative-block-placement", "NONE"));
+
+    private static AlternativePlaceType parsePlaceType(final String raw) {
+        try {
+            return AlternativePlaceType.valueOf(raw.trim().toUpperCase(java.util.Locale.ROOT));
+        } catch (final IllegalArgumentException malformed) {
+            org.apache.logging.log4j.LogManager.getLogger("Oneiric").warn(
+                    "[Oneiric] oneiric.alternative-block-placement 不是合法值（{}），"
+                            + "可选 NONE/CARPET/CARPET_FIX/LITEMATICA，已按 NONE 处理", raw);
+            return AlternativePlaceType.NONE;
+        }
+    }
+
+
     public static final class Servux {
         public final boolean hudLoggerProtocol = enabled("protocol-servux-hud-logger");
         public final boolean hudMetadataProtocol = enabled("protocol-servux-hud-metadata");
diff --git a/src/main/java/org/leavesmc/leaves/command/PhotographerCommand.java b/src/main/java/org/leavesmc/leaves/command/PhotographerCommand.java
index 22a47fca14fef35b91bee66d8686a1b29c9be510..bb9f48ac1f1698eda20232f4c3056d6437bde410 100644
--- a/src/main/java/org/leavesmc/leaves/command/PhotographerCommand.java
+++ b/src/main/java/org/leavesmc/leaves/command/PhotographerCommand.java
@@ -52,6 +52,14 @@ public final class PhotographerCommand extends Command {
             return true;
         }
 
+        // Oneiric - 总开关检查。以前这里没有判断，导致 replay-mod 关了也能用；
+        // 而 replay-mod 本身又不在 NAMES 里，等于这个开关两头都失效。
