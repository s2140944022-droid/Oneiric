@@ -386,6 +409,17 @@ public final class OneiricYml {
                 "对应 Carpet 的 hopperCountersUnlimitedSpeed 规则。",
                 "默认关：它会明显改变吞吐量和时序，只有需要快速计数时打开。");
 
+        // ── ReplayMod 摄影师
