index 0000000000000000000000000000000000000000..b757f54c514ec57f00753b047349d009327e3d8a
--- /dev/null
+++ b/src/main/java/org/leavesmc/leaves/protocol/PcaSyncProtocol.java
@@ -0,0 +1,475 @@
+package org.leavesmc.leaves.protocol;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.network.codec.ByteBufCodecs;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.ChestBlock;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.properties.ChestType;
+import org.apache.commons.lang3.tuple.ImmutablePair;
+import org.apache.commons.lang3.tuple.MutablePair;
+import org.apache.commons.lang3.tuple.Pair;
+import org.jetbrains.annotations.Contract;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+import org.leavesmc.leaves.LeavesConfig;
+import org.leavesmc.leaves.LeavesLogger;
+import org.leavesmc.leaves.bot.ServerBot;
+import org.leavesmc.leaves.plugin.MinecraftInternalPlugin;
+import org.leavesmc.leaves.protocol.core.LeavesCustomPayload;
+import org.leavesmc.leaves.protocol.core.LeavesProtocol;
+import org.leavesmc.leaves.protocol.core.ProtocolHandler;
+import org.leavesmc.leaves.protocol.core.ProtocolUtils;
+import org.leavesmc.leaves.util.TagUtil;
+
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.locks.ReentrantLock;
+
+/**
+ * Oneiric - PCA（Player Chest Access）同步协议。
+ *
+ * <p>客户端装有 PCA / Carpet 的 {@code accurateBlockPlacement} 配套 mod 时，
+ * 可以"看"服务端容器的实时内容、实体 NBT。生电玩家用它调试漏斗链、比对箱子库存。</p>
+ *
+ * <h2>移植自 Leaves（GPLv3），做了三处必要改动</h2>
+ *
+ * <ol>
+ *   <li><b>26.x → 1.21.1 API</b>：{@code Identifier} → {@code ResourceLocation}，
+ *       {@code identifier()} → {@code location()}，{@code saveWithoutMetadata} 签名一致。</li>
+ *   <li><b>同步玩家实体的开关</b>：Leaves 是 6 值枚举
+ *       （{@code NOBODY/BOT/OPS/OPS_AND_SELF/EVERYONE}），Oneiric 只有
+ *       {@code protocol-pca-sync-player} 一个布尔。语义映射：<br>
+ *       关 = {@code NOBODY}（不暴露任何玩家实体）；<br>
+ *       开 = {@code OPS_AND_SELF}（只暴露 op 和自己，不把普通玩家的数据广播给别人）。
+ *       之所以不直接给 {@code EVERYONE}，是因为那等于让任何客户端都能读到任意玩家的
+ *       背包与坐标 —— 默认不该这么宽。</li>
+ *   <li><b>Folia 线程适配</b>：Leaves 把处理逻辑丢到
+ *       {@code Bukkit.getGlobalRegionScheduler()}，在 Folia 上那是<b>全局线程</b>，
+ *       而 {@code world.getBlockEntity(pos)} / {@code world.getEntity(id)} 是区域状态。
+ *       改成<b>就地执行</b> —— payload 本来就由发包玩家所在区域线程分发，
+ *       而玩家眼前的容器/实体正是该区域所属。</li>
+ * </ol>
+ */
+@LeavesProtocol.Register(namespace = "pca")
+public class PcaSyncProtocol implements LeavesProtocol {
+
+    public static final String PROTOCOL_ID = "pca";
+
+    /**
+     * Oneiric - 保护四张观察表。
+     *
+     * <p>Leaves 用单个 {@code ReentrantLock(true)}（公平锁）。在 Folia 上这些表会被
+     * <b>多个区域线程</b>同时读写（每个玩家在自己的区域里发起同步），公平锁的排队开销
+     * 在高并发下反而是负担；但改动锁的语义会引入新的正确性风险，所以这里<b>保持原样</b>，
+     * 只把表本身换成并发容器降低锁外访问的可见性问题。</p>
+     */
+    public static final ReentrantLock lock = new ReentrantLock(true);
+    public static final ReentrantLock pairLock = new ReentrantLock(true);
+
+    // send
+    private static final ResourceLocation ENABLE_PCA_SYNC_PROTOCOL = id("enable_pca_sync_protocol");
+    private static final ResourceLocation DISABLE_PCA_SYNC_PROTOCOL = id("disable_pca_sync_protocol");
+
+    // Oneiric - 并发容器：多区域线程读写
+    private static final Map<ServerPlayer, Pair<ResourceLocation, BlockPos>> playerWatchBlockPos = new ConcurrentHashMap<>();
+    private static final Map<ServerPlayer, Pair<ResourceLocation, Entity>> playerWatchEntity = new ConcurrentHashMap<>();
+    private static final Map<Pair<ResourceLocation, BlockPos>, Set<ServerPlayer>> blockPosWatchPlayerSet = new ConcurrentHashMap<>();
+    private static final Map<Pair<ResourceLocation, Entity>, Set<ServerPlayer>> entityWatchPlayerSet = new ConcurrentHashMap<>();
+    private static final MutablePair<ResourceLocation, Entity> ENTITY_PAIR = new MutablePair<>();
+    private static final MutablePair<ResourceLocation, BlockPos> BLOCK_POS_PAIR = new MutablePair<>();
+
+    @Contract("_ -> new")
+    public static ResourceLocation id(String path) {
+        return ResourceLocation.fromNamespaceAndPath(PROTOCOL_ID, path);
+    }
+
+    @ProtocolHandler.PlayerJoin
+    private static void onJoin(ServerPlayer player) {
+        if (LeavesConfig.protocol.pca.enable) {
+            enablePcaSyncProtocol(player);
+        }
+    }
+
+    @ProtocolHandler.BytebufReceiver(key = "cancel_sync_block_entity")
+    private static void cancelSyncBlockEntityHandler(ServerPlayer player, FriendlyByteBuf buf) {
+        clearPlayerWatchBlock(player);
+    }
+
+    @ProtocolHandler.BytebufReceiver(key = "cancel_sync_entity")
+    private static void cancelSyncEntityHandler(ServerPlayer player, FriendlyByteBuf buf) {
+        clearPlayerWatchEntity(player);
+    }
+
+    @ProtocolHandler.PayloadReceiver(payload = SyncBlockEntityPayload.class)
+    private static void syncBlockEntityHandler(ServerPlayer player, SyncBlockEntityPayload payload) {
+        final BlockPos pos = payload.pos;
+        final ServerLevel world = player.serverLevel();
+
+        // Oneiric - 就地执行，不跳全局线程（见类注释第 3 条）
+        {
+            final BlockState blockState = world.getBlockState(pos);
+            clearPlayerWatchData(player);
+
+            BlockEntity blockEntityAdj = null;
+            if (blockState.getBlock() instanceof ChestBlock) {
+                if (blockState.getValue(ChestBlock.TYPE) != ChestType.SINGLE) {
+                    final BlockPos posAdj = pos.relative(ChestBlock.getConnectedDirection(blockState));
+                    blockEntityAdj = getBlockEntitySafe(world, posAdj);
+                }
+            }
+
+            if (blockEntityAdj != null) {
+                updateBlockEntity(player, blockEntityAdj);
+            }
+
+            final BlockEntity blockEntity = getBlockEntitySafe(world, pos);
+            if (blockEntity != null) {
+                updateBlockEntity(player, blockEntity);
+            }
+
+            final Pair<ResourceLocation, BlockPos> pair =
+                    new ImmutablePair<>(world.dimension().location(), pos);
+            lock.lock();
+            try {
+                playerWatchBlockPos.put(player, pair);
+                blockPosWatchPlayerSet
+                        .computeIfAbsent(pair, k -> ConcurrentHashMap.newKeySet())
+                        .add(player);
+            } finally {
+                lock.unlock();
+            }
+        }
+    }
+
+    /**
+     * Oneiric - 安全取方块实体。
+     *
+     * <p>{@code world.getChunk(pos).getBlockEntity(pos)} 在区块未加载时会同步加载区块，
+     * 而这里已经在正确的区域线程上，加载是合法的 —— 但仍然要挡异常：
+     * 一个失效的坐标不该让整个包处理崩掉。</p>
+     */
+    @Nullable
+    private static BlockEntity getBlockEntitySafe(final ServerLevel world, final BlockPos pos) {
+        try {
+            return world.getChunk(pos).getBlockEntity(pos);
+        } catch (final Throwable ignored) {
+            return null;
+        }
+    }
+
+    @ProtocolHandler.PayloadReceiver(payload = SyncEntityPayload.class)
+    private static void syncEntityHandler(ServerPlayer player, SyncEntityPayload payload) {
+        final MinecraftServer server = MinecraftServer.getServer();
+        final int entityId = payload.entityId;
+        final ServerLevel world = player.serverLevel();
+
+        // Oneiric - 就地执行（同 syncBlockEntityHandler）
+        {
+            final Entity entity = world.getEntity(entityId);
+
+            if (entity != null) {
+                clearPlayerWatchData(player);
+
+                if (entity instanceof Player) {
+                    // Oneiric - 布尔开关的语义映射：开 = 只允许 op 与自己，关 = 一律不暴露。
+                    // 绝不使用 Leaves 的 EVERYONE：那会让任何客户端读到任意玩家的背包和坐标。
+                    if (!LeavesConfig.protocol.pca.syncPlayerEntity) {
+                        return;
+                    }
+                    final boolean self = entity == player;
+                    final boolean op = server.getPlayerList().isOp(player.getGameProfile());
+                    if (!self && !op) {
+                        return;
+                    }
+                }
+                updateEntity(player, entity);
+
+                final Pair<ResourceLocation, Entity> pair =
+                        new ImmutablePair<>(entity.level().dimension().location(), entity);
+                lock.lock();
+                try {
+                    playerWatchEntity.put(player, pair);
+                    entityWatchPlayerSet
+                            .computeIfAbsent(pair, k -> ConcurrentHashMap.newKeySet())
+                            .add(player);
+                } finally {
+                    lock.unlock();
+                }
+            }
+        }
+    }
+
+    public static void onConfigModify(boolean enable) {
+        if (enable) {
+            enablePcaSyncProtocolGlobal();
+        } else {
+            disablePcaSyncProtocolGlobal();
+        }
+    }
+
+    public static void enablePcaSyncProtocol(@NotNull ServerPlayer player) {
+        ProtocolUtils.sendEmptyPacket(player, ENABLE_PCA_SYNC_PROTOCOL);
+    }
+
+    public static void disablePcaSyncProtocol(@NotNull ServerPlayer player) {
+        ProtocolUtils.sendEmptyPacket(player, DISABLE_PCA_SYNC_PROTOCOL);
+    }
+
+    public static void updateEntity(@NotNull ServerPlayer player, @NotNull Entity entity) {
+        final CompoundTag nbt = TagUtil.saveEntity(entity);
+        ProtocolUtils.sendPayloadPacket(player,
+                new UpdateEntityPayload(entity.level().dimension().location(), entity.getId(), nbt));
+    }
+
+    public static void updateBlockEntity(@NotNull ServerPlayer player, @NotNull BlockEntity blockEntity) {
+        final Level world = blockEntity.getLevel();
+        if (world == null) {
+            return;
+        }
+        ProtocolUtils.sendPayloadPacket(player, new UpdateBlockEntityPayload(
+                world.dimension().location(),
+                blockEntity.getBlockPos(),
+                blockEntity.saveWithoutMetadata(world.registryAccess())));
+    }
+
+    private static MutablePair<ResourceLocation, Entity> getEntityPair(final ResourceLocation dimension,
+                                                                      final Entity entity) {
+        pairLock.lock();
+        try {
+            ENTITY_PAIR.setLeft(dimension);
+            ENTITY_PAIR.setRight(entity);
+            return ENTITY_PAIR;
+        } finally {
+            pairLock.unlock();
+        }
+    }
+
+    private static MutablePair<ResourceLocation, BlockPos> getBlockPosPair(final ResourceLocation dimension,
+                                                                          final BlockPos pos) {
+        pairLock.lock();
+        try {
+            BLOCK_POS_PAIR.setLeft(dimension);
+            BLOCK_POS_PAIR.setRight(pos);
+            return BLOCK_POS_PAIR;
+        } finally {
+            pairLock.unlock();
+        }
+    }
+
+    @Nullable
+    private static Set<ServerPlayer> getWatchPlayerList(@NotNull Entity entity) {
+        return entityWatchPlayerSet.get(getEntityPair(entity.level().dimension().location(), entity));
+    }
+
+    @Nullable
+    private static Set<ServerPlayer> getWatchPlayerList(@NotNull Level world, @NotNull BlockPos blockPos) {
+        return blockPosWatchPlayerSet.get(getBlockPosPair(world.dimension().location(), blockPos));
+    }
+
+    public static boolean syncEntityToClient(@NotNull Entity entity) {
+        if (entity.level().isClientSide()) {
+            return false;
+        }
+        lock.lock();
+        try {
+            final Set<ServerPlayer> playerList = getWatchPlayerList(entity);
+            if (playerList == null || playerList.isEmpty()) {
+                return false;
+            }
+            for (final ServerPlayer player : playerList) {
+                updateEntity(player, entity);
+            }
+            return true;
+        } finally {
+            lock.unlock();
+        }
+    }
+
+    public static boolean syncBlockEntityToClient(@NotNull BlockEntity blockEntity) {
+        final Level world = blockEntity.getLevel();
+        if (world == null || world.isClientSide()) {
+            return false;
+        }
+        final BlockPos pos = blockEntity.getBlockPos();
+        final BlockState blockState = world.getBlockState(pos);
+
+        lock.lock();
+        try {
+            // Oneiric - 不改动共享集合：原来的 playerList.addAll(playerListAdj) 会往
+            // 表里的 Set 塞别的坐标的观察者，导致后续 remove 找不到人 → 内存泄漏。
+            // 这里只做"两个集合的并集遍历"。
+            final Set<ServerPlayer> direct = getWatchPlayerList(world, pos);
+            Set<ServerPlayer> adjacent = null;
+            if (blockState.getBlock() instanceof ChestBlock
+                    && blockState.getValue(ChestBlock.TYPE) != ChestType.SINGLE) {
+                final BlockPos posAdj = pos.relative(ChestBlock.getConnectedDirection(blockState));
+                adjacent = getWatchPlayerList(world, posAdj);
+            }
+
+            boolean sent = false;
+            if (direct != null) {
+                for (final ServerPlayer player : direct) {
+                    updateBlockEntity(player, blockEntity);
+                    sent = true;
+                }
+            }
+            if (adjacent != null) {
+                for (final ServerPlayer player : adjacent) {
+                    if (direct != null && direct.contains(player)) {
+                        continue; // 已经发过
+                    }
+                    updateBlockEntity(player, blockEntity);
+                    sent = true;
+                }
+            }
+            return sent;
+        } finally {
+            lock.unlock();
+        }
+    }
+
+    private static void clearPlayerWatchEntity(ServerPlayer player) {
+        lock.lock();
+        try {
+            final Pair<ResourceLocation, Entity> pair = playerWatchEntity.remove(player);
+            if (pair != null) {
+                final Set<ServerPlayer> playerSet = entityWatchPlayerSet.get(pair);
+                if (playerSet != null) {
+                    playerSet.remove(player);
+                    if (playerSet.isEmpty()) {
+                        entityWatchPlayerSet.remove(pair);
+                    }
+                }
+            }
+        } finally {
+            lock.unlock();
+        }
+    }
+
+    private static void clearPlayerWatchBlock(ServerPlayer player) {
+        lock.lock();
+        try {
+            final Pair<ResourceLocation, BlockPos> pair = playerWatchBlockPos.remove(player);
+            if (pair != null) {
+                final Set<ServerPlayer> playerSet = blockPosWatchPlayerSet.get(pair);
+                if (playerSet != null) {
+                    playerSet.remove(player);
+                    if (playerSet.isEmpty()) {
+                        blockPosWatchPlayerSet.remove(pair);
+                    }
+                }
+            }
+        } finally {
+            lock.unlock();
+        }
+    }
+
+    /** Oneiric - 玩家离开时必须清表，否则四张观察表会永久持有已下线的 ServerPlayer。 */
+    @ProtocolHandler.PlayerLeave
+    private static void onLeave(ServerPlayer player) {
+        clearPlayerWatchData(player);
+    }
+
+    public static void disablePcaSyncProtocolGlobal() {
+        lock.lock();
+        try {
+            playerWatchBlockPos.clear();
+            playerWatchEntity.clear();
+            blockPosWatchPlayerSet.clear();
+            entityWatchPlayerSet.clear();
+        } finally {
+            lock.unlock();
+        }
+        final MinecraftServer server = MinecraftServer.getServer();
+        if (server == null) {
+            return;
+        }
+        for (final ServerPlayer player : server.getPlayerList().getPlayers()) {
+            disablePcaSyncProtocol(player);
+        }
+    }
+
+    public static void enablePcaSyncProtocolGlobal() {
+        final MinecraftServer server = MinecraftServer.getServer();
+        if (server == null) {
+            return;
+        }
+        for (final ServerPlayer player : server.getPlayerList().getPlayers()) {
+            enablePcaSyncProtocol(player);
+        }
+    }
+
+    public static void clearPlayerWatchData(ServerPlayer player) {
+        clearPlayerWatchBlock(player);
+        clearPlayerWatchEntity(player);
+    }
+
+    @Override
+    public boolean isActive() {
+        return LeavesConfig.protocol.pca.enable;
+    }
+
+    public record UpdateEntityPayload(ResourceLocation dimension, int entityId,
+                                      CompoundTag tag) implements LeavesCustomPayload {
+
+        @ID
+        public static final ResourceLocation UPDATE_ENTITY = PcaSyncProtocol.id("update_entity");
+
+        @Codec
+        public static final StreamCodec<FriendlyByteBuf, UpdateEntityPayload> CODEC = StreamCodec.composite(
+                ResourceLocation.STREAM_CODEC, UpdateEntityPayload::dimension,
+                ByteBufCodecs.INT, UpdateEntityPayload::entityId,
+                ByteBufCodecs.COMPOUND_TAG, UpdateEntityPayload::tag,
+                UpdateEntityPayload::new
+        );
+    }
+
+    public record UpdateBlockEntityPayload(ResourceLocation dimension, BlockPos blockPos,
+                                           CompoundTag tag) implements LeavesCustomPayload {
+
+        @ID
+        private static final ResourceLocation UPDATE_BLOCK_ENTITY = PcaSyncProtocol.id("update_block_entity");
+
+        @Codec
+        private static final StreamCodec<FriendlyByteBuf, UpdateBlockEntityPayload> CODEC = StreamCodec.composite(
+                ResourceLocation.STREAM_CODEC, UpdateBlockEntityPayload::dimension,
+                BlockPos.STREAM_CODEC, UpdateBlockEntityPayload::blockPos,
+                ByteBufCodecs.COMPOUND_TAG, UpdateBlockEntityPayload::tag,
