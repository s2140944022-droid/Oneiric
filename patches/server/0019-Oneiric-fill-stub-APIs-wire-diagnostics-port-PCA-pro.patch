+        return regionX << SHIFT;
+    }
 
-    /** 该基础区覆盖的最小 chunk 坐标。 */
+    /** 该基础区覆盖的最小 chunk Z 坐标（含）。 */
+    public static int minChunkZ(final int regionZ) {
+        return regionZ << SHIFT;
+    }
 
-    /** 两个 chunk 是否属于同一个基础区。 */
+    /**
+     * 两个 chunk 是否属于同一个基础区。
+     *
+     * <p>这是最常用的判定：比起算两次 key 再比较 long，直接比较两个移位结果更快，
+     * 也避免了 long 装箱。</p>
+     */
+    public static boolean sameBaseRegion(final int chunkX1, final int chunkZ1,
+                                         final int chunkX2, final int chunkZ2) {
