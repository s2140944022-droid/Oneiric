@@ -48,9 +48,21 @@ public final class OneiricBaseRegion {
     private OneiricBaseRegion() {
     }
 
-    /** 基础区 X 坐标：**纯函数**，只依赖入参。 */
+    /**
+     * 基础区 X 坐标：**纯函数**，只依赖入参。
+     *
+     * <p>{@code chunkX >> SHIFT} 等价于向下取整的 {@code chunkX / 8}，
+     * 对负坐标同样正确（算术右移向下取整，而 Java 的 {@code /} 是向零取整，
+     * 所以这里必须用移位而不是除法）。</p>
+     */
+    public static int regionX(final int chunkX) {
+        return chunkX >> SHIFT;
