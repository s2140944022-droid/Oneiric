+    /** 全局 tick；取不到时返回 -1（表示「无法判断掉队」，而不是「没有掉队」）。 */
+    private static long currentGlobalTick() {
+        try {
+            return RegionizedServer.getCurrentTick();
+        } catch (final Throwable ignored) {
+            return -1L;
+        }
+    }
+
     /**
-     * 统计单个世界 regionizer 的 区数 / TICKING 数。
+     * 统计单个世界 regionizer 的 区数 / TICKING 数 / 掉队数，并收集每区 MSPT。
      *
      * <p>{@code state} 是 {@code ThreadedRegion} 的公开字段，取值与内核常量一一对应：
      * {@code 0=TRANSIENT / 1=READY / 2=TICKING / 3=DEAD}。这里用数值比较而不用常量名，
@@ -106,16 +126,34 @@ public final class OneiricStatus {
      * 用一个未加锁的遍历去读正在被合并/分裂的 {@code regionsById} 会直接崩服。
      * 读锁的代价在这里完全可以接受 —— 状态命令是低频操作。</p>
      *
-     * <p>掉队数暂不采集：调度起点（{@code tickSchedule}）未通过任何公开 API 暴露，
-     * 与其编造一个读数，不如不报。</p>
+     * @param globalTick 全局 tick，{@code < 0} 表示取不到，此时不判断掉队
      */
-    private static int[] countRegions(final ThreadedRegionizer< ? , ? > regioniser) {
+    private static int[] countRegions(final ThreadedRegionizer< ? , ? > regioniser,
+                                      final long globalTick) {
         final int[] out = new int[3];
         try {
             regioniser.computeForAllRegions(region -> {
                 out[0]++;
                 if (region.state == 2) { // STATE_TICKING
                     out[1]++;
+                    // Oneiric - 掉队判定：该区域自己的 tick 落后全局 tick >= 2。
+                    // 用 >= 2 而不是 >= 1：区域在「正在被 tick」的那一瞬间本来就可能是
+                    // globalTick-1，取 1 会把正常区域全算成掉队。
+                    if (globalTick >= 0) {
+                        try {
+                            // ThreadedRegion#getData() 返回 TickRegionData（泛型擦除后由调用方约定），
+                            // 它的 getCurrentTick() 是该区域自己推进到的 tick。
+                            final Object data = region.getData();
+                            if (data instanceof TickRegions.TickRegionData tickData) {
+                                final long regionTick = tickData.getCurrentTick();
+                                if (globalTick - regionTick >= 2L) {
+                                    out[2]++;
+                                }
+                            }
+                        } catch (final Throwable ignored) {
+                            // 单个区域取不到，不影响其它区域
+                        }
+                    }
                 }
             });
         } catch (final Throwable ignored) {
@@ -153,6 +191,10 @@ public final class OneiricStatus {
               .append(" lagging=").append(laggingRegions)
               .append(" tickThreads=").append(threads.tickThreads())
