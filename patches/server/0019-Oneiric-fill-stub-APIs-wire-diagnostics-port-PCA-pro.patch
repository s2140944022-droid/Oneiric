@@ -53,6 +53,18 @@ public final class OneiricCommand extends Command {
         if (!testPermission(sender)) {
             return true;
         }
+        // Oneiric - 带参数的用法：
+        //   /oneiric           —— 多行状态（默认）
+        //   /oneiric line      —— 单行状态（便于粘到聊天/日志里）
