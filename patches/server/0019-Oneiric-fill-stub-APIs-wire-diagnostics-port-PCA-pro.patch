-    /** 基础区 Z 坐标：**纯函数**，只依赖入参。 */
+    /** 基础区 Z 坐标：**纯函数**，只依赖入参。理由同 {@link #regionX}。 */
+    public static int regionZ(final int chunkZ) {
+        return chunkZ >> SHIFT;
+    }
 
     /** 把 (regionX, regionZ) 打包成一个 long，供 map key 与集合使用。 */
     public static long key(final int regionX, final int regionZ) {
@@ -63,14 +75,36 @@ public final class OneiricBaseRegion {
     }
 
     /** 解包：基础区 key → regionX。 */
+    public static int unpackX(final long key) {
+        return (int) (key >> 32);
+    }
 
     /** 解包：基础区 key → regionZ。 */
+    public static int unpackZ(final long key) {
+        return (int) key;
+    }
 
-    /** 该基础区覆盖的最小 chunk 坐标。 */
+    /** 该基础区覆盖的最小 chunk X 坐标（含）。 */
