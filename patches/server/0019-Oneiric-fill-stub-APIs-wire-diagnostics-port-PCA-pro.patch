index 0000000000000000000000000000000000000000..8fb789b082b28097291b850e761594e9b126d328
--- /dev/null
+++ b/src/main/java/io/papermc/paper/oneiric/command/OneiricCommandTree.java
@@ -0,0 +1,199 @@
+package io.papermc.paper.oneiric.command;
+
+import com.mojang.brigadier.builder.ArgumentBuilder;
+import io.papermc.paper.command.brigadier.CommandSourceStack;
+import io.papermc.paper.command.brigadier.Commands;
+import io.papermc.paper.oneiric.OneiricBaseRegion;
+import io.papermc.paper.oneiric.OneiricConfig;
+import io.papermc.paper.oneiric.OneiricEntityDensity;
+import io.papermc.paper.oneiric.OneiricLongRangeCoupling;
+import io.papermc.paper.oneiric.OneiricParallelismReport;
+import io.papermc.paper.oneiric.OneiricPartitionHook;
+import io.papermc.paper.oneiric.OneiricRegionPartition;
+import io.papermc.paper.oneiric.OneiricStatus;
+import io.papermc.paper.oneiric.OneiricYml;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.TextColor;
+import org.leavesmc.leaves.command.CommandContext;
+import org.leavesmc.leaves.command.LiteralNode;
+import org.leavesmc.leaves.command.RootNode;
+
+/**
+ * Oneiric - {@code /oneiric} 命令树（用 Leaves 的命令框架）。
+ *
+ * <h2>为什么从手写 switch 换成节点树</h2>
+ *
+ * <p>原来 {@code OneiricCommand} 是一个 {@code org.bukkit.command.Command} 子类，
+ * 用 {@code args[0]} 手写分支。问题有三个：</p>
+ * <ol>
+ *   <li><b>补全靠手写</b>，加一个子命令要同时改 {@code execute} 和 {@code tabComplete}，
+ *       两处不同步就会出现"能执行但补全不出来"；</li>
+ *   <li><b>参数校验靠手写</b>，没有类型、没有范围，写错就走到 {@code NumberFormatException}；</li>
+ *   <li><b>注册走 {@code CommandMap}</b>，在 Paper 的 Brigadier 命令表上是不完整的
+ *       （命令能用，但客户端命令树里看不到参数提示）。</li>
+ * </ol>
+ *
+ * <p>换成 {@link RootNode} 后，子命令就是子节点，补全与校验由 Brigadier 自动给出，
+ * 注册走 {@code PaperCommands} 的 dispatcher，客户端能正确看到命令签名。</p>
+ *
+ * <h2>子命令</h2>
+ *
+ * <pre>
+ *   /oneiric              多行状态（默认）
+ *   /oneiric line         单行状态，便于粘到聊天/日志
+ *   /oneiric switches     全部开关的生效值
+ *   /oneiric density      实体密度热力图（需 entity-density 开关）
+ *   /oneiric brain        大脑细粒度计时（需 brain-profiling 开关）
+ * </pre>
+ */
+public final class OneiricCommandTree extends RootNode {
+
+    public static final String NAME = "oneiric";
+    private static final String PERM_BASE = "oneiric.commands";
+
+    public OneiricCommandTree() {
+        super(NAME, PERM_BASE);
+        this.children(
+                StatusNode::new,
+                LineNode::new,
+                SwitchesNode::new,
+                DensityNode::new,
+                BrainNode::new
+        );
+    }
+
+    @Override
+    protected ArgumentBuilder<CommandSourceStack, ?> compileBase() {
+        return Commands.literal(NAME);
+    }
+
+    /**
+     * Oneiric - 无参数 {@code /oneiric} 直接出多行状态。
+     *
+     * <p>覆写 {@code execute} 会让 {@link org.leavesmc.leaves.command.CommandNode#canExecute()}
+     * 返回 true，从而给根节点挂上 executes()。不覆写的话 {@code /oneiric} 单独敲
+     * 只会报 "usage"，那是很差的体验 —— 状态命令的主用法就是不带参数。</p>
+     */
+    @Override
+    protected boolean execute(final CommandContext context) {
+        return StatusNode.print(context.getSender());
+    }
+
+    // ── 各子命令 ────────────────────────────────────────────────────────
+
+    /** 默认（无参数）：多行状态。 */
+    static final class StatusNode extends LiteralNode {
+        StatusNode() {
+            super("status");
+        }
+
+        @Override
+        protected ArgumentBuilder<CommandSourceStack, ?> compileBase() {
+            return Commands.literal("status");
+        }
+
+        @Override
+        protected boolean execute(CommandContext context) {
+            return print(context.getSender());
+        }
+
+        /** 多行状态的唯一输出点（根节点与 status 子命令共用）。 */
+        static boolean print(final org.bukkit.command.CommandSender sender) {
+            sender.sendMessage(Component.text("[Oneiric] " + OneiricBaseRegion.status())
+                    .color(TextColor.color(0x55AAFF)));
+            sender.sendMessage(Component.text("  " + OneiricStatus.snapshot().describe()));
+            sender.sendMessage(Component.text("  " + OneiricRegionPartition.status()
+                    + " | " + OneiricPartitionHook.status()
+                    + " | " + OneiricLongRangeCoupling.status()
+                    + " | " + OneiricYml.status()));
+            sender.sendMessage(Component.text("  switches: " + OneiricConfig.status()));
