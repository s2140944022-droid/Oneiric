+        return aligned;
+    }
     /**
      * 分区层是否生效。**这是总闸**：{@code region-tick} 关掉时，
      * {@link #forceMerge} 与 {@link #vetoSplit} 全部直接返回 false，等于回到 Folia 原行为。
@@ -92,8 +94,26 @@ public final class OneiricPartitionHook {
      *
      * @param hostSections  宿主 region 已有的 section key
      * @param otherSections 待并入 region 的 section key
+     * @return true 表示**必须**把 {@code otherSections} 并入宿主
      */
-
+    public static boolean forceMerge(final Collection<Long> hostSections,
+                                     final Collection<Long> otherSections) {
+        if (!active() || otherSections.isEmpty()) {
+            return false;
+        }
+        // 宿主已有的簇集合（去重后通常只有 1~2 个）
+        final java.util.Set<Long> hostClusters = new java.util.HashSet<>(hostSections.size() * 2);
+        for (final Long section : hostSections) {
+            hostClusters.add(OneiricRegionPartition.find(section));
+        }
+        // 对方的任一个 section 属于宿主的簇 -> 必须并
+        for (final Long section : otherSections) {
+            if (hostClusters.contains(OneiricRegionPartition.find(section))) {
+                return true;
+            }
+        }
+        return false;
+    }
     /**
      * 在 {@code onRegionRelease} 算出分裂候选之后调用：判断按候选拆开是否会拆散某一簇。
      *
@@ -123,6 +143,17 @@ public final class OneiricPartitionHook {
     }
 
     /** 便于调用方构造：把 section 集合按簇分组，用于诊断输出。 */
+    public static List<List<Long>> groupByCluster(final Collection<Long> sections) {
+        final Map<Long, List<Long>> byCluster = new java.util.LinkedHashMap<>();
+        for (final Long section : sections) {
+            byCluster.computeIfAbsent(OneiricRegionPartition.find(section),
+                    k -> new ArrayList<>()).add(section);
+        }
+        return new ArrayList<>(byCluster.values());
+    }
 
     /** 便于内核调用方把「section key」当作「基础区 key」查簇。 */
+    public static long clusterOf(final long sectionKey) {
+        return OneiricRegionPartition.find(sectionKey);
+    }
 }
